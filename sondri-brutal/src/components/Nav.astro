---
import { announcement, nav } from '../brutal-data';
import { BOOK_HREF, CTA_PRIMARY } from '../data';
---

<div class="ann on-paper">
  <div class="wrap ann-in">
    <span class="label"><span class="sq" aria-hidden="true"></span>{announcement.text}</span>
    <a class="label label-gold ann-cta" href={BOOK_HREF}>{announcement.cta} →</a>
  </div>
</div>

<header class="on-dark" id="siteheader">
  <div class="wrap nav-in">
    <a class="brand" href="/" aria-label="Sondri — home">
      <img src="/brand/florexa-white.svg" alt="Sondri" width="977" height="443" />
    </a>

    <nav class="links" aria-label="Primary">
      {nav.map((i) => <a class="link" href={i.href}>{i.label}</a>)}
    </nav>

    <div class="right">
      <a class="link log" href="#contact">Get in touch</a>
      <a class="btn btn-gold" href={BOOK_HREF}>{CTA_PRIMARY}</a>
    </div>

    <button id="navtoggle" class="toggle label" aria-expanded="false" aria-controls="navpanel">Menu</button>
  </div>

  <div id="navpanel" hidden>
    {nav.map((i) => <a class="panel-link" href={i.href}>{i.label}</a>)}
    <a class="panel-link" href="#contact">Get in touch</a>
    <a class="btn btn-gold panel-btn" href={BOOK_HREF}>{CTA_PRIMARY}</a>
  </div>
</header>

<style>
  /* The accent inverted: a gold strip above the teal bar. */
  .ann { background: var(--gold); }
  .ann-in {
    display: flex; align-items: center; justify-content: center;
    flex-wrap: wrap; gap: var(--s-08) var(--s-16);
    min-height: 40px; padding-block: 10px; text-align: center;
  }
  .ann .label { color: rgba(8, 31, 31, 0.72); }
  .ann-in .sq { width: 6px; height: 6px; background: var(--ink); display: inline-block; margin-right: 8px; vertical-align: 1px; }
  .ann .label-gold { color: var(--ink); }
  .ann-cta { text-decoration: none; border-bottom: 1px solid transparent; }
  .ann-cta:hover { border-bottom-color: var(--ink); }

  /* Blacksmith keeps this bar one solid field the whole way down the page; ours
     frosts it once the page moves so the section under it reads through. */
  header {
    position: sticky; top: 0; z-index: 50;
    background: var(--ink);
    border-bottom: 1px solid transparent;
    transition: background 0.25s linear, border-color 0.25s linear;
  }
  header.stuck {
    background: rgba(8, 31, 31, 0.78);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
  }
  /* No blur support: fall back to the solid bar rather than unreadable text. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    header.stuck { background: var(--ink); }
  }
  .nav-in { display: flex; align-items: center; gap: var(--s-32); height: var(--nav-h); }
  .brand img { height: 26px; width: auto; }

  .links { display: flex; gap: var(--s-32); margin-right: auto; }
  .link {
    font-family: var(--mono); font-size: 14px; letter-spacing: 0.04em;
    text-transform: uppercase; text-decoration: none; color: var(--pale);
    padding-block: 4px; border-bottom: 1px solid transparent;
  }
  .link:hover { color: var(--text-hi); border-bottom-color: var(--accent); }

  .right { display: flex; align-items: center; gap: var(--s-24); }
  .log { margin-left: auto; }

  .toggle {
    display: none; background: none; border: 1px solid var(--line);
    border-radius: var(--pill); padding: 10px 18px; color: var(--text-hi); margin-left: auto;
  }

  #navpanel { border-top: 1px solid var(--line); background: var(--ink); padding: var(--s-16) var(--pad-x) var(--s-24); }
  .panel-link {
    display: block; padding: 14px 0; border-bottom: 1px solid var(--line-soft);
    font-family: var(--mono); font-size: 14px; text-transform: uppercase;
    text-decoration: none; color: var(--pale);
  }
  .panel-btn { margin-top: var(--s-24); width: 100%; justify-content: center; }

  @media (max-width: 980px) {
    .links, .right { display: none; }
    .toggle { display: block; }
  }
</style>

<script>
  // Frost the bar as soon as the page leaves the top.
  const header = document.getElementById('siteheader');
  const onScroll = () => header?.classList.toggle('stuck', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const t = document.getElementById('navtoggle');
  const p = document.getElementById('navpanel');
  t?.addEventListener('click', () => {
    const open = t.getAttribute('aria-expanded') === 'true';
    t.setAttribute('aria-expanded', String(!open));
    t.textContent = open ? 'Menu' : 'Close';
    if (p) (p as HTMLElement).hidden = open;
  });
</script>
