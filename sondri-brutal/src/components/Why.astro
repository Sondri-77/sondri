---
import { why } from '../home-data';
---

<!-- Why Sondri exists: the founder note as one panel on the teal field,
     the hard gold offset behind it. -->
<section class="section section-pad on-dark" id="about">
  <div class="wrap">
    <div class="eyebrow"><span class="label">/ Why Sondri exists</span></div>
    <div class="panel dots note" data-reveal>
      <p class="h4 quote">{why.quote}</p>
      <p class="lede line">{why.line}</p>
      <a class="btn" href={why.href}>{why.cta}</a>
    </div>
  </div>
</section>

<style>
  .note {
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-32);
    padding: var(--s-48); max-width: 880px;
  }
  .quote { font-size: clamp(22px, 2.4vw, 32px); font-weight: 500; }
  .line { max-width: 52ch; }
  @media (max-width: 640px) { .note { padding: var(--s-24); } }
</style>
