---
import { capabilities } from '../home-data';
// Two copies so the loop is seamless; the second is hidden from a11y.
const track = [...capabilities, ...capabilities];
---

<section class="section strip">
  <div class="rail">
    <div class="track">
      {track.map((c, i) => (
        <span class="item" aria-hidden={i >= capabilities.length ? 'true' : undefined}>
          {c}<span class="dot" aria-hidden="true">/</span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  /* Sondri gold, edge to edge: the strip reads as a band between the hero
     and the problem, so it stays thin and carries no heading. */
  .strip { padding-block: var(--s-16); overflow: hidden; background: var(--gold); }
  .rail { display: flex; width: 100%; }
  .track { display: flex; flex: 0 0 auto; gap: var(--s-40); padding-right: var(--s-40); animation: slide 42s linear infinite; }
  .item {
    color: var(--teal); white-space: nowrap; display: inline-flex; gap: var(--s-40);
    font-family: var(--mono); font-size: 14px; letter-spacing: 0.04em; text-transform: uppercase;
  }
  .dot { color: rgba(8, 31, 31, 0.4); }
  /* Ambient spotlight (scripts/motion.ts): each capability takes a turn. */
  .item { transition: color 0.5s linear, opacity 0.5s linear; opacity: 0.72; }
  .item.lit { opacity: 1; color: var(--teal-deep); }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }
</style>
