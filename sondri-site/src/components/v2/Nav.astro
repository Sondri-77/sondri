---
import { navV2, BOOK_HREF } from '../../data';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<nav aria-label="Primary">
  <div class="nav-in wrap">
    <a class="logo" href="/" aria-label="Sondri — home">
      <img src="/brand/wordmark-bone.png" alt="Sondri" width="135" height="32" />
    </a>

    <div class="links" id="nav-links">
      {navV2.map((item) => (
        <a
          class:list={['nav-link', { active: isActive(item.href) }]}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>

    <a class="btn btn-gold book" href={BOOK_HREF}>Book discovery</a>

    <button id="nav-toggle" aria-expanded="false" aria-controls="nav-panel" aria-label="Open menu">
      <span class="bar" aria-hidden="true"></span>
      <span class="bar" aria-hidden="true"></span>
    </button>
  </div>

  <div id="nav-panel">
    {navV2.map((item) => (
      <a class:list={['panel-link', { active: isActive(item.href) }]} href={item.href}>{item.label}</a>
    ))}
    <a class="btn btn-gold panel-book" href={BOOK_HREF}>Book discovery <span class="arr">→</span></a>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle')!;
  const panel = document.getElementById('nav-panel')!;
  const nav = toggle.closest('nav')!;

  const setOpen = (open: boolean) => {
    nav.classList.toggle('open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (!open) toggle.focus();
  };

  toggle.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav.classList.contains('open')) setOpen(false);
  });
  document.addEventListener('click', (e) => {
    if (nav.classList.contains('open') && !nav.contains(e.target as Node)) setOpen(false);
  });
  panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  /* Hairline shadow once the page scrolls under the nav. */
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(13, 26, 26, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: box-shadow 0.25s var(--ease);
  }
  nav.scrolled { box-shadow: 0 1px 0 var(--line-ink), 0 8px 24px rgba(8, 18, 38, 0.25); }

  .nav-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 16px;
    max-width: 1280px;
  }

  .logo { display: flex; align-items: center; }
  .logo img { display: block; }

  .links { display: flex; gap: 32px; }
  .nav-link {
    color: var(--pale);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    padding: 10px 0;
    transition: color var(--dur-micro) var(--ease);
  }
  .nav-link:hover { color: #fff; }
  .nav-link.active { color: #fff; box-shadow: 0 2px 0 var(--gold-2); }

  .book { padding: 11px 22px; font-size: 14px; }

  #nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: none;
    border: 0;
    cursor: pointer;
  }
  #nav-toggle .bar {
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.25s var(--ease);
  }
  nav.open #nav-toggle .bar:first-child { transform: translateY(4.5px) rotate(45deg); }
  nav.open #nav-toggle .bar:last-child { transform: translateY(-4.5px) rotate(-45deg); }

  #nav-panel {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px var(--pad-x) 28px;
    background: var(--deep);
    border-top: 1px solid var(--line-ink);
  }
  .panel-link {
    color: var(--pale);
    font-size: 18px;
    font-weight: 500;
    text-decoration: none;
    padding: 13px 0;
    border-bottom: 1px solid var(--line-ink);
  }
  .panel-link.active { color: #fff; }
  .panel-book { align-self: flex-start; margin-top: 20px; }

  @media (max-width: 900px) {
    .links, .book { display: none; }
    #nav-toggle { display: flex; }
    nav.open #nav-panel { display: flex; }
  }
</style>
