---
/**
 * Design-time control for trialling the display face across the real site.
 * Sets --font-display on :root and swaps the nav lockup to match, so the
 * wordmark and the headings always agree. Choice persists per browser.
 *
 * Remove this component once the face is settled.
 */
import { displayFonts, shortlist } from '../../display-fonts';

const rest = displayFonts.filter((f) => !f.shortlist);

// The styleguide has its own, richer switcher — don't stack two.
const hidden = Astro.url.pathname.startsWith('/styleguide');
---

{!hidden && (

<div class="fs" id="font-switcher" data-open="false">
  <button class="fs-tab" id="fs-tab" type="button" aria-expanded="false" aria-controls="fs-panel">
    <span class="fs-tab-label">Aa</span>
    <span class="fs-tab-name" id="fs-current">Florexa</span>
  </button>

  <div class="fs-panel" id="fs-panel" hidden>
    <p class="mono-label fs-title">Display face</p>
    <select id="fs-select" aria-label="Display font for the wordmark and headings">
      <optgroup label="Shortlist">
        {shortlist.map((f) => <option value={f.family}>{f.name}</option>)}
      </optgroup>
      <optgroup label="Everything else">
        {rest.map((f) => <option value={f.family}>{f.name}</option>)}
      </optgroup>
      <optgroup label="Reference">
        <option value="__serif">Fraunces (v2 original)</option>
      </optgroup>
    </select>
    <a class="fs-link" href="/styleguide">Open styleguide →</a>
  </div>
</div>
)}

<style>
  .fs {
    position: fixed;
    right: 0;
    bottom: 90px;
    z-index: 70;
    display: flex;
    align-items: flex-end;
    font-family: var(--mono);
  }
  .fs-tab {
    display: flex;
    align-items: center;
    gap: 9px;
    background: var(--nav-glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--line-ink);
    border-right: 0;
    color: var(--pale);
    font: inherit;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 10px 14px;
    cursor: pointer;
    transition: color var(--dur-micro) var(--ease), border-color var(--dur-micro) var(--ease);
  }
  .fs-tab:hover { color: var(--text-hi); border-color: var(--steel); }
  .fs-tab-label { color: var(--gold); font-weight: 700; }
  .fs-tab-name { max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .fs-panel {
    background: var(--nav-glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--line-ink);
    border-right: 0;
    padding: 14px 16px 16px;
    width: 250px;
  }
  .fs-panel[hidden] { display: none; }
  .fs-title { margin-bottom: 8px; }
  .fs select {
    appearance: none;
    width: 100%;
    background: var(--deep) url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8'%3E%3Cpath fill='%23aac2c2' d='M1 1l5 5 5-5'/%3E%3C/svg%3E")
      no-repeat right 11px center / 10px;
    color: var(--text-hi);
    border: 1px solid var(--line-ink);
    font-family: var(--sans);
    font-size: 13px;
    padding: 8px 30px 8px 10px;
    cursor: pointer;
  }
  .fs-link {
    display: inline-block;
    margin-top: 11px;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--steel);
    text-decoration: none;
  }
  .fs-link:hover { color: var(--gold); }

  @media (max-width: 640px) {
    .fs { bottom: auto; top: 72px; }
    .fs-tab-name { display: none; }
  }
</style>

<script>
  import { DISPLAY_FONT_KEY, applyDisplayFont } from '../../scripts/display-font';

  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('font-switcher');
    const tab = document.getElementById('fs-tab');
    const panel = document.getElementById('fs-panel');
    const select = document.getElementById('fs-select') as HTMLSelectElement | null;
    const current = document.getElementById('fs-current');
    if (!root || !tab || !panel || !select) return;

    let saved = '';
    try {
      saved = localStorage.getItem(DISPLAY_FONT_KEY) || '';
    } catch {
      /* storage unavailable — fall back to the CSS default */
    }
    if (saved) select.value = saved;

    const sync = () => {
      applyDisplayFont(select.value);
      if (current) {
        current.textContent = select.selectedOptions[0]?.textContent?.trim() || '';
      }
      try {
        localStorage.setItem(DISPLAY_FONT_KEY, select.value);
      } catch {
        /* private browsing — the trial just won't persist */
      }
    };

    const setOpen = (open: boolean) => {
      root.dataset.open = String(open);
      panel.hidden = !open;
      tab.setAttribute('aria-expanded', String(open));
    };

    tab.addEventListener('click', () => setOpen(panel.hidden));
    select.addEventListener('change', sync);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false);
    });

    sync();
  });
</script>
