---
import { CAL_LINK } from '../../data';
---

<script is:inline define:vars={{ calLink: CAL_LINK }}>
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['initNamespace', namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  Cal('init', 'discovery', { origin: 'https://cal.com' });

  Cal.ns.discovery('ui', {
    theme: 'dark',
    styles: {
      branding: {
        brandColor: '#d4af37',
      },
    },
    hideEventTypeDetails: false,
    layout: 'month_view',
  });

  function bindCalButtons() {
    if (!calLink) return;
    const links = document.querySelectorAll(`a[href*="cal.com/${calLink}"], a[data-cal-link]`);
    links.forEach((link) => {
      link.setAttribute('data-cal-link', calLink);
      link.setAttribute('data-cal-namespace', 'discovery');
      link.setAttribute(
        'data-cal-config',
        JSON.stringify({ layout: 'month_view', theme: 'dark' })
      );
    });
  }

  // Bind on initial page load and every client-side page navigation in Astro
  document.addEventListener('DOMContentLoaded', bindCalButtons);
  document.addEventListener('astro:page-load', bindCalButtons);
</script>
