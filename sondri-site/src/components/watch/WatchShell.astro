---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource-variable/jetbrains-mono';
import '../../styles/brutal.css';
import CalModal from '../CalModal.astro';
import WatchCheckoutModal from './WatchCheckoutModal.astro';
import { BOOK_HREF, CONTACT_EMAIL, mailto } from '../../data';
import type { Lang } from '../../i18n';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  activeTab: 'overview' | 'services' | 'pricing' | 'guides' | 'playbooks' | 'sample' | 'partners';
  alternates?: { en: string; es: string };
}

const { title, description, lang = 'en', activeTab, alternates } = Astro.props;
const isEs = lang === 'es';
const prefix = isEs ? '/es/watch' : '/watch';
const siteUrl = Astro.site ? Astro.site.origin : 'https://sondri.ai';
const canonical = new URL(Astro.url.pathname, siteUrl);

const navItems = [
  { id: 'overview', href: `${prefix}/`, label: isEs ? 'Resumen' : 'Overview' },
  { id: 'services', href: `${prefix}/services/`, label: isEs ? 'Servicios' : 'Services' },
  { id: 'pricing', href: `${prefix}/pricing/`, label: isEs ? 'Precios' : 'Pricing' },
  { id: 'guides', href: `${prefix}/guides/`, label: isEs ? 'Guías' : 'Guides' },
  { id: 'sample', href: `${prefix}/sample-report/`, label: isEs ? 'Reporte' : 'Sample Report' },
  { id: 'partners', href: `${prefix}/partners/`, label: isEs ? 'Agencias' : 'Agencies' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-KWBL7TXV"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(alternates.en, siteUrl).href} />
        <link rel="alternate" hreflang="es" href={new URL(alternates.es, siteUrl).href} />
      </>
    )}
    <meta name="theme-color" content="#081f1f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@1,9..144,600;1,9..144,700&display=swap"
    />
    <link rel="preload" href="/fonts/florexa.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og.png`} />
    <slot name="head" />
  </head>

  <body class="watch-body">
    <a class="skip" href="#main">{isEs ? 'Saltar al contenido' : 'Skip to content'}</a>

    <!-- Fixed Pixelated Bayer-Dithered WebGL Topographical Background -->
    <canvas id="watch-topo-canvas" aria-hidden="true"></canvas>

    <!-- Announcement Bar -->
    <div class="watch-ann">
      <div class="wrap watch-ann-in">
        <span class="label">
          <span class="sq" aria-hidden="true"></span>
          {isEs
            ? 'SONDRI WATCH · VISIBILIDAD EN CHATGPT, GEMINI, AI OVERVIEWS Y AI MODE'
            : 'SONDRI WATCH · DONE-FOR-YOU AI VISIBILITY ACROSS CHATGPT, GEMINI & GOOGLE AI'}
        </span>
        <a class="label watch-ann-cta" href={`${prefix}/#free-check`}>
          {isEs ? 'Probar Score IA Gratis →' : 'Run Free AI Check →'}
        </a>
      </div>
    </div>

    <!-- Watch Top Header -->
    <header class="watch-header on-dark" id="watchHeader">
      <div class="wrap watch-nav-in">
        <a class="watch-brand" href={`${prefix}/`} aria-label="Sondri Watch Home">
          <img src="/brand/florexa-white-gold.svg" alt="Sondri" width="952" height="367" />
          <span class="watch-slash" aria-hidden="true">/</span>
          <span class="watch-badge label">WATCH</span>
        </a>

        <nav class="watch-links" aria-label={isEs ? 'Navegación principal' : 'Watch navigation'}>
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={['label', 'watch-nav-link', activeTab === item.id && 'is-active']}
              aria-current={activeTab === item.id ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="watch-right">
          <a class="label parent-link" href={isEs ? '/es/' : '/'}>
            ← {isEs ? 'Sondri Software' : 'sondri.ai'}
          </a>
          <a class="btn btn-white watch-cta-sm" href={BOOK_HREF}>
            {isEs ? 'Agendar Llamada Gratis' : 'Book a Free Call'} <span class="arr">→</span>
          </a>

          {alternates && (
            <div class="lang-switch" role="group" aria-label="Language">
              <a
                href={alternates.en}
                hreflang="en"
                class:list={['label', 'lang-item', !isEs && 'is-current']}
              >
                EN
              </a>
              <span class="lang-sep" aria-hidden="true">|</span>
              <a
                href={alternates.es}
                hreflang="es"
                class:list={['label', 'lang-item', isEs && 'is-current']}
              >
                ES
              </a>
            </div>
          )}

          <button
            id="watchMenuBtn"
            class="watch-toggle label"
            type="button"
            aria-expanded="false"
            aria-controls="watchMobileMenu"
          >
            {isEs ? 'Menú' : 'Menu'}
          </button>
        </div>
      </div>

      <div id="watchMobileMenu" hidden>
        {navItems.map((item) => (
          <a href={item.href} class:list={['watch-m-link', activeTab === item.id && 'is-active']}>
            {item.label}
          </a>
        ))}
        <a href={BOOK_HREF} class="watch-m-link watch-m-book">
          {isEs ? 'Agendar llamada de 15 min →' : 'Book a 15-min Walkthrough →'}
        </a>
        <a href={mailto(isEs ? 'Consulta desde watch.sondri.ai' : 'Question from watch.sondri.ai')} class="watch-m-link">
          {CONTACT_EMAIL}
        </a>
        <a href={isEs ? '/es/' : '/'} class="watch-m-link">
          ← {isEs ? 'Volver a sondri.ai (Software a Medida)' : 'Back to sondri.ai (Custom AI & Software)'}
        </a>
        {alternates && (
          <div class="watch-m-lang">
            <a href={alternates.en} class="label">EN</a>
            <span>·</span>
            <a href={alternates.es} class="label">ES</a>
          </div>
        )}
      </div>
    </header>

    <main id="main" class="watch-main">
      <slot />
    </main>

    <!-- Shared Direct Contact Band (Calendar Modal + Email Copy) -->
    <section class="section on-dark watch-contact-band" aria-label={isEs ? 'Contacto directo' : 'Direct contact'}>
      <div class="wrap wcb-inner">
        <div class="wcb-copy">
          <span class="label wcb-kicker">
            {isEs ? 'CONTACTO DIRECTO · LLAMADA O CORREO' : 'DIRECT CONTACT · CALL OR EMAIL'}
          </span>
          <h3 class="h3 wcb-title">
            {isEs ? (
              <>¿Prefieres <em class="serif-em">conversar antes de ordenar?</em></>
            ) : (
              <>Prefer to <em class="serif-em">talk before ordering?</em></>
            )}
          </h3>
          <p class="body-s wcb-sub">
            {isEs
              ? 'Revisamos tu puntaje IA en vivo en una llamada de 15 minutos, o escríbenos con tu dominio para darte un alcance claro.'
              : 'Walk through your free AI score live on a 15-minute call, or email us your domain for a tailored scope.'}
          </p>
        </div>

        <div class="wcb-actions">
          <a class="btn btn-gold wcb-book-btn" href={BOOK_HREF}>
            <span>{isEs ? 'Agendar llamada de 15 min' : 'Book a 15-min Walkthrough'}</span> <span class="arr">→</span>
          </a>
          <div class="wcb-email-group">
            <a
              class="btn wcb-email-btn"
              href={mailto(isEs ? 'Consulta desde watch.sondri.ai' : 'Question from watch.sondri.ai')}
            >
              <span>{isEs ? `Escribir a ${CONTACT_EMAIL}` : `Email ${CONTACT_EMAIL}`}</span>
            </a>
            <button
              type="button"
              class="btn btn-copy-email label"
              data-copy-email={CONTACT_EMAIL}
              data-copied-label={isEs ? 'Copiado ✓' : 'Copied ✓'}
              aria-label={isEs ? 'Copiar correo electrónico' : 'Copy email address'}
            >
              {isEs ? 'Copiar' : 'Copy'}
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Watch Footer (5-Column AEO Link Architecture) -->
    <footer class="on-dark watch-footer">
      <div class="wrap">
        <div class="watch-f-grid-5">
          <div class="f-brand-col">
            <a class="watch-brand f-logo" href={`${prefix}/`} aria-label="Sondri Watch Home">
              <img src="/brand/florexa-white-gold.svg" alt="Sondri" width="952" height="367" />
              <span class="watch-slash" aria-hidden="true">/</span>
              <span class="watch-badge label">WATCH</span>
            </a>
            <p class="body-s footer-desc">
              {isEs
                ? 'Ayudamos a empresas de confianza a ser encontradas, verificadas y recomendadas por ChatGPT, Gemini y Google AI—con sitios rápidos listos para responder.'
                : 'We help trust-driven businesses get found, cited, and recommended when buyers ask AI—plus fast answer-ready websites.'}
            </p>
            <div class="f-actions">
              <a class="btn btn-gold f-book-btn" href={BOOK_HREF}>
                {isEs ? 'Agendar llamada' : 'Book a call'}
              </a>
              <a class="mail-link label" href={mailto('Hello from watch.sondri.ai')}>
                {CONTACT_EMAIL}
              </a>
            </div>
          </div>

          <div>
            <p class="label col-head">{isEs ? 'SERVICIOS' : 'SERVICES'}</p>
            <ul class="f-list">
              <li><a href={`${prefix}/services/`} class="label">{isEs ? 'Todos los servicios' : 'All services'}</a></li>
              <li><a href={`${prefix}/services/websites/`} class="label">{isEs ? 'Sitios Web (desde $390)' : 'Answer-Ready Websites ($390+)'}</a></li>
              <li><a href={`${prefix}/services/llms-txt-schema/`} class="label">llms.txt &amp; Schema</a></li>
              <li><a href={`${prefix}/services/citation-building/`} class="label">{isEs ? 'Reputación y citas IA' : 'Reputation & citations'}</a></li>
              <li><a href={`${prefix}/pricing/#websites`} class="label">Website Quick Fix ($390)</a></li>
              <li><a href={`${prefix}/pricing/#sprints`} class="label">Done-For-You Fix Sprint ($499)</a></li>
            </ul>
          </div>

          <div>
            <p class="label col-head">{isEs ? 'VISIBILIDAD IA' : 'AI VISIBILITY'}</p>
            <ul class="f-list">
              <li><a href={`${prefix}/services/aeo/`} class="label">AEO Services</a></li>
              <li><a href={`${prefix}/services/geo/`} class="label">GEO Services</a></li>
              <li><a href={`${prefix}/services/chatgpt-seo/`} class="label">ChatGPT SEO</a></li>
              <li><a href={`${prefix}/services/google-ai-overviews/`} class="label">Google AI Overviews</a></li>
              <li><a href={`${prefix}/services/perplexity-gemini/`} class="label">Perplexity &amp; Gemini</a></li>
              <li><a href={`${prefix}/pricing/#audit`} class="label">{isEs ? 'Auditoría Base ($99)' : 'AI Search Audit ($99)'}</a></li>
              <li><a href={`${prefix}/sample-report/`} class="label">{isEs ? 'Reporte Mensual' : 'Monthly Watch Reporting'}</a></li>
            </ul>
          </div>

          <div>
            <p class="label col-head">{isEs ? 'INDUSTRIAS' : 'INDUSTRIES'}</p>
            <ul class="f-list">
              <li><a href={`${prefix}/playbooks/#industry-packs`} class="label">{isEs ? 'Clínicas y Salud Dental' : 'Dental & Medical Clinics'}</a></li>
              <li><a href={`${prefix}/playbooks/#industry-packs`} class="label">{isEs ? 'Estudios Jurídicos' : 'Law Firms & Legal'}</a></li>
              <li><a href={`${prefix}/playbooks/#industry-packs`} class="label">B2B &amp; SaaS Companies</a></li>
              <li><a href={`${prefix}/playbooks/#industry-packs`} class="label">Shopify &amp; Ecommerce</a></li>
              <li><a href={`${prefix}/pricing/`} class="label">{isEs ? 'Todos los planes y packs' : 'All Plans & Packs'}</a></li>
              <li><a href={`${prefix}/partners/`} class="label">{isEs ? 'Agencias (Marca Blanca)' : 'Agencies (White-Label)'}</a></li>
            </ul>
          </div>

          <div>
            <p class="label col-head">{isEs ? 'GUÍAS Y SONDRI' : 'GUIDES & COMPANY'}</p>
            <ul class="f-list">
              <li><a href={`${prefix}/guides/`} class="label">{isEs ? 'Todas las guías' : 'All Plain-English Guides'}</a></li>
              <li><a href={`${prefix}/guides/what-is-ai-visibility/`} class="label">{isEs ? '¿Qué es visibilidad IA?' : 'What is AI visibility?'}</a></li>
              <li><a href={`${prefix}/guides/geo-vs-aeo-vs-seo/`} class="label">GEO vs AEO vs SEO</a></li>
              <li><a href={`${prefix}/guides/how-ai-chooses-businesses/`} class="label">{isEs ? 'Cómo elige la IA' : 'How AI chooses firms'}</a></li>
              <li><a href={`${prefix}/pricing/`} class="label">{isEs ? 'Precios y planes' : 'AI visibility pricing'}</a></li>
              <li><a href={isEs ? '/es/' : '/'} class="label">← {isEs ? 'Software y Automatización' : 'sondri.ai (Custom AI)'}</a></li>
              <li><a href="/pay/" class="label">{isEs ? 'Pagos y Facturación' : 'Client Payments'}</a></li>
              <li><a href={isEs ? '/es/privacy/' : '/privacy/'} class="label">{isEs ? 'Privacidad' : 'Privacy'}</a></li>
            </ul>
          </div>
        </div>

        <div class="watch-f-bottom">
          <span class="label">&copy; {new Date().getFullYear()} Sondri · watch.sondri.ai</span>
          <span class="label">{isEs ? 'Monitoreo EN/ES · 4 Motores de IA' : 'Bilingual EN/ES · ChatGPT, Gemini, AI Overviews & AI Mode'}</span>
        </div>
      </div>
    </footer>

    <!-- Compact Mobile Bottom Adviser Bar (<= 900px) -->
    <div id="watchMobileBar" class="watch-mobile-bar">
      <div class="mobile-bar-meta">
        <span class="label mobile-stage-kicker">{isEs ? 'SECCIÓN' : 'STAGE'}</span>
        <span id="watchMobileStage" class="mobile-stage-title">{isEs ? '01 Diagnóstico' : '01 Overview'}</span>
      </div>
      <div class="mobile-bar-actions">
        <span id="watchMobileScore" class="label mobile-score-pill" style="display: none;">--</span>
        <a href={BOOK_HREF} class="btn btn-white mobile-cta">
          {isEs ? 'Llamada Gratis' : 'Free Call'}
        </a>
        <a href={`${prefix}/#pricing-ladder`} class="btn mobile-cta-sec">
          {isEs ? 'Planes' : 'Plans'}
        </a>
      </div>
    </div>

    <CalModal />
    <WatchCheckoutModal lang={lang} />

    <script>
      import { initWatchTopoBackground } from '../../scripts/watch-topo-gl';
      import { initWatchScrollAndCheckout } from '../../scripts/watch-scroll';

      initWatchTopoBackground('watch-topo-canvas');
      initWatchScrollAndCheckout();

      const header = document.getElementById('watchHeader');
      const syncHeader = () => header?.classList.toggle('is-stuck', window.scrollY > 12);
      syncHeader();
      window.addEventListener('scroll', syncHeader, { passive: true });

      const menuBtn = document.getElementById('watchMenuBtn');
      const mobileMenu = document.getElementById('watchMobileMenu');
      menuBtn?.addEventListener('click', () => {
        const open = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!open));
        if (mobileMenu) mobileMenu.hidden = open;
      });

      document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const email = btn.getAttribute('data-copy-email') || '';
          const copiedLabel = btn.getAttribute('data-copied-label') || 'Copied ✓';
          const prevLabel = btn.textContent || '';
          try {
            if (email && navigator.clipboard?.writeText) {
              await navigator.clipboard.writeText(email);
            }
          } catch {
            /* Clipboard API may be blocked in insecure contexts; still show feedback or select */
          }
          btn.textContent = copiedLabel;
          btn.classList.add('is-copied');
          window.setTimeout(() => {
            btn.textContent = prevLabel;
            btn.classList.remove('is-copied');
          }, 2000);
        });
      });
    </script>
  </body>
</html>

<style>
  :global(.serif-em) {
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    color: var(--gold);
  }
  :global(.on-paper .serif-em),
  :global(.on-off .serif-em) {
    color: var(--teal-mid);
  }

  .watch-body {
    position: relative;
    background: var(--teal-deep);
  }

  #watch-topo-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .watch-ann {
    position: relative;
    z-index: 55;
    background: var(--gold);
    color: var(--teal);
  }

  .watch-ann-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 20px;
    min-height: 38px;
    padding-block: 8px;
  }

  .watch-ann .label {
    color: var(--teal);
    font-weight: 600;
  }

  .sq {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--teal);
    margin-right: 8px;
    vertical-align: 1px;
  }

  .watch-ann-cta {
    text-decoration: none;
    border-bottom: 1px solid var(--teal);
  }

  .watch-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(3, 25, 25, 0.72);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line-soft);
    transition: background-color 0.2s ease;
  }

  .watch-header.is-stuck {
    background: rgba(8, 31, 31, 0.96);
    border-bottom-color: var(--line);
  }

  .watch-nav-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 70px;
  }

  .watch-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .watch-brand img {
    height: 24px;
    width: auto;
  }

  .watch-slash {
    color: var(--steel);
    font-family: var(--mono);
    font-size: 16px;
  }

  .watch-badge {
    background: var(--gold);
    color: var(--teal);
    padding: 4px 8px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .watch-links {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-right: auto;
    margin-left: 16px;
  }

  .watch-nav-link {
    color: var(--pale);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }

  .watch-nav-link:hover,
  .watch-nav-link.is-active {
    color: var(--white);
    border-bottom-color: var(--gold);
  }

  .watch-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .parent-link {
    color: var(--steel);
    text-decoration: none;
    white-space: nowrap;
  }

  .parent-link:hover {
    color: var(--gold);
  }

  .btn-white {
    background: var(--white);
    border-color: var(--white);
    color: var(--teal);
    font-weight: 500;
  }

  .btn-white:hover {
    background: var(--off);
    border-color: var(--off);
    color: var(--teal);
  }

  .watch-cta-sm {
    padding: 10px 16px;
    font-size: 12px;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .lang-item {
    color: var(--pale);
    text-decoration: none;
    padding: 4px 6px;
  }

  .lang-item.is-current {
    background: var(--gold);
    color: var(--teal);
    font-weight: 700;
  }

  .lang-sep {
    color: var(--line);
    font-family: var(--mono);
    font-size: 12px;
  }

  .watch-toggle {
    display: none;
    background: none;
    border: 1px solid var(--line);
    color: var(--white);
    padding: 8px 14px;
    cursor: pointer;
  }

  #watchMobileMenu {
    border-top: 1px solid var(--line);
    background: var(--teal-deep);
    padding: 16px var(--pad-x) 24px;
  }

  .watch-m-link {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--mono);
    font-size: 13px;
    text-transform: uppercase;
    color: var(--pale);
    text-decoration: none;
  }

  .watch-m-link.is-active {
    color: var(--gold);
  }

  .watch-m-book {
    color: var(--gold);
    font-weight: 600;
  }

  .watch-contact-band {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line-soft);
    background: rgba(3, 25, 25, 0.96);
    padding-block: clamp(44px, 5vw, 68px);
  }

  .wcb-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-32);
    flex-wrap: wrap;
  }

  .wcb-copy {
    max-width: 58ch;
  }

  .wcb-kicker {
    display: inline-block;
    color: var(--gold);
    margin-bottom: 8px;
  }

  .wcb-title {
    color: var(--white);
    margin-bottom: 8px;
  }

  .wcb-sub {
    color: var(--pale);
    font-size: 15px;
    line-height: 1.55;
  }

  .wcb-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 16px;
  }

  .wcb-email-group {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--line);
  }

  .wcb-email-btn {
    background: transparent;
    color: var(--white);
    border: 0;
  }

