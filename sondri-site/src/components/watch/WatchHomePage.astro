<script>
  // 1. Hero 6-Industry 3-Question Preview Switcher + Direct Jump to Free Checker
  let activeService = '';
  const setActiveIndustry = (id: string) => {
    document.querySelectorAll<HTMLButtonElement>('[data-ind-btn]').forEach((b) => {
      const active = b.getAttribute('data-ind-btn') === id;
      b.classList.toggle('is-active', active);
      b.setAttribute('aria-selected', String(active));
      if (active) activeService = b.getAttribute('data-ind-service') || '';
    });
    document.querySelectorAll<HTMLElement>('[data-ind-pane]').forEach((pane) => {
      pane.style.display = pane.getAttribute('data-ind-pane') === id ? 'block' : 'none';
    });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-ind-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-ind-btn');
      if (id) setActiveIndustry(id);
    });
  });

  const jumpBtn = document.getElementById('heroRunOwnBtn');
  jumpBtn?.addEventListener('click', () => {
    const targetSec = document.getElementById('free-check');
    const urlInput = document.getElementById('auditUrl') as HTMLInputElement | null;
    const svcInput = document.getElementById('auditService') as HTMLInputElement | null;
    if (svcInput && !svcInput.value.trim() && activeService) {
      svcInput.value = activeService;
    }
    targetSec?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    setTimeout(() => urlInput?.focus({ preventScroll: true }), 420);
  });

  // 2. How It Works: 4-Phase Interactive Stepper + Blueprint Architecture Sync
  const bpStage = document.getElementById('blueprintStage');
  const bpKpi = document.getElementById('bpKpiLabel');
  const phaseShares = ['14%', '29%', '46%', '58%'];

  const syncBlueprint = (phaseIdx: number) => {
    if (bpStage) bpStage.setAttribute('data-active-phase', String(phaseIdx));
    if (bpKpi) {
      const share = phaseShares[phaseIdx] || '14%';
      bpKpi.textContent = `STAGE 0${phaseIdx + 1} / 04 · ${share} SHARE`;
    }
    document.querySelectorAll<SVGGElement>('[data-bp-layer]').forEach((layer) => {
      const idx = Number(layer.getAttribute('data-bp-layer') || '0');
      layer.classList.toggle('is-lit', idx <= phaseIdx);
      layer.classList.toggle('is-current', idx === phaseIdx);
    });
    document.querySelectorAll<SVGCircleElement>('[data-curve-idx]').forEach((node) => {
      const idx = Number(node.getAttribute('data-curve-idx') || '0');
      node.classList.toggle('is-lit', idx <= phaseIdx);
    });
  };
  syncBlueprint(0);

  document.querySelectorAll<HTMLButtonElement>('[data-phase-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-phase-btn') || '0');
      document.querySelectorAll<HTMLButtonElement>('[data-phase-btn]').forEach((b) => {
        const active = Number(b.getAttribute('data-phase-btn') || '0') === idx;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
      document.querySelectorAll<HTMLElement>('[data-phase-pane]').forEach((pane) => {
        pane.style.display = Number(pane.getAttribute('data-phase-pane') || '0') === idx ? 'block' : 'none';
      });
      syncBlueprint(idx);
    });
  });

  // 3. Services 4-Pillar Horizontal Accordion
  const activatePillar = (id: string) => {
    document.querySelectorAll<HTMLElement>('[data-pillar]').forEach((panel) => {
      const open = panel.getAttribute('data-pillar') === id;
      panel.classList.toggle('is-open', open);
      const trigger = panel.querySelector<HTMLButtonElement>('[data-pillar-btn]');
      trigger?.setAttribute('aria-expanded', String(open));
    });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-pillar-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-pillar-btn');
      if (id) activatePillar(id);
    });
  });

  // 4. Common Questions FAQ Accordion
  document.querySelectorAll<HTMLButtonElement>('[data-faq-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.getAttribute('data-faq-btn');
      const panel = document.getElementById(`faq-ans-${idx}`);
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      btn.closest('.faq-item')?.classList.toggle('is-open', !isOpen);
      if (panel) panel.hidden = isOpen;
    });
  });
</script>

