      ? 'Correcciones técnicas (robots.txt, llms.txt, JSON-LD y OpenAI/Bing Hubs) suelen reflejarse en 2 a 4 semanas. Citas en directorios y páginas nuevas consolidan mejoras medibles entre el mes 1 y el mes 3.'
      : 'Technical schema, crawler access, and OpenAI/Bing Business Hub updates often show movement within 2–4 weeks. Answer-ready pages and third-party citations compound steadily across months 1–3.',
  },
  {
    q: isEs ? '¿Garantizan que ChatGPT nos recomendará siempre en #1?' : 'Do you guarantee AI will recommend us?',
    a: isEs
      ? 'Ningún proveedor serio garantiza un prompt probabilístico en #1. Lo que sí garantizamos es medición limpia sin sesión, ingeniería real mensual y el Mes 4 sin costo si tu visibilidad no mejora tras 3 meses.'
      : 'No honest team guarantees deterministic #1 placement inside probabilistic models. What we guarantee is repeatable logged-out tracking, real engineering fixes shipped monthly, and Month 4 free if visibility doesn’t improve after 3 months.',
  },
  {
    q: isEs ? '¿Se puede pagar a ChatGPT o Google para que recomiende mi empresa?' : 'Can I pay ChatGPT or Google to recommend my business?',
    a: isEs
      ? 'No puedes comprar un lugar orgánico en respuestas de recomendación IA. Las recomendaciones dependen de claridad de entidad, datos estructurados, velocidad, reputación en terceros y respuesta directa a preguntas de compradores.'
      : 'You cannot buy organic placement inside ChatGPT, Gemini, or Google AI answers. Recommendations depend on entity clarity, structured schema, fast websites, third-party reviews, and direct answers.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<WatchShell
  title={isEs ? 'Sondri Watch — Visibilidad IA y Sitios Web Answer-Ready | watch.sondri.ai' : 'Sondri Watch — AI Visibility & Answer-Ready Websites | watch.sondri.ai'}
  description={isEs
    ? 'Revisa gratis cómo ChatGPT, Gemini y Google AI describen tu negocio. Auditoría 15 preguntas ($99), sitios web desde $390 y planes Watch desde $149/mes.'
    : 'See how ChatGPT, Gemini, and Google AI describe your business—plus answer-ready websites from $390 and done-for-you monthly Watch plans from $149/mo.'}
  lang={lang}
  activeTab="overview"
  alternates={alternates}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Floating Sticky Chapter Rail (Desktop) -->
  <nav class="chapter-rail" aria-label={isEs ? 'Capítulos de la historia' : 'Story chapters'}>
    {chapters.map((c, idx) => (
      <a
        href={`#${c.id}`}
        class:list={['rail-item', idx === 0 && 'is-active']}
        data-chapter-link={c.id}
        data-chapter-title={`${c.num} · ${c.title}`}
      >
        <span class="label rail-num">{c.num}</span>
        <span class="rail-label">{c.title}</span>
      </a>
    ))}
  </nav>

  <!-- CHAPTER 01 · HERO (AUDIT DIAGNOSIS ONLY — FIXES KEPT FOR PAID) -->
  <section class="section section-pad on-dark hero-watch" id="act-shift">
    <div class="wrap">
      <div class="hero-top-tag">
        <span class="label gold-pill">
          {isEs ? 'SONDRI WATCH · VISIBILIDAD IA Y SITIOS WEB' : 'SONDRI WATCH · AI VISIBILITY & WEBSITES'}
        </span>
        <span class="label muted-mono">
          ChatGPT · Gemini · Google AI Overviews · Google AI Mode
        </span>
      </div>

      <div class="hero-split">
        <div class="hero-copy" data-watch-reveal>
          <h1 class="h1 watch-h1">
            {isEs ? (
              <>Aparece cuando <em class="serif-em">preguntan a la IA.</em></>
            ) : (
              <>Get found <em class="serif-em">when buyers ask AI.</em></>
            )}
          </h1>
          <p class="lede hero-lede">
            {isEs
              ? 'Auditamos gratis cómo ChatGPT, Gemini y Google AI describen tu negocio—y luego construimos e implementamos las mejoras para recomendarte.'
              : 'Run a free check to see how ChatGPT, Gemini, and Google AI describe your business—then upgrade when you want fixes built and shipped.'}
          </p>

          <div class="hero-ctas">
            <a class="btn btn-gold" href="#free-check">
              {isEs ? 'Probar mi Sitio Gratis (3 Preguntas)' : 'Check My Website Free'} <span class="arr">→</span>
            </a>
            <a class="btn btn-outline-light" href="#pricing-ladder">
              {isEs ? 'Planes ($99–$399) y Webs' : 'Plans ($99–$399) & Websites'}
            </a>
            <a class="label text-link" href={`${prefix}/sample-report/`}>
              {isEs ? 'Ver reporte de ejemplo →' : 'Inspect sample report →'}
            </a>
          </div>

          <!-- Kinetic Inline SVG Signal Diagram -->
          <div class="hero-signal-box" aria-hidden="true">
            <svg viewBox="0 0 460 66" class="hero-flow-svg" fill="none">
              <line x1="74" y1="33" x2="386" y2="33" stroke="rgba(255,255,255,0.22)" stroke-width="1.5" stroke-dasharray="4 4" />
              <circle data-hero-packet cx="74" cy="33" r="4.5" fill="#fdb343" />
              <circle data-hero-packet cx="180" cy="33" r="3" fill="#5fc4bc" />

              <rect x="2" y="13" width="112" height="40" fill="#081f1f" stroke="rgba(255,255,255,0.28)" stroke-width="1.2" />
              <text x="58" y="30" text-anchor="middle" fill="#fdb343" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700">01 BUYER ASK</text>
              <text x="58" y="43" text-anchor="middle" fill="#c9dad7" font-family="IBM Plex Sans, sans-serif" font-size="10">Unbranded Prompt</text>

              <rect x="164" y="13" width="132" height="40" fill="#0d2a29" stroke="#fdb343" stroke-width="1.3" />
              <text x="230" y="30" text-anchor="middle" fill="#fdb343" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700">02 LIVE CHECK</text>
              <text x="230" y="43" text-anchor="middle" fill="#ffffff" font-family="IBM Plex Sans, sans-serif" font-size="10">ChatGPT · Gemini · AIO</text>

              <rect x="342" y="13" width="116" height="40" fill="#081f1f" stroke="#5fc4bc" stroke-width="1.3" />
              <text x="400" y="30" text-anchor="middle" fill="#5fc4bc" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700">03 AUDIT OUTPUT</text>
              <text x="400" y="43" text-anchor="middle" fill="#ffffff" font-family="IBM Plex Sans, sans-serif" font-size="10">Named Share &amp; Gaps</text>
            </svg>
          </div>
        </div>

        <!-- Right-Side Interactive Free Audit Diagnosis Preview Card (NO Fixes Given Free) -->
        <div class="preview-card" data-watch-reveal>
          <div class="vis-head">
            <div class="vis-head-top">
              <span class="label gold-kicker">
                {isEs ? 'QUÉ MUESTRA TU AUDITORÍA GRATIS' : 'WHAT THE FREE AUDIT SHOWS'}
              </span>
              <span class="label muted-mono">{isEs ? 'Solo diagnóstico · 3 preguntas' : 'Audit only · 3 buyer prompts'}</span>
            </div>
            <div class="industry-pills" role="tablist" aria-label={isEs ? 'Elegir industria' : 'Choose industry'}>
              {industries.map((ind, idx) => (
                <button
                  type="button"
                  role="tab"
                  class:list={['sc-tab', 'label', idx === 0 && 'is-active']}
                  data-ind-btn={ind.id}
                  data-ind-service={ind.servicePrefill}
                  aria-selected={idx === 0 ? 'true' : 'false'}
                >
                  {ind.label}
                </button>
              ))}
            </div>
          </div>

          {industries.map((ind, idx) => (
            <div
              class="ind-pane"
              data-ind-pane={ind.id}
              style={idx === 0 ? '' : 'display: none;'}
            >
              <div class="q-preview-list">
                {ind.questions.map((item) => (
                  <div class="q-row">
                    <div class="q-row-top">
                      <span class="label q-tag">{item.tag}</span>
                      <span class:list={['label', 'status-pill', item.status === 'miss' ? 'is-miss' : 'is-warn']}>
                        {item.outcome}
                      </span>
                    </div>
                    <p class="q-text">{item.q}</p>
                  </div>
                ))}
              </div>

              <div class="gaps-preview">
                <span class="label gap-kicker">
                  {isEs ? 'BRECHAS TÉCNICAS DETECTADAS (SOLO DIAGNÓSTICO)' : 'TECHNICAL GAPS FLAGGED IN FREE CHECK'}
                </span>
                <div class="fix-chips-row">
                  {ind.gaps.map((gp) => (
                    <span class="gap-chip">{gp}</span>
                  ))}
                </div>
                <p class="lock-note label">
                  {isEs
                    ? '🔒 La hoja de correcciones paso a paso e implementación se desbloquean en la Auditoría ($99) y planes Watch.'
                    : '🔒 Step-by-step fix roadmap & done-for-you implementation unlock in the $99 Audit & Watch plans.'}
                </p>
              </div>
            </div>
          ))}

          <div class="preview-foot">
            <span class="label muted-mono">
              {isEs ? 'Aplica a cualquier rubro de confianza.' : 'Works for any trust-driven business.'}
            </span>
            <button type="button" class="label jump-check-btn" id="heroRunOwnBtn">
              {isEs ? 'Auditar mi sitio gratis ↓' : 'Audit my own website free ↓'}
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 02 · LIVE 3-PROMPT FREE AUDIT -->
  <div id="free-check-wrap">
    <MiniAudit defaultLang={lang} embedded={true} />
  </div>

  <!-- CHAPTER 03 · 4-CARD OFFER SUMMARY STRIP + "A SHORT REPORT YOU CAN ACT ON" (on-paper) -->
  <section class="section section-pad on-paper" id="act-report">
    <div class="wrap">
      <!-- 4-Card Summary Strip (Screenshot 1) -->
      <div class="offer-strip-4" data-watch-reveal>
        {offerStrip.map((item) => (
          <a href={item.href} class="strip-card">
            <span class="label strip-kicker">{item.kicker}</span>
            <p class="strip-price">{item.price}</p>
            <p class="body-s strip-desc">{item.desc}</p>
          </a>
        ))}
      </div>

      <div class="bento-head" data-watch-reveal>
        <span class="label dot-kicker"><span class="dot-gold" aria-hidden="true"></span> {isEs ? 'QUÉ OBTIENES' : 'WHAT YOU GET'}</span>
        <h2 class="h2 bento-h2">
          {isEs ? (
            <>Un reporte corto <em class="serif-em">para actuar hoy.</em></>
          ) : (
            <>A short report <em class="serif-em">you can act on.</em></>
          )}
        </h2>
        <p class="lede bento-sub">
          {isEs
            ? 'Chequeo gratis en vivo de 3 preguntas. Auditoría completa de 15 preguntas ($99) en 48 horas con lista de correcciones.'
            : 'Free 3-question check online in 60 seconds. Full 15-question written audit ($99) in 48 hours with prioritized fixes.'}
        </p>
      </div>

      <div class="bento-2x2">
        {reportCards.map((card) => (
          <article class="bento-card" data-bento-card>
            <div class="icon-badge" aria-hidden="true">
              {card.icon === 'question' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                  <path d="M12 17h.01" />
                </svg>
              )}
              {card.icon === 'eye' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              )}
              {card.icon === 'pin' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              )}
              {card.icon === 'bolt' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                </svg>
              )}
            </div>
            <h3 class="h5">{card.title}</h3>
            <p class="body-s bento-copy">{card.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CHAPTER 04 · HOW IT WORKS ("Check. Fix. Strengthen. Measure." + Kinetic Blueprint SVG) -->
  <section class="section section-pad on-off" id="act-loop">
    <div class="wrap">
      <div class="sec-head" data-watch-reveal>
        <div>
          <span class="label dot-kicker"><span class="dot-gold" aria-hidden="true"></span> {isEs ? 'CÓMO FUNCIONA' : 'HOW IT WORKS'}</span>
          <h2 class="h2">
            {isEs ? (
              <>Medir. Corregir. <em class="serif-em">Fortalecer. Seguir.</em></>
            ) : (
              <>Check. Fix. <em class="serif-em">Strengthen. Measure.</em></>
            )}
          </h2>
        </div>
        <div class="intro">
          <p class="lede">
            {isEs
              ? 'Una foto suelta no basta porque la IA actualiza respuestas cada semana. Haz clic en cada fase para ver cómo construimos tu visibilidad.'
              : 'One snapshot isn’t enough because AI answers shift every week. Step through each phase to see how we build and compound visibility.'}
          </p>
        </div>
      </div>

      <div class="loop-split" data-watch-reveal>
        <div class="loop-controls">
          <div class="phase-tabs" role="tablist" aria-label={isEs ? 'Fases del servicio' : 'Visibility phases'}>
            {phases.map((ph, i) => (
              <button
                type="button"
                role="tab"
                class:list={['phase-tab', i === 0 && 'is-active']}
                data-phase-btn={String(i)}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                <span class="label phase-tab-lbl">{ph.tab}</span>
                <strong class="phase-tab-pct">{ph.share}%</strong>
              </button>
            ))}
          </div>

          {phases.map((ph, i) => (
            <div class="phase-pane" data-phase-pane={String(i)} style={i === 0 ? '' : 'display: none;'}>
              <span class="label phase-num-tag">{ph.metricLabel}</span>
              <h3 class="h4 phase-title">{ph.num} · {ph.name}</h3>
              <p class="body-s phase-summary">{ph.summary}</p>
              <p class="label phase-deliv">■ {ph.deliverable}</p>

              <div class="mini-engines">
                <div class="m-eng">
                  <div class="m-eng-top">
                    <span class="label">ChatGPT</span>
                    <span class="label">{ph.chatgpt}%</span>
                  </div>
                  <div class="m-track"><div class="m-fill" style={`width: ${ph.chatgpt}%`}></div></div>
                </div>
                <div class="m-eng">
                  <div class="m-eng-top">
                    <span class="label">Gemini</span>
                    <span class="label">{ph.gemini}%</span>
                  </div>
                  <div class="m-track"><div class="m-fill" style={`width: ${ph.gemini}%`}></div></div>
                </div>
                <div class="m-eng">
                  <div class="m-eng-top">
                    <span class="label">Google AI</span>
                    <span class="label">{ph.aio}%</span>
                  </div>
                  <div class="m-track"><div class="m-fill" style={`width: ${ph.aio}%`}></div></div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="blueprint-stage" data-active-phase="0" id="blueprintStage">
          <div class="bp-top-bar">
            <span class="label bp-tag">AI VISIBILITY ARCHITECTURE · SONDRI WATCH</span>
            <span class="label bp-kpi" id="bpKpiLabel">STAGE 01 / 04 · 14% SHARE</span>
          </div>

          <svg viewBox="0 0 460 300" class="bp-svg" role="img" aria-label="Progressive 4-layer AI visibility architecture">
            <defs>
              <pattern id="bpGridMinor" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="0.8" />
              </pattern>
              <pattern id="bpGridMajor" width="80" height="80" patternUnits="userSpaceOnUse">
                <rect width="80" height="80" fill="url(#bpGridMinor)" />
                <path d="M 80 0 L 0 0 0 80" fill="none" stroke="rgba(253,179,67,0.10)" stroke-width="1" />
              </pattern>
            </defs>

            <rect width="460" height="300" fill="#061919" />
            <rect width="460" height="300" fill="url(#bpGridMajor)" />

            <!-- Growth Curve Overlay above Roof -->
            <path d="M 60 52 C 155 48, 255 36, 404 20" stroke="rgba(95,196,188,0.34)" stroke-width="1.5" stroke-dasharray="4 4" fill="none" />
            <circle cx="84" cy="51" r="4" class="curve-node" data-curve-idx="0" />
            <circle cx="192" cy="43" r="4" class="curve-node" data-curve-idx="1" />
            <circle cx="300" cy="31" r="4" class="curve-node" data-curve-idx="2" />
            <circle cx="404" cy="20" r="5" class="curve-node" data-curve-idx="3" />

            <!-- LAYER 04 · Roof Signal & Weekly Drift Loop -->
            <g class="bp-layer" data-bp-layer="3">
              <polygon points="154,66 306,66 388,124 72,124" class="bp-box" />
              <rect x="193" y="75" width="74" height="17" rx="8.5" class="bp-accent-circle" />
              <text x="230" y="86.5" text-anchor="middle" class="bp-mono" font-size="8.5">04 WATCH</text>
              <text x="230" y="111" text-anchor="middle" class="bp-text" font-size="10">Weekly Drift Loop + Monthly Shipped Fix</text>
            </g>

            <!-- LAYER 03 · Citation Pillars & Answer-Ready Content -->
            <g class="bp-layer" data-bp-layer="2">
              <rect x="86" y="132" width="136" height="44" class="bp-box" />
              <text x="154" y="150" text-anchor="middle" class="bp-mono" font-size="8.5">03 ANSWER PAGES</text>
              <text x="154" y="165" text-anchor="middle" class="bp-text" font-size="10">FAQ &amp; Service Proof</text>

              <rect x="238" y="132" width="136" height="44" class="bp-box" />
              <text x="306" y="150" text-anchor="middle" class="bp-mono" font-size="8.5">03 CITATIONS</text>
              <text x="306" y="165" text-anchor="middle" class="bp-text" font-size="10">Trusted Directories</text>
            </g>

            <!-- LAYER 02 · Entity Frame, Schema & Business Hubs -->
            <g class="bp-layer" data-bp-layer="1">
              <rect x="74" y="184" width="312" height="42" class="bp-box" />
              <text x="230" y="201" text-anchor="middle" class="bp-mono" font-size="8.5">02 ENTITY &amp; LISTINGS FRAME</text>
              <text x="230" y="216" text-anchor="middle" class="bp-text" font-size="10.5">JSON-LD Schema · OpenAI Business Hub · Bing AI · GBP</text>
            </g>

            <!-- LAYER 01 · Crawler Foundation & 15-Prompt Baseline -->
            <g class="bp-layer is-lit" data-bp-layer="0">
              <rect x="60" y="234" width="340" height="44" class="bp-box" />
              <text x="230" y="252" text-anchor="middle" class="bp-mono" font-size="8.5">01 CRAWLER FOUNDATION &amp; BASELINE</text>
              <text x="230" y="267" text-anchor="middle" class="bp-text" font-size="10.5">OAI-SearchBot Access · Mobile CWV · Benchmark Prompts</text>
            </g>

            <text x="414" y="260" class="bp-dim">01</text>
            <text x="414" y="209" class="bp-dim">02</text>
            <text x="414" y="158" class="bp-dim">03</text>
            <text x="414" y="106" class="bp-dim">04</text>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 05 · SERVICES 4-PILLAR HORIZONTAL ACCORDION (LINKED TO SERVICE PAGES) -->
  <section class="section section-pad on-dark" id="act-services">
    <div class="wrap">
      <div class="services-head" data-watch-reveal>
        <span class="label dot-kicker"><span class="dot-gold" aria-hidden="true"></span> {isEs ? 'SERVICIOS' : 'SERVICES'}</span>
        <h2 class="h2">
          {isEs ? (
            <>Visible. Confiable. <em class="serif-em">Recomendado. Contactado.</em></>
