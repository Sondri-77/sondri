<script>
  // Interactive Act 01 Industry Prompt Simulator Tabs
  document.querySelectorAll<HTMLButtonElement>('[data-scenario-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-scenario-btn');
      document.querySelectorAll<HTMLButtonElement>('[data-scenario-btn]').forEach((b) => {
        const active = b.getAttribute('data-scenario-btn') === id;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
      document.querySelectorAll<HTMLElement>('[data-scenario-pane]').forEach((pane) => {
        pane.style.display = pane.getAttribute('data-scenario-pane') === id ? 'block' : 'none';
      });
    });
  });

  // Interactive Act 04 Week 1 -> Week 4 Scrubber
  document.querySelectorAll<HTMLButtonElement>('[data-week-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const wk = btn.getAttribute('data-week-btn');
      document.querySelectorAll<HTMLButtonElement>('[data-week-btn]').forEach((b) => {
        const active = b.getAttribute('data-week-btn') === wk;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
      document.querySelectorAll<HTMLElement>('[data-week-pane]').forEach((pane) => {
