---
import type { Lang } from '../../i18n';
import WatchShell from './WatchShell.astro';
import MiniAudit from '../MiniAudit.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const isEs = lang === 'es';
const prefix = isEs ? '/es/watch' : '/watch';

const alternates = {
  en: '/watch/',
  es: '/es/watch/',
};

const chapters = isEs
  ? [
      { id: 'act-shift', num: '01', title: 'Inicio' },
      { id: 'free-check', num: '02', title: 'Test Gratis' },
      { id: 'act-report', num: '03', title: 'Qué Recibes' },
      { id: 'act-loop', num: '04', title: 'Cómo Funciona' },
      { id: 'act-services', num: '05', title: 'Servicios' },
      { id: 'pricing-ladder', num: '06', title: 'Planes' },
      { id: 'act-faq', num: '07', title: 'Preguntas' },
    ]
  : [
      { id: 'act-shift', num: '01', title: 'Overview' },
      { id: 'free-check', num: '02', title: 'Free Check' },
      { id: 'act-report', num: '03', title: 'What You Get' },
      { id: 'act-loop', num: '04', title: 'How It Works' },
      { id: 'act-services', num: '05', title: 'Services' },
      { id: 'pricing-ladder', num: '06', title: 'Plans' },
      { id: 'act-faq', num: '07', title: 'FAQ' },
    ];

const industries = [
  {
    id: 'medical',
    label: isEs ? 'Salud y Dental' : 'Medical & Dental',
    servicePrefill: isEs ? 'Clínica dental e implantes' : 'Dental implants clinic',
    questions: [
      {
        tag: isEs ? 'P1 · CATEGORÍA' : 'Q1 · CATEGORY',
        q: isEs
          ? '“¿Cuál es la mejor clínica dental para implantes en mi comuna?”'
          : '“Who is the highest-rated dental implant clinic in my city?”',
        status: 'miss',
        outcome: isEs ? '✗ No mencionada · 3 clínicas citadas' : '✗ Not mentioned · 3 competitors named',
      },
      {
        tag: isEs ? 'P2 · SERVICIO' : 'Q2 · SPECIALTY',
        q: isEs
          ? '“¿Qué clínica atiende urgencias y corona en el día?”'
          : '“Which practice offers same-day crowns with transparent pricing?”',
        status: 'warn',
        outcome: isEs ? '⚠ Nombrada · Sin precios ni schema' : '⚠ Mentioned · Outdated service details',
      },
      {
        tag: isEs ? 'P3 · TU MARCA' : 'Q3 · BRAND CHECK',
        q: isEs
          ? '“¿Es recomendable [Tu Clínica] para pacientes?”'
          : '“Is [Your Clinic] a good choice for dental care?”',
        status: 'warn',
        outcome: isEs ? '⚠ Toma datos antiguos de directorios' : '⚠ Pulls from an old directory listing',
      },
    ],
    fixes: isEs
      ? ['01 Schema Dentist + FAQPage', '02 OpenAI & Bing AI Hub', '03 Página de tratamientos']
      : ['01 Dentist & FAQPage schema', '02 Claim OpenAI & Bing AI hubs', '03 Answer-ready fee page'],
  },
  {
    id: 'legal',
    label: isEs ? 'Legal y Asesoría' : 'Law & Advisory',
    servicePrefill: isEs ? 'Estudio jurídico familia y laboral' : 'Employment & corporate law firm',
    questions: [
      {
        tag: isEs ? 'P1 · CATEGORÍA' : 'Q1 · CATEGORY',
        q: isEs
          ? '“Recomienda estudios jurídicos especialistas en familia o laboral”'
          : '“Which boutique employment law firm advises growing companies?”',
        status: 'miss',
        outcome: isEs ? '✗ Omitido · 5 estudios en terna' : '✗ Skipped · 5 competing firms cited',
      },
      {
        tag: isEs ? 'P2 · ESPECIALIDAD' : 'Q2 · SPECIALTY',
        q: isEs
          ? '“¿Qué abogado revisa contratos ejecutivos o pactos de socios?”'
          : '“Who handles executive equity & commercial contract reviews?”',
        status: 'miss',
        outcome: isEs ? '✗ Sin páginas por área de práctica' : '✗ No dedicated practice page found',
      },
      {
        tag: isEs ? 'P3 · TU MARCA' : 'Q3 · BRAND CHECK',
        q: isEs
          ? '“¿Qué experiencia y cobertura tiene [Tu Estudio]?”'
          : '“What does [Your Firm] specialize in and who leads it?”',
        status: 'warn',
        outcome: isEs ? '⚠ Socios y cobertura incompletos' : '⚠ Missing partner bio & credentials',
      },
    ],
    fixes: isEs
      ? ['01 Schema LegalService + Attorney', '02 Guías por área legal', '03 Citas en directorios']
      : ['01 LegalService JSON-LD', '02 Dedicated practice-area FAQs', '03 Verified legal directories'],
  },
  {
    id: 'b2b',
    label: 'B2B & SaaS',
    servicePrefill: isEs ? 'Automatización e integración B2B' : 'B2B workflow software',
    questions: [
      {
        tag: isEs ? 'P1 · PROBLEMA' : 'Q1 · PROBLEM',
        q: isEs
          ? '“¿Cómo automatizar conciliación CRM–ERP sin cambiar de sistema?”'
          : '“How do ops teams automate CRM-to-ERP sync without replatforming?”',
        status: 'miss',
        outcome: isEs ? '✗ IA sugiere solo plataformas masivas' : '✗ Defaults to 3 legacy tools',
      },
      {
        tag: isEs ? 'P2 · COMPARATIVA' : 'Q2 · VS SEARCH',
        q: isEs
          ? '“Mejores alternativas a desarrollo in-house para logística B2B”'
          : '“Best custom workflow automation partners for mid-market teams”',
        status: 'warn',
        outcome: isEs ? '⚠ Faltan comparativas estructuradas' : '⚠ No benchmark or proof cited',
      },
      {
        tag: isEs ? 'P3 · TU MARCA' : 'Q3 · BRAND CHECK',
        q: isEs
          ? '“¿Para quién está diseñado [Tu Software / Agencia]?”'
          : '“Who is [Your Company] best suited for and how much does it cost?”',
        status: 'warn',
        outcome: isEs ? '⚠ Sin datos claros de alcance/precio' : '⚠ Unclear pricing & ICP facts',
      },
    ],
    fixes: isEs
      ? ['01 llms.txt + Schema Software/Offer', '02 Bloques comparativos AEO', '03 Casos con métricas citables']
      : ['01 llms.txt & Offer schema', '02 Clear comparison matrices', '03 Grounded case study stats'],
  },
  {
    id: 'ecommerce',
    label: 'Ecommerce',
    servicePrefill: isEs ? 'Tienda online y catálogo de productos' : 'Direct-to-consumer ecommerce brand',
    questions: [
      {
        tag: isEs ? 'P1 · COMPRA' : 'Q1 · SHOPPING',
        q: isEs
          ? '“Mejores botas impermeables de cuero bajo $250 con envío rápido”'
          : '“Best waterproof leather boots under $250 with 2-day shipping”',
        status: 'miss',
        outcome: isEs ? '✗ Fuera del carrusel por falta de Offer JSON-LD' : '✗ Excluded · Incomplete Offer schema',
      },
      {
        tag: isEs ? 'P2 · POLÍTICAS' : 'Q2 · TRUST SIGNALS',
        q: isEs
          ? '“¿Qué tienda ofrece cambios gratis y stock inmediato?”'
          : '“Which stores offer free returns and guaranteed US stock?”',
        status: 'warn',
        outcome: isEs ? '⚠ Política de envíos ilegible para agentes' : '⚠ Return policy unreadable to agents',
      },
      {
        tag: isEs ? 'P3 · TU MARCA' : 'Q3 · BRAND CHECK',
        q: isEs
          ? '“¿Es confiable comprar en [Tu Tienda]?”'
          : '“Are [Your Brand] products durable and worth buying?”',
        status: 'warn',
        outcome: isEs ? '⚠ Pocas reseñas externas verificadas' : '⚠ Thin verified third-party reviews',
      },
    ],
    fixes: isEs
      ? ['01 Schema Product + Offer completo', '02 Política ACP / Google UCP', '03 FAQ de materiales y envíos']
      : ['01 Product & Offer schema', '02 Merchant return & shipping tags', '03 ChatGPT ACP readiness fix'],
  },
  {
    id: 'realestate',
    label: isEs ? 'Inmobiliaria y Hogar' : 'Real Estate & Home',
    servicePrefill: isEs ? 'Servicios inmobiliarios o remodelación' : 'Home remodeling & real estate advisor',
    questions: [
      {
        tag: isEs ? 'P1 · CATEGORÍA' : 'Q1 · CATEGORY',
        q: isEs
          ? '“¿Qué empresa confiable hace remodelaciones llave en mano aquí?”'
          : '“Who are the most reliable design-build remodelers in this metro?”',
        status: 'miss',
        outcome: isEs ? '✗ Solo aparecen directorios generales' : '✗ Aggregators win over your site',
      },
      {
        tag: isEs ? 'P2 · PRESUPUESTO' : 'Q2 · BUDGET',
        q: isEs
          ? '“¿Cuánto tarda una remodelación completa y qué garantía dan?”'
          : '“How long does a full kitchen remodel take and what warranties apply?”',
        status: 'warn',
        outcome: isEs ? '⚠ IA responde con promedios genéricos' : '⚠ Generic industry reply cited',
      },
      {
        tag: isEs ? 'P3 · TU MARCA' : 'Q3 · BRAND CHECK',
        q: isEs
          ? '“¿En qué zonas trabaja [Tu Empresa] y qué proyectos ha hecho?”'
          : '“What neighborhoods does [Your Brand] serve?”',
        status: 'warn',
        outcome: isEs ? '⚠ Zonas y horarios desactualizados' : '⚠ Service areas out of sync',
      },
    ],
    fixes: isEs
      ? ['01 LocalBusiness + AreaServed', '02 GBP + Apple Business Connect', '03 Guías de plazos y garantía']
      : ['01 LocalBusiness + areaServed', '02 Sync GBP & Apple Connect', '03 Transparent scope guides'],
  },
  {
    id: 'local',
    label: isEs ? 'Servicios Locales' : 'Local Services',
    servicePrefill: isEs ? 'Servicios profesionales locales' : 'Local service business',
    questions: [
      {
        tag: isEs ? 'P1 · CATEGORÍA' : 'Q1 · CATEGORY',
        q: isEs
          ? '“¿A quién contratar en mi ciudad para [tu servicio principal]?”'
          : '“Who is the most dependable [service provider] near me?”',
        status: 'miss',
        outcome: isEs ? '✗ No apareces en la terna inicial' : '✗ Omitted from AI top shortlist',
      },
      {
        tag: isEs ? 'P2 · ALCANCE' : 'Q2 · SCOPE',
        q: isEs
          ? '“¿Qué incluye el servicio, horarios y cobertura geográfica?”'
          : '“Who covers urgent same-week visits with clear pricing?”',
        status: 'warn',
        outcome: isEs ? '⚠ Sin datos estructurados legibles' : '⚠ AI guesses hours and coverage',
      },
      {
        tag: isEs ? 'P3 · TU MARCA' : 'Q3 · BRAND CHECK',
        q: isEs
          ? '“Opiniones y reputación de [Tu Negocio]”'
          : '“Should I hire [Your Business]? Reviews and overview.”',
        status: 'warn',
        outcome: isEs ? '⚠ Cita información incompleta' : '⚠ Relies on outdated directory data',
      },
    ],
    fixes: isEs
      ? ['01 Habilitar bots en robots.txt', '02 Schema Service + FAQPage', '03 Alineación de directorios IA']
      : ['01 Unblock AI crawlers + llms.txt', '02 Service & FAQPage schema', '03 Official AI directory sync'],
  },
];

const reportCards = [
  {
    icon: 'question',
    title: isEs ? 'Preguntas reales de compradores' : 'Real buyer questions',
    desc: isEs
      ? 'Consultamos exactamente lo que tus clientes preguntan a la IA, en tu ciudad y especialidad.'
      : 'We ask the exact questions your clients ask AI, in your city and specialty.',
  },
  {
    icon: 'eye',
    title: isEs ? 'Cómo te describe la IA' : 'How AI describes you',
    desc: isEs
      ? 'Si te nombra, si te recomienda frente a terceros y si los datos que entrega son exactos.'
      : 'Whether you are named, recommended, or skipped—and how accurately.',
  },
  {
    icon: 'pin',
    title: isEs ? 'Fuentes que está citando' : 'Sources cited',
    desc: isEs
      ? 'Qué directorios, reseñas y páginas de competidores usa cada motor para formar su respuesta.'
      : 'Which directories, reviews, and competitor pages AI relies on.',
  },
  {
    icon: 'bolt',
    title: isEs ? 'Tus primeras 3 correcciones' : 'Your first 3 fixes',
    desc: isEs
      ? 'Priorizadas en orden de impacto: aplicables por tu equipo o ejecutadas directo por Sondri.'
      : 'Clear, prioritized, doable by your team—or shipped directly by us.',
  },
];

const phases = [
  {
    num: '01',
    id: 'check',
    tab: isEs ? '01 Medir' : '01 Check',
    name: isEs ? 'Línea Base en 4 Motores' : 'Baseline Across 4 Engines',
    share: 14,
    metricLabel: isEs ? 'Cuota inicial promedio' : 'Typical baseline named-share',
    summary: isEs
      ? 'Fijamos entre 25 y 75 preguntas reales sin marca, las corremos sin sesión iniciada y auditamos bots, schema y reseñas.'
      : 'We lock 25–75 unbranded buyer questions, run them logged out across ChatGPT, Gemini, AI Overviews & AI Mode, and audit crawlers + schema.',
    deliverable: isEs ? 'Entrega: Score 0–100 + Mapa de Brechas en 48 h' : 'Deliverable: Live baseline score + prioritized fix roadmap in 48h',
    chatgpt: 12,
    gemini: 18,
    aio: 11,
  },
  {
    num: '02',
    id: 'fix',
    tab: isEs ? '02 Corregir' : '02 Fix',
    name: isEs ? 'Schema, Bots y Perfiles IA' : 'Technical Schema & Official Hubs',
    share: 29,
    metricLabel: isEs ? 'Tras Fix #1 en semana 2' : 'After Week 2 foundation fixes',
    summary: isEs
      ? 'Desplegamos JSON-LD válido, habilitamos rastreadores IA y alineamos OpenAI Business Hub, Bing AI, Apple y Google.'
      : 'Our engineers ship validated JSON-LD, clean robots.txt/llms.txt rules, and sync OpenAI Business Hub, Bing AI Performance, Apple & GBP.',
    deliverable: isEs ? 'Fix desplegado: Identidad verificada en directorios oficiales' : 'Shipped fix: Verified entity identity + machine-readable facts',
    chatgpt: 28,
    gemini: 34,
    aio: 25,
  },
  {
    num: '03',
    id: 'strengthen',
    tab: isEs ? '03 Fortalecer' : '03 Strengthen',
    name: isEs ? 'Páginas Citables y Autoridad' : 'Answer-Ready Pages & Citations',
    share: 46,
    metricLabel: isEs ? 'Tras contenido y citas clave' : 'After answer-ready page updates',
    summary: isEs
      ? 'Publicamos páginas de servicio y FAQ estructuradas para respuesta directa y reforzamos citas en los portales que la IA lee.'
      : 'We publish structured service & FAQ pages built to be quoted verbatim and close high-trust directory citations competitors already hold.',
    deliverable: isEs ? 'Fix desplegado: Bloques FAQ + Comparativas citables' : 'Shipped fix: Citation clusters + answer-ready service pages',
    chatgpt: 44,
    gemini: 52,
    aio: 42,
  },
  {
    num: '04',
    id: 'measure',
    tab: isEs ? '04 Monitorear' : '04 Measure',
    name: isEs ? 'Rastreo Semanal + Mejora Mensual' : 'Weekly Drift Watch + Monthly Fixes',
    share: 58,
    metricLabel: isEs ? 'Visibilidad acumulada mensual' : 'Compounded named-share curve',
    summary: isEs
      ? 'Cada semana detectamos cambios silenciosos de modelo. Cada mes recibes reporte vivo + PDF y una nueva mejora ya implementada.'
      : 'Weekly runs catch model updates and competitor moves early. Every month you get a live Page + PDF diff report and fresh fixes shipped.',
    deliverable: isEs ? 'Ciclo continuo: Reporte mensual + mejoras constantes' : 'Recurring loop: Weekly engine telemetry + fixes shipped monthly',
    chatgpt: 56,
    gemini: 64,
    aio: 54,
  },
];

const servicePillars = [
  {
    num: '01',
    id: 'aeo',
    title: 'AEO',
    subtitle: isEs
      ? 'Optimización estructural para que los motores de respuesta entiendan qué vendes y a quién recomiendan.'
      : 'Make your site machine-readable so answer engines extract accurate facts cleanly.',
    items: isEs
      ? ['Servicios de AEO', 'AI SEO Técnico', 'ChatGPT SEO', 'Google AI Overviews', 'Implementación llms.txt & Schema JSON-LD']
      : ['AEO Services', 'AI SEO', 'ChatGPT SEO', 'Google AI Overviews', 'llms.txt & Schema Setup'],
  },
  {
    num: '02',
    id: 'geo',
    title: 'GEO',
    subtitle: isEs
      ? 'Medición semanal y construcción de citas externas para ganar presencia en respuestas generativas.'
      : 'Measure and grow how often ChatGPT, Gemini, and Google AI name your brand.',
    items: isEs
      ? ['Servicios de GEO', 'Visibilidad en Gemini y Perplexity', 'Auditoría de Búsqueda IA (15–75 preguntas)', 'Construcción de Citas IA', 'Reportes Semanales de Visibilidad']
      : ['GEO Services', 'Gemini & Perplexity Visibility', 'AI Search Audit (15–75 Questions)', 'AI Citation Building', 'Weekly AI Visibility Reporting'],
  },
  {
    num: '03',
    id: 'reputation',
    title: isEs ? 'Reputación' : 'Reputation',
    subtitle: isEs
      ? 'Alineación de señales de confianza entre fichas oficiales, reseñas y directorios que la IA verifica.'
      : 'Ensure external directories, reviews, and official business hubs reinforce trust.',
    items: isEs
      ? ['Gestión de Reputación en IA', 'OpenAI Business Hub & Bing AI', 'Google Business Profile & Apple Business', 'Señales de Reseñas y Consistencia NAP']
      : ['AI Reputation Management', 'OpenAI Business Hub & Bing AI Setup', 'Google Business Profile & Apple Business', 'Review & Entity Trust Signals'],
  },
  {
    num: '04',
    id: 'websites',
    title: isEs ? 'Sitios Web' : 'Websites',
    subtitle: isEs
      ? 'Páginas rápidas, claras y estructuradas tanto para compradores humanos como para agentes.'
      : 'Fast, answer-ready service pages engineered for human conversion and AI citations.',
    items: isEs
      ? ['Páginas de Servicio y FAQ Citables', 'SEO Técnico y SEO Local', 'Core Web Vitals y Velocidad Móvil', 'Preparación Agentic Checkout (ACP / UCP)']
      : ['Answer-Ready Service & FAQ Pages', 'Technical SEO & Local SEO', 'Core Web Vitals & Speed Optimization', 'Agentic Checkout Readiness (ACP / UCP)'],
  },
];

const faqs = [
  {
    q: isEs ? '¿Qué es la visibilidad en IA?' : 'What is AI visibility?',
    a: isEs
      ? 'Es la frecuencia y precisión con la que asistentes como ChatGPT, Gemini y Google AI Overviews mencionan, describen y recomiendan tu empresa cuando un comprador hace una pregunta sin nombrar tu marca.'
      : 'AI visibility measures how often—and how accurately—answer engines like ChatGPT, Gemini, and Google AI mention and recommend your business when buyers ask unbranded questions in your category.',
  },
  {
    q: isEs ? '¿Cuál es la diferencia entre AEO, GEO y AI SEO?' : 'AEO vs. GEO vs. AI SEO—what is the difference?',
    a: isEs
      ? 'AEO (Answer Engine Optimization) estructura tu sitio, schema y entidades para respuestas directas; GEO (Generative Engine Optimization) fortalece citas y presencia dentro de síntesis generativas multi-fuente; AI SEO une ambas disciplinas con SEO técnico clásico y velocidad web.'
      : 'AEO focuses on structuring your pages, schema, and entity data for direct answers. GEO builds the external citations and category authority generative models synthesize. Sondri Watch combines both alongside fast technical SEO.',
  },
  {
    q: isEs ? '¿Cuántas preguntas prueban en el test gratis vs. planes pagos?' : 'How many buyer questions do you test in Free vs. Paid plans?',
    a: isEs
      ? 'El test gratuito en esta página prueba 3 preguntas clave en vivo (2 sin marca y 1 de marca). La Auditoría Única ($99) evalúa 15 preguntas × 3 corridas en 4 motores (180 chequeos). Los planes mensuales rastrean 25 (Starter), 40 (Growth) o 75 preguntas (Pro) cada semana.'
      : 'Our free on-page check tests 3 live buyer questions (2 unbranded + 1 brand verification). The $99 Baseline Audit tests 15 buyer questions × 3 runs across 4 engines (180 checks). Monthly Watch plans track 25 (Starter), 40 (Growth), or 75 buyer questions (Pro) every week.',
  },
  {
    q: isEs ? '¿Cuánto tiempo tarda en verse el impacto?' : 'How long does it take to see results?',
    a: isEs
      ? 'Correcciones técnicas (robots.txt, llms.txt, JSON-LD y OpenAI/Bing Hubs) suelen reflejarse en 2 a 4 semanas a medida que los rastreadores en vivo indexan los cambios. Citas en directorios y páginas comparativas consolidan mejoras medibles entre el mes 1 y el mes 3.'
      : 'Technical schema, crawler access, and OpenAI/Bing Business Hub updates often show movement within 2–4 weeks as live search bots re-index. Answer-ready pages and third-party citations compound visibility steadily across months 1–3.',
  },
  {
    q: isEs ? '¿Necesito rehacer mi sitio web completo?' : 'Do I need a new website?',
    a: isEs
      ? 'Casi nunca. Trabajamos sobre tu dominio actual (WordPress, Webflow, Shopify, Next.js, Astro o código propio) añadiendo schema validado, bloques FAQ, archivos llms.txt y mejoras puntuales de velocidad sin rediseñar todo tu sitio.'
      : 'Rarely. In most cases we ship validated JSON-LD, FAQ sections, llms.txt, and speed fixes directly on your existing stack (Shopify, Webflow, WordPress, Next.js, or Astro) without rebuilding your site.',
  },
  {
    q: isEs ? '¿Garantizan que ChatGPT nos recomendará siempre en #1?' : 'Do you guarantee AI will recommend us?',
    a: isEs
      ? 'Ningún proveedor serio puede garantizar un prompt no determinista en #1, porque la IA responde probabilísticamente. Lo que sí garantizamos es cobertura semanal reproducible (sin sesión iniciada), transparencia exacta de menciones y mejoras técnicas reales publicadas cada mes.'
      : 'No honest team can guarantee deterministic #1 placement inside probabilistic models. What we guarantee is repeatable logged-out tracking, accurate factual representation of your business, and real engineering fixes shipped on your site every month.',
  },
  {
    q: isEs ? '¿Cómo puedo verificar si ChatGPT recomienda mi negocio ahora?' : 'How do I check if ChatGPT recommends my business right now?',
    a: isEs
      ? 'Usa nuestro inspector gratuito arriba en menos de 60 segundos: evalúa tu sitio técnico y corre 3 prompts de compra reales sin historial previo, o solicita la auditoría de 15 preguntas ($99) para ver cada competidor y fuente citada.'
      : 'Run our free 60-second checker above to inspect your technical gates and 3 live buyer questions without login bias—or order the $99 15-question baseline audit for a complete 4-engine competitor and source breakdown.',
  },
  {
    q: isEs ? '¿Se puede pagar a ChatGPT o Google para que recomiende mi empresa?' : 'Can I pay ChatGPT or Google to recommend my business?',
    a: isEs
      ? 'No puedes comprar un lugar en las respuestas orgánicas recomendadas por ChatGPT o Gemini. Las recomendaciones dependen de claridad de entidad, datos estructurados, velocidad, reputación en terceros y respuesta directa a las preguntas del comprador.'
      : 'You cannot buy organic placement inside ChatGPT, Gemini, or Google AI answers. Recommendations come from verified entity signals, clean structured data, fast pages, reputable citations, and clear answers to buyer questions.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<WatchShell
  title={isEs ? 'Sondri Watch — Visibilidad en ChatGPT, Gemini y Google AI | watch.sondri.ai' : 'Sondri Watch — Get Found When Buyers Ask AI | watch.sondri.ai'}
  description={isEs
    ? 'Revisa gratis cómo ChatGPT, Gemini y Google AI describen tu negocio. Auditoría base de 15 preguntas ($99) y planes Watch llave en mano desde $149/mes.'
    : 'See how ChatGPT, Gemini, and Google AI describe your business—and get done-for-you fixes shipped every month. Free 3-question check, $99 full audit, plans from $149/mo.'}
  lang={lang}
  activeTab="overview"
  alternates={alternates}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Floating Sticky Chapter Rail (Desktop) -->
  <nav class="chapter-rail" aria-label={isEs ? 'Capítulos de la historia' : 'Story chapters'}>
    {chapters.map((c, idx) => (
      <a
        href={`#${c.id}`}
        class:list={['rail-item', idx === 0 && 'is-active']}
        data-chapter-link={c.id}
        data-chapter-title={`${c.num} · ${c.title}`}
      >
        <span class="label rail-num">{c.num}</span>
        <span class="rail-label">{c.title}</span>
      </a>
    ))}
  </nav>

  <!-- CHAPTER 01 · PUNCHY HERO + KINETIC SIGNAL FLOW + 6-VERTICAL 3-QUESTION PREVIEW -->
  <section class="section section-pad on-dark hero-watch" id="act-shift">
