    deliverable: isEs ? 'Reporte mensual + fixes continuos' : 'Monthly loop: Live report + shipped engineering fixes',
    chatgpt: 56,
    gemini: 64,
    aio: 54,
  },
];

const servicePillars = [
  {
    num: '01',
    id: 'aeo',
    title: 'AEO',
    subtitle: isEs
      ? 'Estructura clara para que cada respuesta IA cite tus servicios y precios.'
      : 'Make your site machine-readable so answer engines extract exact facts cleanly.',
    items: [
      { label: isEs ? 'Servicios de AEO' : 'AEO Services', href: `${prefix}/services/aeo/` },
      { label: 'ChatGPT SEO', href: `${prefix}/services/chatgpt-seo/` },
      { label: 'Google AI Overviews', href: `${prefix}/services/google-ai-overviews/` },
      { label: isEs ? 'llms.txt y Schema JSON-LD' : 'llms.txt & Schema Setup', href: `${prefix}/services/llms-txt-schema/` },
      { label: isEs ? 'Done-For-You Fix Sprint ($499)' : 'Done-For-You Fix Sprint ($499)', href: `${prefix}/pricing/#sprints` },
    ],
  },
  {
    num: '02',
    id: 'geo',
    title: 'GEO',
    subtitle: isEs
      ? 'Medición semanal y citas externas en ChatGPT, Gemini y Perplexity.'
      : 'Measure and grow how often ChatGPT, Gemini & Perplexity recommend you.',
    items: [
      { label: isEs ? 'Servicios de GEO' : 'GEO Services', href: `${prefix}/services/geo/` },
      { label: 'Perplexity & Gemini', href: `${prefix}/services/perplexity-gemini/` },
      { label: isEs ? 'Construcción de Citas IA' : 'AI Citation Building', href: `${prefix}/services/citation-building/` },
      { label: isEs ? 'Ver Reporte de Ejemplo' : 'Sample Monthly Reporting', href: `${prefix}/sample-report/` },
    ],
  },
  {
    num: '03',
    id: 'reputation',
    title: isEs ? 'Reputación' : 'Reputation',
    subtitle: isEs
      ? 'Alineación oficial en OpenAI Hub, Bing AI, Apple y reseñas de clientes.'
      : 'Sync OpenAI Business Hub, Bing AI, Apple Business & verified reviews.',
    items: [
      { label: isEs ? 'Reputación IA y Directorios' : 'AI Reputation & Citations', href: `${prefix}/services/citation-building/` },
      { label: 'OpenAI Business Hub & ChatGPT', href: `${prefix}/services/chatgpt-seo/` },
      { label: 'Google Business & AI Overviews', href: `${prefix}/services/google-ai-overviews/` },
      { label: isEs ? 'AI Listings Sprint ($249)' : 'AI Listings Sprint ($249)', href: `${prefix}/pricing/#sprints` },
    ],
  },
  {
    num: '04',
    id: 'websites',
    title: isEs ? 'Sitios Web' : 'Websites',
    subtitle: isEs
      ? 'Sitios rápidos (95+ Lighthouse) optimizados para IA desde $390.'
      : 'Fast 95+ Lighthouse answer-ready websites built from $390.',
    items: [
      { label: isEs ? 'Sitios Web (desde $390)' : 'Answer-Ready Websites (from $390)', href: `${prefix}/services/websites/` },
      { label: isEs ? 'Website Quick Fix ($390)' : 'Website Quick Fix ($390)', href: `${prefix}/pricing/#websites` },
      { label: isEs ? 'Sitios de 5 págs ($690) y 10 págs ($1,190)' : '5-Page ($690) & 10-Page ($1,190) Builds', href: `${prefix}/pricing/#websites` },
      { label: isEs ? 'llms.txt, Schema y Datos JSON-LD' : 'Entity Schema & llms.txt', href: `${prefix}/services/llms-txt-schema/` },
    ],
  },
];

const faqs = [
  {
    q: isEs ? '¿Qué es la visibilidad en IA?' : 'What is AI visibility?',
    a: isEs
      ? 'Mide con qué frecuencia y precisión ChatGPT, Gemini y Google AI nombran y recomiendan tu empresa cuando un comprador hace una pregunta sin nombrar tu marca.'
      : 'It measures how often—and how accurately—ChatGPT, Gemini, and Google AI mention and recommend your business when buyers ask unbranded questions.',
  },
  {
    q: isEs ? '¿Qué incluye el chequeo gratis vs. la auditoría de $99?' : 'What is included in the free check vs. the $99 audit?',
    a: isEs
      ? 'El chequeo gratis evalúa acceso de bots IA, schema JSON-LD, fichas oficiales y 3 preguntas de compra para detectar brechas. La auditoría de $99 corre 15 preguntas × 3 veces en 4 motores (180 chequeos), mapea 3 competidores y entrega la hoja completa de fixes (abonable al Mes 1).'
      : 'The free check inspects your AI bot access, entity & FAQ schema, official AI hubs, and 3 sample questions to flag blockers. The $99 Audit runs 15 questions × 3 times across 4 engines (180 checks), maps 3 competitors, and unlocks the full fix roadmap (credited toward Month 1).',
  },
  {
    q: isEs ? '¿También diseñan sitios web optimizados para IA?' : 'Do you build websites too, or only optimize existing ones?',
    a: isEs
      ? 'Ambos: mejoramos tu web actual con Quick Fix ($390) o construimos un sitio nuevo optimizado para IA de 5 páginas ($690) o 10 páginas ($1,190).'
      : 'Both. Upgrade your current site with Website Quick Fix ($390), or order a brand-new fast 5-page ($690) or 10-page ($1,190) website built answer-ready from scratch.',
  },
  {
    q: isEs ? '¿Cómo funciona la garantía del Mes 4 gratis?' : 'How does your accountability guarantee work?',
    a: isEs
      ? 'Sin contratos anuales forzados (cancelas con 30 días de aviso). Si tras 3 meses continuos de Watch tu visibilidad no mejora en tus prompts fijos, el Mes 4 es gratis.'
      : 'No annual lock-in (30 days’ notice anytime). If your frozen prompt visibility hasn’t improved after 3 consecutive months on Watch, Month 4 is completely free.',
  },
  {
    q: isEs ? '¿Cuánto tarda en verse el impacto?' : 'How long does it take to see results?',
    a: isEs
      ? 'Mejoras de crawlers, JSON-LD y OpenAI/Bing Hubs suelen verse en 2 a 4 semanas; páginas nuevas y citas externas consolidan crecimiento entre los meses 1 y 3.'
      : 'Technical schema and OpenAI/Bing hub updates often move the needle within 2–4 weeks; new answer-ready pages and citations compound across months 1–3.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<WatchShell
  title={isEs ? 'Sondri Watch — Visibilidad IA y Sitios Web | watch.sondri.ai' : 'Sondri Watch — Get Found When Buyers Ask AI | watch.sondri.ai'}
  description={isEs
    ? 'Revisa gratis cómo ChatGPT, Gemini y Google AI describen tu negocio. Auditoría $99, Webs desde $390 y planes Watch desde $149/mes.'
    : 'Free 60-second AI visibility & readiness check across ChatGPT, Gemini, and Google AI. $99 full audit, websites from $390, monthly plans from $149/mo.'}
  lang={lang}
  activeTab="overview"
  alternates={alternates}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Floating Sticky Chapter Rail (Desktop) -->
  <nav class="chapter-rail" aria-label={isEs ? 'Capítulos' : 'Story chapters'}>
    {chapters.map((c, idx) => (
      <a
        href={`#${c.id}`}
        class:list={['rail-item', idx === 0 && 'is-active']}
        data-chapter-link={c.id}
        data-chapter-title={`${c.num} · ${c.title}`}
      >
        <span class="label rail-num">{c.num}</span>
        <span class="rail-label">{c.title}</span>
      </a>
    ))}
  </nav>

  <!-- CHAPTER 01 · SPACIOUS HERO + PLAIN-ENGLISH 3-STEP SVG + DUAL-CORE TELEMETRY CARD -->
  <section class="section section-pad on-dark hero-watch" id="act-shift">
    <div class="wrap">
      <div class="hero-split">
        <div class="hero-copy" data-watch-reveal>
          <div class="hero-eyebrow">
            <span class="label gold-pill">
              {isEs ? 'SONDRI WATCH · VISIBILIDAD IA Y SITIOS WEB' : 'SONDRI WATCH · AI VISIBILITY & WEBSITES'}
            </span>
            <span class="label muted-mono">
              ChatGPT · Gemini · Google AI
            </span>
          </div>

          <h1 class="h1 watch-h1">
            {isEs ? (
              <>Aparece cuando <em class="serif-em">preguntan a la IA.</em></>
            ) : (
              <>Get found <em class="serif-em">when buyers ask AI.</em></>
            )}
          </h1>
          <p class="lede hero-lede">
            {isEs
              ? 'Comprobamos cómo ChatGPT, Gemini y Google AI responden a tus compradores—y desplegamos las mejoras para que te recomienden.'
              : 'We check how ChatGPT, Gemini, and Google AI answer your buyers’ real questions—and ship the fixes that get you recommended.'}
          </p>

          <div class="hero-ctas">
            <a class="btn btn-gold" href="#free-check">
              {isEs ? 'Probar mi Sitio Gratis' : 'Check My Website Free'} <span class="arr">→</span>
            </a>
            <a class="btn btn-outline-light" href={`${prefix}/pricing/`}>
              {isEs ? 'Planes y Sitios Web' : 'See Plans & Websites'}
            </a>
            <a class="label hero-sample-link" href={`${prefix}/sample-report/`}>
              {isEs ? 'Ver reporte de ejemplo →' : 'See sample report →'}
            </a>
          </div>

          <!-- Spacious Plain-English 3-Step Flow (HTML Nodes + Animated Connectors, Zero Text Clipping) -->
          <div class="hero-steps-flow" aria-hidden="true">
            <div class="hs-node">
              <span class="label hs-kicker">{isEs ? '01 · CLIENTE PREGUNTA' : '01 · BUYER ASKS AI'}</span>
              <span class="hs-sub">{isEs ? '“¿A quién contratar?”' : '“Who is best in town?”'}</span>
            </div>

            <div class="hs-conn"><span class="hs-dot"></span></div>

            <div class="hs-node is-mid">
              <span class="label hs-kicker">{isEs ? '02 · TEST EN 4 MOTORES' : '02 · WE TEST 4 ENGINES'}</span>
              <span class="hs-sub">ChatGPT, Gemini &amp; Google</span>
            </div>

            <div class="hs-conn"><span class="hs-dot is-delay"></span></div>

            <div class="hs-node is-end">
              <span class="label hs-kicker">{isEs ? '03 · SALES ELEGIDO' : '03 · YOU GET FOUND'}</span>
              <span class="hs-sub">{isEs ? 'Score + fixes publicados' : 'Score + shipped fixes'}</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Auto-Cycling Live Buyer Question & 4-Engine AI Verdict Card (NO Page Speed Bar) -->
        <div class="telemetry-card" id="heroVerdictCard" data-watch-reveal>
          <div class="tel-head">
            <span class="label tel-kicker">{isEs ? 'QUÉ MUESTRA TU AUDITORÍA GRATIS' : 'WHAT THE FREE AUDIT REVEALS'}</span>
            <span class="label muted-mono">{isEs ? '6 industrias · 3 preguntas' : '3 live prompts · 4 engines'}</span>
          </div>

          <div class="tel-pills" role="tablist" aria-label={isEs ? 'Elegir industria' : 'Choose industry'}>
            {industries.map((ind, idx) => (
              <button
                type="button"
                role="tab"
                class:list={['sc-tab', 'label', idx === 0 && 'is-active']}
                data-tel-btn={ind.id}
                data-tel-score={String(ind.score)}
                data-tel-service={ind.servicePrefill}
                aria-selected={idx === 0 ? 'true' : 'false'}
              >
                {ind.label}
              </button>
            ))}
          </div>

          {industries.map((ind, iIdx) => (
            <div class="ind-stage" data-tel-pane={ind.id} style={iIdx === 0 ? '' : 'display: none;'}>
              <!-- Q1 / Q2 / Q3 Interactive + Auto-Cycling Tabs -->
              <div class="q-cycle-tabs" role="tablist" aria-label="Sample buyer questions">
                {ind.questions.map((qObj, qIdx) => (
                  <button
                    type="button"
                    role="tab"
                    class:list={['qc-tab', 'label', qIdx === 0 && 'is-active']}
                    data-qc-tab={String(qIdx)}
                    aria-selected={qIdx === 0 ? 'true' : 'false'}
                  >
                    <span>{qObj.tab}</span>
                    <span class="qc-progress" aria-hidden="true"><span></span></span>
                  </button>
                ))}
              </div>

              <!-- Active Single Question Spotlight + 4-Engine Verdict Grid -->
              {ind.questions.map((qObj, qIdx) => (
                <div class="q-spotlight" data-qc-pane={String(qIdx)} style={qIdx === 0 ? '' : 'display: none;'}>
                  <p class="qs-prompt">{qObj.prompt}</p>
                  <div class="eng-verdict-grid">
                    {qObj.engines.map((eng) => (
                      <div class="ev-cell">
                        <span class="label ev-name">{eng.name}</span>
                        <span class:list={['label', 'pill-tag', eng.state === 'miss' ? 'is-miss' : eng.state === 'warn' ? 'is-warn' : 'is-ok']}>
                          {eng.val}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}

              <!-- AI Readiness Score Ring + Tech Entity Signals Strip (No Page Speed) -->
              <div class="ring-row">
                <div class="ring-wrap" aria-hidden="true">
                  <svg viewBox="0 0 84 84" class="score-ring-svg">
                    <circle cx="42" cy="42" r="34" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="6" />
                    <circle
                      class="hero-ring-arc"
                      cx="42"
                      cy="42"
                      r="34"
                      fill="none"
                      stroke="#fdb343"
                      stroke-width="6"
                      stroke-linecap="round"
                      stroke-dasharray="213.6"
                      style={`stroke-dashoffset: ${(213.6 - (ind.score / 100) * 213.6).toFixed(1)};`}
                      transform="rotate(-90 42 42)"
                    />
                  </svg>
                  <span class="ring-val">{ind.score}</span>
                </div>

                <div class="checks-strip">
                  {ind.checks.map((chk) => (
                    <div class="chk-mini">
                      <span class="chk-name">{chk.label}</span>
                      <span class:list={['label', 'pill-tag', chk.state === 'miss' ? 'is-miss' : chk.state === 'warn' ? 'is-warn' : 'is-ok']}>
                        {chk.val}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}

          <div class="tel-foot">
            <span class="label lock-txt">
              {isEs ? '🔒 Gratis diagnostica brechas · Pagos publican los fixes' : '🔒 Free check flags gaps · Paid plans ship fixes'}
            </span>
            <button type="button" class="label jump-check-btn" id="heroRunOwnBtn">
              {isEs ? 'Probar con mi sitio ↓' : 'Test my own site free ↓'}
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 02 · LIVE 60-SECOND FREE SCANNER -->
  <div id="free-check-wrap">
    <MiniAudit defaultLang={lang} embedded={true} />
  </div>

  <!-- CHAPTER 03 · 4-CARD OFFER PATH STRIP + "A SHORT REPORT YOU CAN ACT ON." (on-paper) -->
  <section class="section section-pad on-paper" id="act-offer">
    <div class="wrap">
      <div class="offer-strip-4" data-watch-reveal>
        {offerStrip.map((item) => (
          <a href={item.href} class="strip-card">
            <span class="label strip-kicker">{item.kicker}</span>
            <p class="strip-price">{item.price}</p>
            <p class="body-s strip-desc">{item.desc}</p>
          </a>
        ))}
      </div>

      <div class="bento-head" data-watch-reveal>
        <span class="label dot-kicker"><span class="dot-gold" aria-hidden="true"></span> {isEs ? 'QUÉ OBTIENES' : 'WHAT YOU GET'}</span>
        <h2 class="h2 bento-h2">
          {isEs ? (
            <>Un reporte corto <em class="serif-em">para actuar hoy.</em></>
          ) : (
            <>A short report <em class="serif-em">you can act on.</em></>
          )}
        </h2>
      </div>

      <div class="bento-2x2">
        {reportCards.map((card) => (
          <article class="bento-card" data-bento-card>
            <div class="icon-badge" aria-hidden="true">
              {card.icon === 'question' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                  <path d="M12 17h.01" />
                </svg>
              )}
              {card.icon === 'eye' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              )}
              {card.icon === 'pin' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              )}
              {card.icon === 'bolt' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                </svg>
              )}
            </div>
            <h3 class="h5">{card.title}</h3>
            <p class="body-s bento-copy">{card.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CHAPTER 04 · HOW IT WORKS + ARCHITECTURAL BLUEPRINT SVG (on-off) -->
  <section class="section section-pad on-off" id="act-loop">
    <div class="wrap">
      <div class="sec-head" data-watch-reveal>
        <div>
          <span class="label dot-kicker"><span class="dot-gold" aria-hidden="true"></span> {isEs ? 'CÓMO FUNCIONA' : 'HOW IT WORKS'}</span>
          <h2 class="h2">
            {isEs ? (
              <>Medir. Corregir. <em class="serif-em">Fortalecer. Seguir.</em></>
            ) : (
              <>Check. Fix. <em class="serif-em">Strengthen. Measure.</em></>
            )}
          </h2>
        </div>
        <div class="intro">
          <p class="lede">
            {isEs
              ? 'La IA actualiza respuestas cada semana. Haz clic en cada fase para ver cómo construimos visibilidad duradera.'
              : 'AI answers shift weekly. Step through each phase to see how we build lasting visibility.'}
          </p>
        </div>
      </div>

      <div class="loop-split" data-watch-reveal>
        <div class="loop-controls">
          <div class="phase-tabs" role="tablist" aria-label={isEs ? 'Fases' : 'Visibility phases'}>
            {phases.map((ph, i) => (
              <button
                type="button"
                role="tab"
                class:list={['phase-tab', i === 0 && 'is-active']}
                data-phase-btn={String(i)}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                <span class="label phase-tab-lbl">{ph.tab}</span>
                <strong class="phase-tab-pct">{ph.share}%</strong>
              </button>
            ))}
          </div>

          {phases.map((ph, i) => (
            <div class="phase-pane" data-phase-pane={String(i)} style={i === 0 ? '' : 'display: none;'}>
              <span class="label phase-num-tag">{ph.metricLabel}</span>
              <h3 class="h4 phase-title">{ph.num} · {ph.name}</h3>
              <p class="body-s phase-summary">{ph.summary}</p>
              <p class="label phase-deliv">■ {ph.deliverable}</p>

              <div class="mini-engines">
                <div class="m-eng">
                  <div class="m-eng-top"><span class="label">ChatGPT</span><span class="label">{ph.chatgpt}%</span></div>
                  <div class="m-track"><div class="m-fill" style={`width: ${ph.chatgpt}%`}></div></div>
                </div>
                <div class="m-eng">
                  <div class="m-eng-top"><span class="label">Gemini</span><span class="label">{ph.gemini}%</span></div>
                  <div class="m-track"><div class="m-fill" style={`width: ${ph.gemini}%`}></div></div>
                </div>
                <div class="m-eng">
                  <div class="m-eng-top"><span class="label">Google AI</span><span class="label">{ph.aio}%</span></div>
                  <div class="m-track"><div class="m-fill" style={`width: ${ph.aio}%`}></div></div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="blueprint-stage" data-active-phase="0" id="blueprintStage">
          <div class="bp-top-bar">
            <span class="label bp-tag">AI VISIBILITY ARCHITECTURE · SONDRI WATCH</span>
            <span class="label bp-kpi" id="bpKpiLabel">STAGE 01 / 04 · 14% SHARE</span>
          </div>

          <svg viewBox="0 0 460 300" class="bp-svg" role="img" aria-label="Progressive 4-layer AI visibility architecture">
            <defs>
              <pattern id="bpGridMinor" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="0.8" />
              </pattern>
              <pattern id="bpGridMajor" width="80" height="80" patternUnits="userSpaceOnUse">
                <rect width="80" height="80" fill="url(#bpGridMinor)" />
                <path d="M 80 0 L 0 0 0 80" fill="none" stroke="rgba(253,179,67,0.10)" stroke-width="1" />
              </pattern>
            </defs>

            <rect width="460" height="300" fill="#061919" />
            <rect width="460" height="300" fill="url(#bpGridMajor)" />

            <path d="M 60 52 C 155 48, 255 36, 404 20" stroke="rgba(95,196,188,0.34)" stroke-width="1.5" stroke-dasharray="4 4" fill="none" />
            <circle cx="84" cy="51" r="4" class="curve-node" data-curve-idx="0" />
            <circle cx="192" cy="43" r="4" class="curve-node" data-curve-idx="1" />
            <circle cx="300" cy="31" r="4" class="curve-node" data-curve-idx="2" />
            <circle cx="404" cy="20" r="5" class="curve-node" data-curve-idx="3" />

            <g class="bp-layer" data-bp-layer="3">
              <polygon points="154,66 306,66 388,124 72,124" class="bp-box" />
              <rect x="193" y="75" width="74" height="17" rx="8.5" class="bp-accent-circle" />
              <text x="230" y="86.5" text-anchor="middle" class="bp-mono" font-size="8.5">04 WATCH</text>
              <text x="230" y="111" text-anchor="middle" class="bp-text" font-size="10">Weekly Drift Loop + Monthly Shipped Fix</text>
            </g>

            <g class="bp-layer" data-bp-layer="2">
              <rect x="86" y="132" width="136" height="44" class="bp-box" />
              <text x="154" y="150" text-anchor="middle" class="bp-mono" font-size="8.5">03 ANSWER PAGES</text>
              <text x="154" y="165" text-anchor="middle" class="bp-text" font-size="10">FAQ &amp; Service Proof</text>

              <rect x="238" y="132" width="136" height="44" class="bp-box" />
              <text x="306" y="150" text-anchor="middle" class="bp-mono" font-size="8.5">03 CITATIONS</text>
              <text x="306" y="165" text-anchor="middle" class="bp-text" font-size="10">Trusted Directories</text>
            </g>

            <g class="bp-layer" data-bp-layer="1">
