    r2: isEs ? '⚠ Datos antiguos' : '⚠ Outdated info',
    s2: 'warn',
    q3: isEs ? 'P3 · ¿Qué dicen de tu marca?' : 'Q3 · Direct brand check?',
    r3: isEs ? '✓ Perfil desactualizado' : '✓ Old listing only',
    s3: 'ok',
  },
  {
    id: 'b2b',
    label: isEs ? 'Legal y B2B' : 'Legal & B2B',
    servicePrefill: isEs ? 'Estudio jurídico o software B2B' : 'Law firm or B2B software',
    score: 36,
    speed: 74,
    botsLabel: isEs ? '⚠ Restringido' : '⚠ Throttled',
    schemaLabel: isEs ? '✗ Incompleto' : '✗ Incomplete',
    q1: isEs ? 'P1 · ¿Firma recomendada?' : 'Q1 · Top firm asked?',
    r1: isEs ? '✗ Omitida (5 firmas)' : '✗ Skipped (5 rivals)',
    s1: 'miss',
    q2: isEs ? 'P2 · ¿Especialidad clave?' : 'Q2 · Specialty niche?',
    r2: isEs ? '✗ Sin página dedicada' : '✗ No dedicated page',
    s2: 'miss',
    q3: isEs ? 'P3 · ¿Socios y trayectoria?' : 'Q3 · Brand accuracy?',
    r3: isEs ? '⚠ Bios incompletas' : '⚠ Thin proof cited',
    s3: 'warn',
  },
  {
    id: 'ecom',
    label: 'Ecommerce',
    servicePrefill: isEs ? 'Tienda online y productos' : 'Ecommerce & Shopify store',
    score: 48,
    speed: 91,
    botsLabel: isEs ? '✓ Permitidos' : '✓ Allowed',
    schemaLabel: isEs ? '⚠ Sin Offer/ACP' : '⚠ Missing Offer',
    q1: isEs ? 'P1 · ¿Mejor bajo $250?' : 'Q1 · Top pick under $250?',
    r1: isEs ? '✗ Fuera del carrusel' : '✗ Excluded by agents',
    s1: 'miss',
    q2: isEs ? 'P2 · ¿Envío y cambios?' : 'Q2 · Returns & shipping?',
    r2: isEs ? '⚠ Política ilegible' : '⚠ Policy unreadable',
    s2: 'warn',
    q3: isEs ? 'P3 · ¿Opiniones verificadas?' : 'Q3 · Verified reviews?',
    r3: isEs ? '✓ 4.7 en terceros' : '✓ External reviews ok',
    s3: 'ok',
  },
];

const offerStrip = [
  {
    kicker: isEs ? 'CHEQUEO GRATIS' : 'FREE CHECK',
    price: '$0',
    desc: isEs
      ? 'Velocidad web + 3 preguntas en vivo en 60 seg.'
      : 'Page speed check + 3 live buyer answers in 60s.',
    href: '#free-check',
  },
  {
    kicker: isEs ? 'AUDITORÍA' : 'FULL AUDIT',
    price: isEs ? '$99 único' : '$99 one-time',
    desc: isEs
      ? '15 preguntas × 3 corridas, rivales y plan de fixes.'
      : '15 questions × 3 runs, 3 rivals & full fix list.',
    href: `${prefix}/pricing/#audit`,
  },
  {
    kicker: isEs ? 'VISIBILIDAD IA' : 'AI VISIBILITY',
    price: isEs ? 'desde $149/mes' : 'from $149/mo',
    desc: isEs
      ? 'Monitoreo semanal + mejoras mensuales llave en mano.'
      : 'Weekly tracking + done-for-you fixes shipped monthly.',
    href: `${prefix}/pricing/#monthly`,
  },
  {
    kicker: isEs ? 'SITIOS WEB' : 'WEBSITES',
    price: isEs ? 'desde $390' : 'from $390',
    desc: isEs
      ? 'Quick Fix $390 · 5 págs $690 · 10 págs $1,190.'
      : 'Quick Fix $390 · 5 pages $690 · 10 pages $1,190.',
    href: `${prefix}/services/websites/`,
  },
];

const reportCards = [
  {
    icon: 'question',
    title: isEs ? 'Preguntas reales de compra' : 'Real buyer questions',
    desc: isEs ? 'Lo que clientes reales preguntan sobre tu especialidad.' : 'Exact prompts buyers ask AI in your market.',
  },
  {
    icon: 'eye',
    title: isEs ? 'Cómo te describe la IA' : 'How AI describes you',
    desc: isEs ? 'Si te recomiendan o qué competidores ocupan tu lugar.' : 'Whether you are named, skipped, or misquoted.',
  },
  {
    icon: 'pin',
    title: isEs ? 'Salud web y fuentes citadas' : 'Page speed & cited sources',
    desc: isEs ? 'Lighthouse móvil, crawlers y directorios que la IA lee.' : 'Core Web Vitals, bot access & trusted directories.',
  },
  {
    icon: 'bolt',
    title: isEs ? 'Brechas gratis · Fixes en Auditoría ($99)' : 'Gaps flagged free · Fixes in $99 Audit',
    desc: isEs ? 'Detectamos bloqueos gratis; desbloqueas el roadmap al escalar.' : 'Free scan finds blockers; paid plans ship every fix.',
  },
];

const phases = [
  {
    num: '01',
    id: 'check',
    tab: isEs ? '01 Medir' : '01 Check',
    name: isEs ? 'Línea Base en 4 Motores' : 'Baseline Across 4 Engines',
    share: 14,
    metricLabel: isEs ? 'Cuota inicial promedio' : 'Typical baseline named-share',
    summary: isEs
      ? 'Fijamos 25 a 75 preguntas reales sin marca, las corremos sin sesión y auditamos bots, velocidad y schema.'
      : 'We lock 25–75 buyer questions, run them logged out across ChatGPT, Gemini & Google AI, and audit crawlers + schema.',
    deliverable: isEs ? 'Score 0–100 + Hoja de ruta en 48 h' : 'Deliverable: Live baseline score + fix roadmap in 48h',
    chatgpt: 12,
    gemini: 18,
    aio: 11,
  },
  {
    num: '02',
    id: 'fix',
    tab: isEs ? '02 Corregir' : '02 Fix',
    name: isEs ? 'Schema, Bots y Perfiles IA' : 'Schema, Crawlers & Official Hubs',
    share: 29,
    metricLabel: isEs ? 'Tras Fix #1 en semana 2' : 'After Week 2 foundation fixes',
    summary: isEs
      ? 'Desplegamos JSON-LD válido, habilitamos crawlers IA y sincronizamos OpenAI Hub, Bing AI, Apple y Google.'
      : 'Engineers ship validated JSON-LD, clean robots/llms rules, and sync OpenAI Hub, Bing AI, Apple & GBP.',
    deliverable: isEs ? 'Identidad verificada en perfiles oficiales' : 'Shipped fix: Verified entity identity across AI hubs',
    chatgpt: 28,
    gemini: 34,
    aio: 25,
  },
  {
    num: '03',
    id: 'strengthen',
    tab: isEs ? '03 Fortalecer' : '03 Strengthen',
    name: isEs ? 'Páginas Citables y Autoridad' : 'Answer Pages & Citations',
    share: 46,
    metricLabel: isEs ? 'Tras contenido y citas clave' : 'After answer-ready page updates',
    summary: isEs
      ? 'Publicamos páginas claras por servicio y cerramos las brechas de directorios que ya citan a tu competencia.'
      : 'We ship crisp service & FAQ pages built to be quoted verbatim and close competitor directory gaps.',
    deliverable: isEs ? 'Bloques FAQ + Comparativas citables' : 'Shipped fix: Citation clusters + answer-ready pages',
    chatgpt: 44,
    gemini: 52,
    aio: 42,
  },
  {
    num: '04',
    id: 'measure',
    tab: isEs ? '04 Seguir' : '04 Measure',
    name: isEs ? 'Rastreo Semanal + Mejora Mensual' : 'Weekly Drift Watch + Monthly Fixes',
    share: 58,
    metricLabel: isEs ? 'Visibilidad acumulada mensual' : 'Compounded named-share curve',
    summary: isEs
      ? 'Cada semana detectamos cambios de modelo. Cada mes recibes reporte vivo + PDF y nuevas mejoras publicadas.'
      : 'Weekly runs catch model shifts early. Every month brings a live Page + PDF diff report and fresh shipped fixes.',
    deliverable: isEs ? 'Reporte mensual + fixes continuos' : 'Monthly loop: Live report + shipped engineering fixes',
    chatgpt: 56,
    gemini: 64,
    aio: 54,
  },
];

const servicePillars = [
  {
    num: '01',
    id: 'aeo',
    title: 'AEO',
    subtitle: isEs
      ? 'Estructura clara para que cada respuesta IA cite tus servicios y precios.'
      : 'Make your site machine-readable so answer engines extract exact facts cleanly.',
    items: [
      { label: isEs ? 'Servicios de AEO' : 'AEO Services', href: `${prefix}/services/aeo/` },
      { label: 'ChatGPT SEO', href: `${prefix}/services/chatgpt-seo/` },
      { label: 'Google AI Overviews', href: `${prefix}/services/google-ai-overviews/` },
      { label: isEs ? 'llms.txt y Schema JSON-LD' : 'llms.txt & Schema Setup', href: `${prefix}/services/llms-txt-schema/` },
    ],
  },
  {
    num: '02',
    id: 'geo',
    title: 'GEO',
    subtitle: isEs
      ? 'Medición semanal y citas externas en ChatGPT, Gemini y Perplexity.'
      : 'Measure and grow how often ChatGPT, Gemini & Perplexity recommend you.',
    items: [
      { label: isEs ? 'Servicios de GEO' : 'GEO Services', href: `${prefix}/services/geo/` },
      { label: 'Perplexity & Gemini', href: `${prefix}/services/perplexity-gemini/` },
      { label: isEs ? 'Construcción de Citas IA' : 'AI Citation Building', href: `${prefix}/services/citation-building/` },
      { label: isEs ? 'Ver Reporte de Ejemplo' : 'Sample Monthly Reporting', href: `${prefix}/sample-report/` },
    ],
  },
  {
    num: '03',
    id: 'reputation',
    title: isEs ? 'Reputación' : 'Reputation',
    subtitle: isEs
      ? 'Alineación oficial en OpenAI Hub, Bing AI, Apple y reseñas de clientes.'
      : 'Sync OpenAI Business Hub, Bing AI, Apple Business & verified reviews.',
    items: [
      { label: isEs ? 'Reputación IA y Directorios' : 'AI Reputation & Citations', href: `${prefix}/services/citation-building/` },
      { label: 'OpenAI Business Hub & ChatGPT', href: `${prefix}/services/chatgpt-seo/` },
      { label: 'Google Business & AI Overviews', href: `${prefix}/services/google-ai-overviews/` },
      { label: isEs ? 'AI Listings Sprint ($249)' : 'AI Listings Sprint ($249)', href: `${prefix}/pricing/#sprints` },
    ],
  },
  {
    num: '04',
    id: 'websites',
    title: isEs ? 'Sitios Web' : 'Websites',
    subtitle: isEs
      ? 'Sitios rápidos (95+ Lighthouse) optimizados para IA desde $390.'
      : 'Fast 95+ Lighthouse answer-ready websites built from $390.',
    items: [
      { label: isEs ? 'Sitios Web (desde $390)' : 'Answer-Ready Websites (from $390)', href: `${prefix}/services/websites/` },
      { label: isEs ? 'Website Quick Fix ($390)' : 'Website Quick Fix ($390)', href: `${prefix}/pricing/#websites` },
      { label: isEs ? 'Sitios de 5 págs ($690) y 10 págs ($1,190)' : '5-Page ($690) & 10-Page ($1,190) Builds', href: `${prefix}/pricing/#websites` },
      { label: isEs ? 'llms.txt, Schema y Velocidad' : 'Speed, Schema & llms.txt', href: `${prefix}/services/llms-txt-schema/` },
    ],
  },
];

const faqs = [
  {
    q: isEs ? '¿Qué es la visibilidad en IA?' : 'What is AI visibility?',
    a: isEs
      ? 'Mide con qué frecuencia y precisión ChatGPT, Gemini y Google AI nombran y recomiendan tu empresa cuando un comprador hace una pregunta sin nombrar tu marca.'
      : 'It measures how often—and how accurately—ChatGPT, Gemini, and Google AI mention and recommend your business when buyers ask unbranded questions.',
  },
  {
    q: isEs ? '¿Qué incluye el chequeo gratis vs. la auditoría de $99?' : 'What is included in the free check vs. the $99 audit?',
    a: isEs
      ? 'El chequeo gratis evalúa velocidad web, bots/schema y 3 preguntas para detectar brechas. La auditoría de $99 corre 15 preguntas × 3 veces en 4 motores (180 chequeos), mapea 3 competidores y entrega la hoja completa de fixes (abonable al Mes 1).'
      : 'The free check scores your page speed, AI bot access, schema, and 3 sample questions to flag blockers. The $99 Audit runs 15 questions × 3 times across 4 engines (180 checks), maps 3 competitors, and unlocks the full fix roadmap (credited toward Month 1).',
  },
  {
    q: isEs ? '¿También diseñan sitios web optimizados para IA?' : 'Do you build websites too, or only optimize existing ones?',
    a: isEs
      ? 'Ambos: mejoramos tu web actual con Quick Fix ($390) o construimos un sitio nuevo optimizado para IA de 5 páginas ($690) o 10 páginas ($1,190).'
      : 'Both. Upgrade your current site with Website Quick Fix ($390), or order a brand-new fast 5-page ($690) or 10-page ($1,190) website built answer-ready from scratch.',
  },
  {
    q: isEs ? '¿Cómo funciona la garantía del Mes 4 gratis?' : 'How does your accountability guarantee work?',
    a: isEs
      ? 'Sin contratos anuales forzados (cancelas con 30 días de aviso). Si tras 3 meses continuos de Watch tu visibilidad no mejora en tus prompts fijos, el Mes 4 es gratis.'
      : 'No annual lock-in (30 days’ notice anytime). If your frozen prompt visibility hasn’t improved after 3 consecutive months on Watch, Month 4 is completely free.',
  },
  {
    q: isEs ? '¿Cuánto tarda en verse el impacto?' : 'How long does it take to see results?',
    a: isEs
      ? 'Mejoras de crawlers, JSON-LD y OpenAI/Bing Hubs suelen verse en 2 a 4 semanas; páginas nuevas y citas externas consolidan crecimiento entre los meses 1 y 3.'
      : 'Technical schema and OpenAI/Bing hub updates often move the needle within 2–4 weeks; new answer-ready pages and citations compound across months 1–3.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<WatchShell
  title={isEs ? 'Sondri Watch — Visibilidad IA y Sitios Web | watch.sondri.ai' : 'Sondri Watch — Get Found When Buyers Ask AI | watch.sondri.ai'}
  description={isEs
    ? 'Revisa gratis tu velocidad web y cómo ChatGPT, Gemini y Google AI describen tu negocio. Auditoría $99, Webs desde $390 y planes Watch desde $149/mes.'
    : 'Free 60-second page speed & AI visibility check across ChatGPT, Gemini, and Google AI. $99 full audit, websites from $390, monthly plans from $149/mo.'}
  lang={lang}
  activeTab="overview"
  alternates={alternates}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Floating Sticky Chapter Rail (Desktop) -->
  <nav class="chapter-rail" aria-label={isEs ? 'Capítulos' : 'Story chapters'}>
    {chapters.map((c, idx) => (
      <a
        href={`#${c.id}`}
        class:list={['rail-item', idx === 0 && 'is-active']}
        data-chapter-link={c.id}
        data-chapter-title={`${c.num} · ${c.title}`}
      >
        <span class="label rail-num">{c.num}</span>
        <span class="rail-label">{c.title}</span>
      </a>
    ))}
  </nav>

  <!-- CHAPTER 01 · SPACIOUS HERO + PLAIN-ENGLISH 3-STEP SVG + DUAL-CORE TELEMETRY CARD -->
  <section class="section section-pad on-dark hero-watch" id="act-shift">
    <div class="wrap">
      <div class="hero-top-tag">
        <span class="label gold-pill">
          {isEs ? 'SONDRI WATCH · VISIBILIDAD IA Y SITIOS WEB' : 'SONDRI WATCH · AI VISIBILITY & WEBSITES'}
        </span>
        <span class="label muted-mono">
          ChatGPT · Gemini · Google AI
        </span>
      </div>

      <div class="hero-split">
        <div class="hero-copy" data-watch-reveal>
          <h1 class="h1 watch-h1">
            {isEs ? (
              <>Aparece cuando <em class="serif-em">preguntan a la IA.</em></>
            ) : (
              <>Get found <em class="serif-em">when buyers ask AI.</em></>
            )}
          </h1>
          <p class="lede hero-lede">
            {isEs
              ? 'Escaneamos tu web y respuestas en ChatGPT, Gemini y Google AI en 60 segundos—y luego implementamos las mejoras por ti.'
              : 'Audit your website readiness and live AI answers in 60 seconds—then let our engineers build and ship the fixes.'}
          </p>

          <div class="hero-ctas">
            <a class="btn btn-gold" href="#free-check">
              {isEs ? 'Escanear mi Sitio Gratis' : 'Scan My Website Free'} <span class="arr">→</span>
            </a>
            <a class="btn btn-outline-light" href={`${prefix}/pricing/`}>
              {isEs ? 'Precios y Sitios Web' : 'See Pricing & Websites'}
            </a>
          </div>

          <!-- Spacious Plain-English 3-Step Signal Flow -->
          <div class="hero-signal-box" aria-hidden="true">
            <svg viewBox="0 0 510 88" class="hero-flow-svg" fill="none">
              <line x1="79" y1="44" x2="431" y2="44" stroke="rgba(255,255,255,0.22)" stroke-width="1.5" stroke-dasharray="4 4" />
              <circle data-hero-packet cx="74" cy="44" r="4" fill="#fdb343" />
              <circle data-hero-packet cx="170" cy="44" r="3" fill="#5fc4bc" />

              <rect x="2" y="15" width="154" height="58" rx="4" fill="#081f1f" stroke="rgba(255,255,255,0.26)" stroke-width="1.2" />
              <text x="79" y="38" text-anchor="middle" fill="#fdb343" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700">
                {isEs ? '01 · CLIENTE PREGUNTA' : '01 · BUYER ASKS AI'}
              </text>
              <text x="79" y="55" text-anchor="middle" fill="#e5ecea" font-family="IBM Plex Sans, sans-serif" font-size="10.5">
                {isEs ? '“¿A quién contratar?”' : '“Who should I hire?”'}
              </text>

              <rect x="178" y="15" width="154" height="58" rx="4" fill="#0d2a29" stroke="#fdb343" stroke-width="1.3" />
              <text x="255" y="38" text-anchor="middle" fill="#fdb343" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700">
                {isEs ? '02 · AUDITAMOS TODO' : '02 · WE SCAN SITE & AI'}
              </text>
              <text x="255" y="55" text-anchor="middle" fill="#ffffff" font-family="IBM Plex Sans, sans-serif" font-size="10.5">
                {isEs ? 'Web, velocidad e IA' : 'Page, speed & 4 AIs'}
              </text>

              <rect x="354" y="15" width="154" height="58" rx="4" fill="#081f1f" stroke="#5fc4bc" stroke-width="1.3" />
              <text x="431" y="38" text-anchor="middle" fill="#5fc4bc" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700">
                {isEs ? '03 · SALES ELEGIDO' : '03 · YOU GET FOUND'}
              </text>
              <text x="431" y="55" text-anchor="middle" fill="#ffffff" font-family="IBM Plex Sans, sans-serif" font-size="10.5">
                {isEs ? 'Score + fixes reales' : 'Score + shipped fixes'}
              </text>
            </svg>
          </div>
        </div>

        <!-- Right Column: Visual Dual-Core Telemetry Card (Page Audit 45 pts + AI Answers 55 pts) -->
        <div class="telemetry-card" data-watch-reveal>
          <div class="tel-head">
            <span class="label tel-kicker">{isEs ? 'VISTA PREVIA DEL CHEQUEO GRATIS' : 'FREE AUDIT TELEMETRY PREVIEW'}</span>
            <div class="tel-pills" role="tablist" aria-label={isEs ? 'Ejemplo por industria' : 'Industry preview'}>
              {previews.map((pv, idx) => (
                <button
                  type="button"
                  role="tab"
                  class:list={['sc-tab', 'label', idx === 0 && 'is-active']}
                  data-tel-btn={pv.id}
                  data-tel-score={String(pv.score)}
                  data-tel-service={pv.servicePrefill}
                  aria-selected={idx === 0 ? 'true' : 'false'}
                >
                  {pv.label}
                </button>
              ))}
            </div>
          </div>

          <!-- Score Ring Header -->
          <div class="ring-row">
            <div class="ring-wrap" aria-hidden="true">
              <svg viewBox="0 0 84 84" class="score-ring-svg">
                <circle cx="42" cy="42" r="34" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="6" />
                <circle
                  id="heroRingArc"
                  cx="42"
                  cy="42"
                  r="34"
                  fill="none"
                  stroke="#fdb343"
                  stroke-width="6"
                  stroke-linecap="round"
                  stroke-dasharray="213.6"
                  stroke-dashoffset="123.9"
                  transform="rotate(-90 42 42)"
                />
              </svg>
              <span class="ring-val" id="heroRingNum">42</span>
            </div>
            <div class="ring-meta">
              <p class="ring-title">{isEs ? 'Score Base Combinado (0–100)' : 'Combined Audit Score (0–100)'}</p>
              <p class="body-s ring-sub">
                {isEs
                  ? 'Combina auditoría técnica de página (45 pts) + 3 preguntas reales en IA (55 pts).'
                  : 'Combines live Page & Speed scan (45 pts) + 3 real buyer questions (55 pts).'}
              </p>
            </div>
          </div>

          <!-- Dual Core Visual Panels -->
          {previews.map((pv, idx) => (
            <div class="core-split-2" data-tel-pane={pv.id} style={idx === 0 ? '' : 'display: none;'}>
              <!-- LEFT CORE: PAGE & TECH AUDIT -->
              <div class="core-box">
                <span class="label core-lbl">{isEs ? '01 · AUDITORÍA WEB (45 PTS)' : '01 · PAGE AUDIT (45 PTS)'}</span>
                <div class="metric-row">
                  <div class="m-top">
                    <span>Lighthouse Speed</span>
                    <strong class="label">{pv.speed}/100</strong>
                  </div>
                  <div class="m-bar"><span style={`width: ${pv.speed}%`}></span></div>
                </div>
                <div class="kv-row">
                  <span>{isEs ? 'Bots IA (robots.txt)' : 'AI Crawler Access'}</span>
                  <span class="pill-tag is-teal label">{pv.botsLabel}</span>
                </div>
                <div class="kv-row">
                  <span>Schema &amp; llms.txt</span>
                  <span class="pill-tag is-miss label">{pv.schemaLabel}</span>
                </div>
              </div>

              <!-- RIGHT CORE: 3 LIVE AI QUESTIONS -->
