            <>Found. Trusted. <em class="serif-em">Recommended. Contacted.</em></>
          )}
        </h2>
      </div>

      <div class="pillars-accordion" role="tablist" aria-label={isEs ? 'Pilares de servicio' : 'Service pillars'} data-watch-reveal>
        {servicePillars.map((pillar, idx) => (
          <div
            class:list={['pillar-panel', idx === 0 && 'is-open']}
            data-pillar={pillar.id}
          >
            <button
              type="button"
              class="pillar-trigger"
              data-pillar-btn={pillar.id}
              aria-expanded={idx === 0 ? 'true' : 'false'}
            >
              <span class="pillar-top-num label">
                <span class="dot-gold pillar-dot" aria-hidden="true"></span>
                {pillar.num}
              </span>
              <span class="pillar-vert-title">{pillar.title}</span>
