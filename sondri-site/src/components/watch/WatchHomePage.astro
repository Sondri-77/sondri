            <div class="pillar-content">
              <div class="pillar-header-row">
                <span class="label pillar-active-num">
                  <span class="dot-gold" aria-hidden="true"></span> {pillar.num}
                </span>
                <h3 class="h2 pillar-big-title">{pillar.title}</h3>
                <p class="body-s pillar-sub">{pillar.subtitle}</p>
              </div>
              <ul class="pillar-items">
                {pillar.items.map((srv) => (
                  <li>
                    <a href={srv.href} class="pillar-item-link">
                      <span>{srv.label}</span>
                      <span class="pillar-arr" aria-hidden="true">→</span>
                    </a>
                  </li>
