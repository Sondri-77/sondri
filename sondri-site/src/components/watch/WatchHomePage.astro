              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SPECIALIST SERVICES ONE-BY-ONE GRID (Screenshot 2 -> Links + FAQ Schema pages) -->
  <section class="section section-pad on-paper" id="specialist-services">
    <div class="wrap">
      <div class="bento-head" data-watch-reveal>
        <span class="label dot-kicker"><span class="dot-gold" aria-hidden="true"></span> {isEs ? 'SERVICIOS ESPECIALISTAS' : 'SPECIALIST SERVICES'}</span>
        <h2 class="h2 bento-h2">
          {isEs ? (
            <>Servicios de visibilidad y web, <em class="serif-em">uno por uno.</em></>
          ) : (
            <>AI search services, <em class="serif-em">one by one.</em></>
          )}
        </h2>
        <p class="lede bento-sub">
          {isEs
            ? 'Cada especialidad tiene su página dedicada con entregas exactas y FAQ técnico.'
            : 'Each capability links to its own service breakdown, blueprint, and FAQ schema page.'}
        </p>
      </div>

      <div class="spec-grid-4" data-watch-reveal>
        {servicesList.map((srv) => (
