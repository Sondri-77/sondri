---
import { footerNav, BOOK_HREF, CONTACT_EMAIL, mailto } from '../data';
---

<footer>
  <div class="wrap inner">
    <div class="top two-col">
      <div>
        <div class="pitch display">
          Let&rsquo;s put AI agents to work inside your business.
        </div>
        <a class="btn-primary cta" href={BOOK_HREF}>BOOK A DISCOVERY CALL &nbsp;&rarr;</a>
      </div>

      <div class="terminal">
        <div class="term-bar">
          <span class="term-title">CONTACT.SONDRI</span>
          <span class="term-dots" aria-hidden="true"><span></span><span></span><span class="lit"></span></span>
        </div>
        <div class="term-body">
          <div class="dim">&gt; <a href={mailto('Hello Sondri')}>{CONTACT_EMAIL}</a></div>
          <div class="dim">&gt; sondri.ai</div>
          <div class="line"><a href={mailto('Investor inquiry')}>Investor inquiries</a></div>
          <div class="line2"><a href={mailto('Customer pilot')}>Customer pilots</a></div>
          <div class="line2"><a href={mailto('Founding-team application')}>Founding-team applications</a><span class="cursor">_</span></div>
        </div>
      </div>
    </div>

    <div class="bottom">
      <span class="wordmark">SONDRI</span>
      <div class="links">
        {footerNav.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <span class="fine">CONFIDENTIAL &mdash; SONDRI 2026</span>
    </div>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); background: var(--ink); }
  .inner { padding: 90px var(--pad-x) 40px; }
  .top {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 60px;
    align-items: start;
  }
  .pitch {
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1.05;
    max-width: 18ch;
  }
  .cta { margin-top: 30px; }

  .terminal { border: 1px solid var(--line); }
  .term-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--ink-deep);
  }
  .term-title { font-size: 10px; letter-spacing: 2px; color: var(--clay); }
  .term-dots { display: flex; gap: 5px; }
  .term-dots span { width: 7px; height: 7px; border: 1px solid var(--dim-2); }
  .term-dots .lit { border-color: var(--gold); background: var(--gold); }
  .term-body { padding: 22px 16px; font-size: 12px; line-height: 2.1; color: var(--body-2); }
  .term-body .dim, .term-body .dim a { color: var(--dim); }
  .term-body a:hover { color: var(--gold); }
  .line { margin-top: 14px; }
  .line, .line2, .line a, .line2 a { color: var(--clay); }
  .cursor { animation: blink 1.1s step-end infinite; color: var(--gold); }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 70px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 16px;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 3px;
    color: var(--bone);
  }
  .links { display: flex; gap: 26px; flex-wrap: wrap; }
  .links a { font-size: 10px; letter-spacing: 2px; color: var(--dim); }
  .links a:hover { color: var(--bone); }
  .fine { font-size: 10px; letter-spacing: 2px; color: var(--fineprint); }
</style>
