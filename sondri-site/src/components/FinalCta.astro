---
import { BOOK_HREF, CTA_PRIMARY, RISK_REVERSAL } from '../data';
import { finalCta } from '../home-data';
import { splitDot } from '../lib/dot';
const [h2, dot] = splitDot(finalCta.h2);
---

<!-- The close, on the gold field: its own block ahead of the teal footer
     (captain: the two must not run together). -->
<section class="section on-gold" id="book">
  <div class="wrap cta">
    <div class="eyebrow"><span class="label">/ {finalCta.eyebrow}</span></div>
    <h2 class="h2">{h2}<span class="gdot">{dot}</span></h2>
    <p class="lede">{finalCta.lede}</p>
    <div class="cta-actions">
      <a class="btn btn-gold" href={BOOK_HREF}>{CTA_PRIMARY} <span class="arr">→</span></a>
    </div>
    <p class="label">{RISK_REVERSAL}</p>
  </div>
</section>

<style>
  .cta { padding-block: var(--s-96); display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-32); }
  .cta .eyebrow { margin-bottom: 0; }
  .cta .h2 { max-width: 20ch; }
  .lede { max-width: 48ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: var(--s-16); }
</style>
