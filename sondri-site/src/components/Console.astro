---
import { consolePanels, consoleStrip, featuresHead } from '../home-data';
import { en } from '../i18n';
import { splitDot } from '../lib/dot';
import WorkflowBuilder from './console/WorkflowBuilder.astro';
import AgenticChat from './console/AgenticChat.astro';
import ContractReview from './console/ContractReview.astro';
const [h2, dot] = splitDot(featuresHead.h2);
const anims = { workflow: WorkflowBuilder, chat: AgenticChat, contract: ContractReview } as const;
---

<!-- Capabilities, in Blacksmith's "Console" grammar (captain's ref): one
     framed, halftoned block cut into three panes by vertical rules, each a
     heading, one plain line, and in its lower half a window running one of
     the playground animations (01 workflow builder, 03 agentic chat, 09
     contract review). The windows are paper (captain, 2026-09-21: white, not
     teal): ink frame, teal hard shadow, ink text, gold accents; the panels
     inside read --win-* for the few colours the site has no token for. The
     windows bleed off the pane's right and bottom edges the way theirs do. The six capability verbs sit in a mono strip
     underneath, so the old tiles' list is still on the page. -->
<section class="section section-pad" id="features">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="eyebrow"><span class="label">/ <span data-i18n="featuresHead.eyebrow">{featuresHead.eyebrow}</span></span></div>
        <h2 class="h2"><span data-i18n="featuresHead.h2.text">{h2}</span><span class="gdot" data-i18n="featuresHead.h2.dot">{dot}</span></h2>
      </div>
    </div>

    <div class="console dots">
      {consolePanels.map((p, i) => {
        const Anim = anims[p.id as keyof typeof anims];
        return (
          <article class="pane" data-pane={p.id}>
            <h3 class="h5" data-i18n={`consolePanels.${i}.t`}>{p.t}</h3>
            <p class="line" data-i18n={`consolePanels.${i}.b`}>{p.b}</p>
            <div class="win" aria-label={p.title} data-i18n-attr={`aria-label=consolePanels.${i}.title`}>
              <div class="chrome">
                <span class="controls" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="title" data-i18n={`consolePanels.${i}.title`}>{p.title}</span>
              </div>
              <Anim />
            </div>
          </article>
        );
      })}
    </div>

    <p class="strip label" aria-label={en.consoleStripLabel} data-i18n-attr="aria-label=consoleStripLabel">
      {consoleStrip.map((k, i) => (
        <Fragment>{i > 0 && <span class="sep" aria-hidden="true"> · </span>}<span data-i18n={`features.${i}.k`}>{k}</span></Fragment>
      ))}
    </p>
  </div>
</section>

<style>
  .console {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--line); background: var(--surface);
  }
  .pane {
    display: flex; flex-direction: column; gap: var(--s-16);
    padding: var(--s-40) var(--s-32) 0; min-width: 0; overflow: hidden;
  }
  .pane + .pane { border-left: 1px solid var(--line); }
  .pane .h5 { max-width: 20ch; }
  .line { font-size: 15px; line-height: 22px; color: var(--pale); max-width: 36ch; }

  /* The window: the animation card's frame on paper, pushed to the pane's
     floor and past its right edge. --win-* are the card-only colours that
     had no site token: the inner panel tint, the pass green and the gold-as-
     text tone (gold itself is 1.7:1 on white, so gold *type* darkens to this;
     gold lines, packets and fills stay gold). All type >= 4.5:1 on white. */
  .win {
    --win-panel: var(--off); --win-ok: #1f7a4d; --win-gold-ink: #945900;
    --win-rule: var(--line-soft); --win-mute: var(--muted);
    margin: var(--s-40) calc(-1 * var(--s-16)) 0 var(--s-16);
    flex: none; height: 332px; padding: 16px; overflow: hidden;
    display: flex; flex-direction: column;
    border: 1px solid var(--teal); box-shadow: 6px 6px 0 var(--teal);
    background-color: var(--white);
    background-image: radial-gradient(var(--mist) 1px, transparent 1px); background-size: 14px 14px;
    color: var(--teal); font-family: var(--sans);
  }
  .chrome { display: flex; align-items: center; gap: 12px; padding-bottom: 12px; border-bottom: 1px dotted var(--muted); flex: 0 0 auto; }
  .controls { display: flex; gap: 4px; }
  .controls i { width: 8px; height: 8px; border: 1px solid var(--teal); }
  .title { font: 11px/1.4 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .win :global(.win-body) { display: flex; flex-direction: column; flex: 1; min-height: 0; min-width: 0; }

  .strip { padding-top: var(--s-32); color: var(--text-hi); letter-spacing: 0.06em; }
  .sep { color: var(--gold-2); }

  @media (max-width: 1100px) { .pane { padding: var(--s-32) var(--s-24) 0; } }
  @media (max-width: 900px) {
    .console { grid-template-columns: 1fr; }
    .pane + .pane { border-left: 0; border-top: 1px solid var(--line); }
    .pane { padding: var(--s-32) var(--s-24) 0; }
    .win { margin-top: var(--s-32); }
  }
</style>
