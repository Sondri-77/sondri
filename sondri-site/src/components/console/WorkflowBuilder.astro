---
/* Playground card 01 · Workflow builder, ported: the six-node map draws
   itself, nodes popping in turn, gold packets running the wires. Colours
   come from the site's tokens (the window is the .on-dark field). */
---

<div class="anim win-body" data-anim="workflow" data-anim-root>
  <div class="stage">
    <svg class="map" viewBox="0 0 320 274" role="img" aria-label="Email flows through parsing, CRM lookup, an amount check, posting and notification">
      <text class="tag" x="4" y="21">YOUR NEXT WORKFLOW</text>
      <text class="detail" x="4" y="38">6 steps / 1 decision / no copy-paste</text>
      <path class="wire" d="M82 86H108"/><path class="draw" d="M82 86H108"/>
      <path class="wire" d="M176 86H202"/><path class="draw" d="M176 86H202"/>
      <path class="wire" d="M258 107V152"/><path class="draw" d="M258 107V152"/>
      <path class="wire" d="M258 194V237H176"/><path class="draw" d="M258 194V237H176"/>
      <path class="wire" d="M202 173H82"/><path class="draw" d="M202 173H82"/>
      <path class="wire" d="M108 237H43V194"/><path class="draw" d="M108 237H43V194"/>
      <g class="node"><rect class="box" x="4" y="65" width="78" height="42"/><text class="lbl" x="12" y="82">TRIGGER</text><text class="detail" x="12" y="96">new email</text></g>
      <g class="node"><rect class="box" x="108" y="65" width="68" height="42"/><text class="lbl" x="116" y="82">PARSE</text><text class="detail" x="116" y="96">extract</text></g>
      <g class="node"><rect class="box" x="202" y="65" width="112" height="42"/><text class="lbl" x="210" y="82">LOOKUP</text><text class="detail" x="210" y="96">your CRM</text></g>
      <g class="node"><rect class="box" x="202" y="152" width="112" height="42"/><text class="lbl" x="210" y="169">IF &gt; 5K</text><text class="detail" x="210" y="183">check amount</text></g>
      <g class="node"><rect class="box" x="108" y="216" width="68" height="42"/><text class="lbl" x="116" y="233">POST</text><text class="detail" x="116" y="247">your ERP</text></g>
      <g class="node"><rect class="box" x="4" y="152" width="78" height="42"/><text class="lbl" x="12" y="169">NOTIFY</text><text class="detail" x="12" y="183">your team</text></g>
      <rect class="packet" width="5" height="5"/><rect class="packet" width="5" height="5"/><rect class="packet" width="5" height="5"/>
      <rect class="packet" width="5" height="5"/><rect class="packet" width="5" height="5"/><rect class="packet" width="5" height="5"/>
    </svg>
  </div>
</div>

<style>
  .stage { position: relative; flex: 1; min-height: 0; min-width: 0; display: flex; align-items: center; padding: 12px 0; }
  .map { width: 100%; height: 100%; overflow: visible; }
  .wire { fill: none; stroke: #54716d; stroke-width: 1; }
  .draw { fill: none; stroke: var(--gold); stroke-width: 1.5; }
  .box { fill: var(--win-panel); stroke: var(--mist); stroke-width: 1; filter: drop-shadow(3px 3px 0 #000); }
  .lbl { fill: var(--white); font: 11px var(--mono); }
  .detail { fill: var(--muted-inv); font: 10px var(--mono); }
  .tag { fill: var(--gold); font: 10px var(--mono); letter-spacing: 0.08em; }
  .node { transform-box: fill-box; transform-origin: center; }
  .packet { fill: var(--gold); }
</style>

<script>
  import { runAnimation } from '../../scripts/console-anim';
  const root = document.querySelector<HTMLElement>('[data-anim="workflow"]');
  if (root) {
    const nodes = [...root.querySelectorAll<SVGGElement>('.node')];
    const edges = [...root.querySelectorAll<SVGPathElement>('.draw')];
    const packets = [...root.querySelectorAll<SVGRectElement>('.packet')];
    const lengths = edges.map((p) => p.getTotalLength());
    edges.forEach((p, i) => (p.style.strokeDasharray = String(lengths[i])));
    runAnimation(root, (time, reduced) => {
      const t = time % 9.4;
      nodes.forEach((node, i) => {
        const age = t - i * 0.72;
        const scale = age < 0 ? 0.6 : age < 0.15 ? 0.6 + (age / 0.15) * 0.48 : age < 0.184 ? 1.08 : 1;
        node.style.opacity = age < 0 ? '.12' : '1';
        node.style.transform = `scale(${reduced ? 1 : scale})`;
      });
      edges.forEach((edge, i) => {
        const start = (i < 4 ? i + 1 : 5) * 0.72;
        const progress = Math.max(0, Math.min(1, (t - start) / 0.35));
        edge.style.strokeDashoffset = String(lengths[i] * (1 - progress));
        const travel = ((t - start) * 0.7 + i * 0.2) % 1;
        const point = edge.getPointAtLength(Math.max(0, travel) * lengths[i]);
        packets[i].style.opacity = t >= start && !reduced ? '1' : '0';
        packets[i].setAttribute('transform', `translate(${point.x - 2.5} ${point.y - 2.5})`);
      });
    }, 7.2);
  }
</script>
