---
/* Playground card 03 · Agentic chat, ported: a question types in, the agent
   thinks, calls a tool, reads the result, and types the answer back. */
import { en } from '../../i18n';
const c = en.chatAnim;
---

<div class="anim win-body" data-anim="chat" data-anim-root>
  <div class="stage">
    <div class="chat">
      <div class="bar"><span data-i18n="chatAnim.assistant">{c.assistant}</span><span class="live" data-i18n="chatAnim.online">{c.online}</span></div>
      <div class="messages">
        <div class="user"></div>
        <div class="agent">
          <div class="who"><span data-i18n="chatAnim.agent">{c.agent}</span> <i class="dot"></i><i class="dot"></i><i class="dot"></i></div>
          <div class="chip"><span class="tool"></span><span class="tick">✓</span></div>
          <div class="result"></div>
          <p class="reply"></p>
        </div>
      </div>
      <div class="foot" data-i18n="chatAnim.foot">{c.foot}</div>
    </div>
  </div>
</div>

<style>
  .stage { position: relative; flex: 1; min-height: 0; min-width: 0; display: flex; align-items: center; padding: 12px 0; }
  .chat {
    width: 100%; height: 246px; overflow: hidden; display: flex; flex-direction: column;
    background: var(--win-panel); border: 1px solid var(--teal); box-shadow: 3px 3px 0 var(--teal);
  }
  .bar { padding: 9px 11px; border-bottom: 1px solid var(--win-rule); display: flex; justify-content: space-between; font: 9px var(--mono); letter-spacing: 0.08em; color: var(--win-mute); }
  .live { color: var(--win-ok); }
  .messages { padding: 12px; overflow: hidden; flex: 1; min-height: 0; }
  .user { background: var(--teal); color: var(--white); margin: 0 0 10px auto; width: fit-content; max-width: 88%; padding: 9px 11px; font: 12px/1.5 var(--sans); min-height: 18px; }
  .agent { border: 1px solid var(--win-rule); background: var(--white); padding: 9px 10px; width: 94%; min-height: 35px; }
  .who { display: flex; gap: 5px; align-items: center; color: var(--win-mute); font: 9px var(--mono); letter-spacing: 0.08em; }
  .dot { background: var(--gold); width: 3px; height: 3px; display: inline-block; }
  .chip { margin-top: 8px; padding: 6px; border: 1px solid var(--gold); background: rgba(253, 179, 67, 0.18); color: var(--win-gold-ink); font: 10px var(--mono); white-space: nowrap; }
  .tick { float: right; color: var(--win-ok); }
  .result { color: var(--win-mute); font: 10px/1.4 var(--mono); margin-top: 6px; }
  .reply { font: 12px/1.5 var(--sans); margin: 7px 0 0; color: var(--teal); }
  .foot { padding: 8px 11px; border-top: 1px solid var(--win-rule); font: 9px var(--mono); color: var(--win-mute); }
</style>

<script>
  import { runAnimation } from '../../scripts/console-anim';
  import { EVENT, t } from '../../scripts/i18n';
  const root = document.querySelector<HTMLElement>('[data-anim="chat"]');
  if (root) {
    // The three exchanges, read in the page's language on every frame.
    const exchange = (n: number) => [0, 1, 2, 3].map((j) => t(`chatAnim.exchanges.${n}.${j}`));
    const q = (s: string) => root.querySelector<HTMLElement>(s)!;
    const user = q('.user'), agent = q('.agent'), chip = q('.chip'), tool = q('.tool');
    const result = q('.result'), reply = q('.reply'), tick = q('.tick'), messages = q('.messages');
    const dots = [...root.querySelectorAll<HTMLElement>('.dot')];
    let lastText = '';
    let last: [number, boolean] = [0, false];
    const draw = (time: number, reduced: boolean) => {
      const ex = exchange(Math.floor(time / 8.6) % 3);
      const t = time % 8.6;
      const typed = ex[0].slice(0, Math.max(1, Math.floor(t * 30)));
      if (user.textContent !== typed) user.textContent = typed;
      agent.style.opacity = t > 1.1 ? '1' : '0';
      dots.forEach((d, i) => (d.style.opacity = t < 2.7 && !reduced ? String(0.2 + 0.8 * Math.max(0, Math.sin(t * 7 - i))) : '0'));
      chip.style.display = t > 2.6 ? 'block' : 'none';
      if (tool.textContent !== ex[1]) tool.textContent = ex[1];
      tick.style.opacity = t > 3.5 ? '1' : '0';
      result.style.display = t > 3.5 ? 'block' : 'none';
      if (result.textContent !== ex[2]) result.textContent = ex[2];
      const text = ex[3].slice(0, Math.max(0, Math.floor((t - 4) * 30)));
      if (text !== lastText) { reply.textContent = text; lastText = text; messages.scrollTop = 10000; }
    };
    runAnimation(root, (time, reduced) => { last = [time, reduced]; draw(time, reduced); }, 7.4);
    // A language switch redraws the frame even while the window is off screen.
    document.addEventListener(EVENT, () => draw(...last));
  }
</script>
