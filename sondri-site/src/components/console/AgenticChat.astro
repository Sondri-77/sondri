---
/* Playground card 03 · Agentic chat, ported: a question types in, the agent
   thinks, calls a tool, reads the result, and types the answer back. */
---

<div class="anim win-body" data-anim="chat" data-anim-root>
  <div class="stage">
    <div class="chat">
      <div class="bar"><span>YOUR ASSISTANT</span><span class="live">■ ONLINE</span></div>
      <div class="messages">
        <div class="user"></div>
        <div class="agent">
          <div class="who">AGENT <i class="dot"></i><i class="dot"></i><i class="dot"></i></div>
          <div class="chip"><span class="tool"></span><span class="tick">✓</span></div>
          <div class="result"></div>
          <p class="reply"></p>
        </div>
      </div>
      <div class="foot">ASK → LOOK UP → TAKE ACTION</div>
    </div>
  </div>
</div>

<style>
  .stage { position: relative; flex: 1; min-height: 0; min-width: 0; display: flex; align-items: center; padding: 12px 0; }
  .chat {
    width: 100%; height: 246px; overflow: hidden; display: flex; flex-direction: column;
    background: var(--win-panel); border: 1px solid var(--mist); box-shadow: 3px 3px 0 #000;
  }
  .bar { padding: 9px 11px; border-bottom: 1px solid #36534f; display: flex; justify-content: space-between; font: 9px var(--mono); letter-spacing: 0.08em; color: var(--muted-inv); }
  .live { color: var(--win-ok); }
  .messages { padding: 12px; overflow: hidden; flex: 1; min-height: 0; }
  .user { background: var(--off); color: var(--teal); margin: 0 0 10px auto; width: fit-content; max-width: 88%; padding: 9px 11px; font: 12px/1.5 var(--sans); min-height: 18px; }
  .agent { border: 1px solid #45625d; padding: 9px 10px; width: 94%; min-height: 35px; }
  .who { display: flex; gap: 5px; align-items: center; color: var(--muted-inv); font: 9px var(--mono); letter-spacing: 0.08em; }
  .dot { background: var(--gold); width: 3px; height: 3px; display: inline-block; }
  .chip { margin-top: 8px; padding: 6px; border: 1px solid var(--gold); color: var(--gold); font: 10px var(--mono); white-space: nowrap; }
  .tick { float: right; color: var(--win-ok); }
  .result { color: var(--muted-inv); font: 10px/1.4 var(--mono); margin-top: 6px; }
  .reply { font: 12px/1.5 var(--sans); margin: 7px 0 0; color: var(--white); }
  .foot { padding: 8px 11px; border-top: 1px solid #36534f; font: 9px var(--mono); color: var(--muted-inv); }
</style>

<script>
  import { runAnimation } from '../../scripts/console-anim';
  const root = document.querySelector<HTMLElement>('[data-anim="chat"]');
  if (root) {
    const exchanges = [
      ['Where is order #4471?', '⚙ lookup_order(#4471)', 'Found · out for delivery', 'Your order arrives today by 5 pm.'],
      ['Can you approve my refund?', '⚙ check_refund(#4471)', 'Eligible · within 30 days', 'Your refund is approved. Allow 3 days.'],
      ['Book a call for tomorrow.', '⚙ find_slot(tomorrow)', 'Available · 10:30 am', 'Your call is booked for 10:30 am.'],
    ];
    const q = (s: string) => root.querySelector<HTMLElement>(s)!;
    const user = q('.user'), agent = q('.agent'), chip = q('.chip'), tool = q('.tool');
    const result = q('.result'), reply = q('.reply'), tick = q('.tick'), messages = q('.messages');
    const dots = [...root.querySelectorAll<HTMLElement>('.dot')];
    let lastText = '';
    runAnimation(root, (time, reduced) => {
      const ex = exchanges[Math.floor(time / 8.6) % 3];
      const t = time % 8.6;
      const typed = ex[0].slice(0, Math.max(1, Math.floor(t * 30)));
      if (user.textContent !== typed) user.textContent = typed;
      agent.style.opacity = t > 1.1 ? '1' : '0';
      dots.forEach((d, i) => (d.style.opacity = t < 2.7 && !reduced ? String(0.2 + 0.8 * Math.max(0, Math.sin(t * 7 - i))) : '0'));
      chip.style.display = t > 2.6 ? 'block' : 'none';
      if (tool.textContent !== ex[1]) tool.textContent = ex[1];
      tick.style.opacity = t > 3.5 ? '1' : '0';
      result.style.display = t > 3.5 ? 'block' : 'none';
      if (result.textContent !== ex[2]) result.textContent = ex[2];
      const text = ex[3].slice(0, Math.max(0, Math.floor((t - 4) * 30)));
      if (text !== lastText) { reply.textContent = text; lastText = text; messages.scrollTop = 10000; }
    }, 7.4);
  }
</script>
