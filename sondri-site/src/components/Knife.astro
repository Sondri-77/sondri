---
import { calculator, knifeHead } from '../home-data';
import { money, weeklyCost, yearlyCost } from '../lib/cost';
import { splitDot } from '../lib/dot';
const [h2, dot] = splitDot(knifeHead.h2);
// Server-rendered defaults: the sentence reads with real numbers before (or without) JS.
const by = Object.fromEntries(calculator.inputs.map((i) => [i.id, i])) as Record<string, (typeof calculator.inputs)[number]>;
const [wage, hours, people] = [by.wage.value, by.hours.value, by.people.value];
const year = money(yearlyCost(weeklyCost(wage, hours, people)));
const fmt = (i: (typeof calculator.inputs)[number]) => (i.money ? money(i.value) : String(i.value)) + i.unit;
// The input's i18n key prefix (`calculator.inputs.2`), by its place in the data.
const key = (i: (typeof calculator.inputs)[number]) => `calculator.inputs.${calculator.inputs.indexOf(i)}`;
---

<!-- Impact: the cost of inaction as one sentence (playground C3). The three
     values are bold gold words; clicking one opens its slider in a tray under
     the sentence, arrow keys nudge it in place. The yearly total repeats big
     under a rule, in Florexa (.kpi). -->
<section class="section section-pad on-dark" id="impact">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="eyebrow"><span class="label">/ <span data-i18n="knifeHead.eyebrow">{knifeHead.eyebrow}</span></span></div>
        <h2 class="h2"><span data-i18n="knifeHead.h2.text">{h2}</span><span class="gdot" data-i18n="knifeHead.h2.dot">{dot}</span></h2>
      </div>
      <div class="intro">
        <p class="lede" data-i18n="knifeHead.lede">{knifeHead.lede}</p>
      </div>
    </div>

    <form class="calc" data-calc onsubmit="return false">
      <p class="sentence">
        {[by.people, by.hours, by.wage].map((i, n) => (
          <Fragment>
            <span class="edit" data-edit={i.id}>
              <b class="val" role="button" tabindex="0" aria-haspopup="true" aria-expanded="false" title={i.change} data-val={i.id} data-i18n-attr={`title=${key(i)}.change`}>{fmt(i)}</b>
              <span class="tray">
                <label class="label" for={`calc-${i.id}`} title={i.t} data-i18n={`${key(i)}.k`} data-i18n-attr={`title=${key(i)}.t`}>{i.k}</label>
                <input
                  type="range"
                  id={`calc-${i.id}`}
                  name={i.id}
                  min={i.min}
                  max={i.max}
                  step={i.step}
                  value={i.value}
                  data-money={i.money ? '' : undefined}
                  data-unit={i.unit}
                  aria-label={i.t}
                  data-i18n-attr={`aria-label=${key(i)}.t`}
                />
              </span>
            </span>
            {n === 0 && <span data-people-word>{people === 1 ? calculator.person : calculator.people}</span>}
            {n === 1 && <span data-i18n="calculator.week">{calculator.week}</span>}
            {n === 2 && <span data-i18n="calculator.on">{calculator.on}</span>}
          </Fragment>
        ))}
        <span data-i18n="calculator.sum">{calculator.sum}</span><b class="val sum" data-year>{year}</b><span data-i18n="calculator.yearSentence">{calculator.yearSentence}</span>
      </p>
      <p class="label hint" data-i18n="calculator.hint">{calculator.hint}</p>

      <p class="total" aria-live="polite" aria-atomic="true">
        <span class="figure kpi" data-year>{year}</span> <span class="label" data-i18n="calculator.year">{calculator.year}</span>
      </p>
    </form>
  </div>
</section>

<style>
  /* The sentence: display-size sans, the values gold and dotted underneath
     so they read as things you can touch. Tabular figures so a nudge never
     reflows the line. */
  .sentence {
    position: relative; max-width: 24ch; color: var(--text-hi);
    font-size: clamp(28px, 3.4vw, 46px); line-height: 1.3; font-weight: 500;
    letter-spacing: -0.03em; font-variant-numeric: tabular-nums;
  }
  .val { color: var(--accent); font-weight: 600; white-space: nowrap; }
  .edit { display: inline; }
  .edit .val { border-bottom: 3px dotted var(--accent); cursor: pointer; user-select: none; }
  .edit .val:hover, .edit.is-open .val { background: rgba(253, 179, 67, 0.15); }
  .edit .val:focus-visible { outline: 2px solid var(--white); outline-offset: 3px; }

  /* The open slider sits in a full-width tray where the hint line is, so it
     never covers the sentence; the hint hides while a tray is open. */
  .tray {
    display: none; position: absolute; left: 0; right: 0; top: 100%; margin-top: var(--s-16);
    padding: 10px 16px 6px; background: var(--teal-deep); border: 1px solid var(--accent);
    grid-template-columns: 160px minmax(0, 1fr); gap: var(--s-16); align-items: center;
    font-size: 16px; letter-spacing: 0; font-weight: 400;
  }
  .tray .label { color: var(--accent); }
  .edit.is-open .tray { display: grid; }
  .calc:has(.is-open) .hint { visibility: hidden; }
  .hint { margin-top: var(--s-24); min-height: 50px; }
  /* No JS: the values are just numbers, no cursor, no underline. */
  .calc:not([data-js]) .edit .val { border-bottom: 0; cursor: default; }
  .calc:not([data-js]) .hint { display: none; }

  /* The slider, square: a 2px rule for the track and a gold block for the thumb. */
  input[type='range'] {
    appearance: none; -webkit-appearance: none;
    width: 100%; height: 28px; margin: 0; background: transparent; cursor: pointer;
  }
  input[type='range']:focus { outline: none; }
  input[type='range']::-webkit-slider-runnable-track { height: 2px; background: var(--line); }
  input[type='range']::-moz-range-track { height: 2px; background: var(--line); }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 20px; height: 20px; margin-top: -9px;
    background: var(--gold); border: 0; border-radius: 0;
    transition: background 0.15s linear;
  }
  input[type='range']::-moz-range-thumb {
    width: 20px; height: 20px;
    background: var(--gold); border: 0; border-radius: 0;
  }
  input[type='range']:hover::-webkit-slider-thumb { background: var(--gold-2); }
  input[type='range']:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--white); outline-offset: 2px; }
  input[type='range']:focus-visible::-moz-range-thumb { outline: 2px solid var(--white); outline-offset: 2px; }

  /* The total, repeated big and gold in Florexa under a rule, the label on its baseline. */
  .total {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-24);
    margin-top: var(--s-40); padding-top: var(--s-32); border-top: 1px solid var(--line);
  }
  .figure { font-size: clamp(64px, 8vw, 112px); color: var(--accent); }

  @media (max-width: 640px) {
    .sentence { max-width: none; }
    .tray { grid-template-columns: minmax(0, 1fr); gap: 4px; padding: 10px 12px 6px; }
    .hint { min-height: 76px; }
  }
  @media (prefers-reduced-motion: reduce) { input[type='range']::-webkit-slider-thumb { transition: none; } }
</style>

<script>
  import { money, weeklyCost, yearlyCost } from '../lib/cost';
  import { EVENT, t } from '../scripts/i18n';

  const form = document.querySelector<HTMLFormElement>('[data-calc]');
  if (form) {
    form.dataset.js = '';
    const inputs = [...form.querySelectorAll<HTMLInputElement>('input[type="range"]')];
    const years = [...form.querySelectorAll<HTMLElement>('[data-year]')];
    const word = form.querySelector<HTMLElement>('[data-people-word]');
    const by = (name: string) => inputs.find((i) => i.name === name)!;

    const show = (i: HTMLInputElement) => {
      const out = form.querySelector<HTMLElement>(`[data-val="${i.name}"]`);
      if (!out) return;
      const n = Number(i.value);
      out.textContent = ('money' in i.dataset ? money(n) : String(n)) + (i.dataset.unit ?? '');
    };
    const update = () => {
      const wage = Number(by('wage').value), hours = Number(by('hours').value), people = Number(by('people').value);
      const total = money(yearlyCost(weeklyCost(wage, hours, people)));
      years.forEach((y) => (y.textContent = total));
      // The verb agrees with the head count, in the page's language.
      if (word) word.textContent = people === 1 ? t('calculator.person') : t('calculator.people');
      inputs.forEach(show);
    };
    inputs.forEach((i) => i.addEventListener('input', update));
    document.addEventListener(EVENT, update);
    update();

    // Inline edits: click a value to open its slider tray; arrow keys on the
    // value nudge it directly; Enter/Space open; Escape (or Enter in the
    // slider) closes and hands focus back.
    const edits = [...form.querySelectorAll<HTMLElement>('.edit')];
    const closeAll = () =>
      edits.forEach((e) => {
        e.classList.remove('is-open');
        e.querySelector('.val')?.setAttribute('aria-expanded', 'false');
      });
    for (const edit of edits) {
      const val = edit.querySelector<HTMLElement>('.val')!;
      const input = edit.querySelector<HTMLInputElement>('input')!;
      const tray = edit.querySelector<HTMLElement>('.tray')!;
      const open = () => {
        closeAll();
        edit.classList.add('is-open');
        val.setAttribute('aria-expanded', 'true');
        input.focus({ preventScroll: true });
      };
      val.addEventListener('click', (ev) => {
        ev.stopPropagation();
        if (edit.classList.contains('is-open')) closeAll();
        else open();
      });
      val.addEventListener('keydown', (ev) => {
        const step = { ArrowUp: 1, ArrowRight: 1, ArrowDown: -1, ArrowLeft: -1 }[ev.key];
        if (step) {
          ev.preventDefault();
          if (step > 0) input.stepUp(); else input.stepDown();
          input.dispatchEvent(new Event('input', { bubbles: true }));
        } else if (ev.key === 'Enter' || ev.key === ' ') {
          ev.preventDefault();
          open();
        } else if (ev.key === 'Escape') {
          closeAll();
        }
      });
      input.addEventListener('keydown', (ev) => {
        if (ev.key === 'Escape' || ev.key === 'Enter') {
          ev.preventDefault();
          closeAll();
          val.focus();
        }
      });
      tray.addEventListener('click', (ev) => ev.stopPropagation());
    }
    document.addEventListener('click', closeAll);
    document.addEventListener('keydown', (ev) => { if (ev.key === 'Escape') closeAll(); });
  }
</script>
