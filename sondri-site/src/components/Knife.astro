---
import { knife, knifeHead } from '../home-data';
import { splitDot } from '../lib/dot';
const [h2, dot] = splitDot(knifeHead.h2);
---

<!-- Twist the knife: the cost of inaction, on the teal field. Three ruled
     columns, each a cost line. -->
<section class="section section-pad on-dark">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2 class="h2">{h2}<span class="gdot">{dot}</span></h2>
      </div>
      <div class="intro">
        <p class="lede">{knifeHead.lede}</p>
      </div>
    </div>

    <div class="rule-cols cols-3 costs">
      {knife.map((k, i) => (
        <article data-reveal style={`transition-delay:${i * 80}ms`}>
          <h3 class="h3">{k.t}</h3>
          <p class="body">{k.b}</p>
        </article>
      ))}
    </div>

    <p class="h4 close">{knifeHead.close}</p>
  </div>
</section>

<style>
  .costs article { display: flex; flex-direction: column; gap: var(--s-16); }
  .body { color: var(--pale); font-size: 15px; line-height: 22px; max-width: 34ch; }
  .close { padding-top: var(--s-64); max-width: 40ch; }
  @media (min-width: 900px) { .close { white-space: nowrap; max-width: none; } }
</style>
