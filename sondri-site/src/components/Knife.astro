---
import { calculator, knifeHead } from '../home-data';
import { money, weeklyCost, yearlyCost } from '../lib/cost';
import { splitDot } from '../lib/dot';
const [h2, dot] = splitDot(knifeHead.h2);
// Server-rendered defaults: the section shows real numbers before (or without) JS.
const [wage, hours, people] = calculator.inputs.map((i) => i.value);
const year = yearlyCost(weeklyCost(wage, hours, people));
const fmt = (i: (typeof calculator.inputs)[number]) => (i.money ? money(i.value) : String(i.value)) + i.unit;
---

<!-- Impact: the cost of inaction, on the teal field. Three ruled columns,
     each a slider, and the live total under the closing line. -->
<section class="section section-pad on-dark" id="impact">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="eyebrow"><span class="label">/ {knifeHead.eyebrow}</span></div>
        <h2 class="h2">{h2}<span class="gdot">{dot}</span></h2>
      </div>
      <div class="intro">
        <p class="lede">{knifeHead.lede}</p>
      </div>
    </div>

    <form class="calc" data-calc onsubmit="return false">
      <div class="rule-cols cols-3 inputs">
        {calculator.inputs.map((i) => (
          <div class="field">
            <p class="label idx">{i.k}</p>
            <label class="h5" for={`calc-${i.id}`}>{i.t}</label>
            <output class="val h3" for={`calc-${i.id}`} data-val={i.id}>{fmt(i)}</output>
            <input
              type="range"
              id={`calc-${i.id}`}
              name={i.id}
              min={i.min}
              max={i.max}
              step={i.step}
              value={i.value}
              data-money={i.money ? '' : undefined}
              data-unit={i.unit}
            />
            <p class="label range"><span>{i.money ? money(i.min) : i.min}{i.unit}</span><span>{i.money ? money(i.max) : i.max}{i.unit}</span></p>
          </div>
        ))}
      </div>

      <p class="close"><span class="hl">{knifeHead.close}</span></p>
      <p class="total" aria-live="polite" aria-atomic="true">
        <span class="sum display" data-year>{money(year)}</span> <span class="label">{calculator.year}</span>
      </p>
    </form>
  </div>
</section>

<style>
  .field { display: flex; flex-direction: column; gap: var(--s-16); }
  .idx { color: var(--accent); }
  .idx::before {
    content: ''; display: inline-block;
    width: 7px; height: 7px; margin-right: 10px; vertical-align: 1px;
    background: currentColor;
  }
  label { cursor: pointer; }
  /* The value: gold, tabular so the line never jitters as it counts. */
  .val { color: var(--accent); font-variant-numeric: tabular-nums; }
  .range { display: flex; justify-content: space-between; color: var(--steel); }

  /* The slider, square: a 2px rule for the track and a gold block for the
     thumb, the same brutalist parts as the rest of the page. */
  input[type='range'] {
    appearance: none; -webkit-appearance: none;
    width: 100%; height: 28px; margin: 0; background: transparent; cursor: pointer;
  }
  input[type='range']:focus { outline: none; }
  input[type='range']::-webkit-slider-runnable-track { height: 2px; background: var(--line); }
  input[type='range']::-moz-range-track { height: 2px; background: var(--line); }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 20px; height: 20px; margin-top: -9px;
    background: var(--gold); border: 0; border-radius: 0;
    transition: background 0.15s linear;
  }
  input[type='range']::-moz-range-thumb {
    width: 20px; height: 20px;
    background: var(--gold); border: 0; border-radius: 0;
  }
  input[type='range']:hover::-webkit-slider-thumb { background: var(--gold-2); }
  input[type='range']:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--white); outline-offset: 2px; }
  input[type='range']:focus-visible::-moz-range-thumb { outline: 2px solid var(--white); outline-offset: 2px; }

  .close { padding-top: var(--s-64); font-size: 20px; line-height: 1.4; max-width: 60ch; }
  @media (min-width: 900px) { .close { white-space: nowrap; max-width: none; } }

  /* The total: one yearly figure, big and gold, the label on its baseline.
     Tabular figures so the block never jitters as it counts. */
  .total { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-16); padding-top: var(--s-24); font-variant-numeric: tabular-nums; }
  .sum { font-size: clamp(48px, 7vw, 96px); line-height: 1; font-weight: 700; color: var(--accent); }
</style>

<script>
  import { money, weeklyCost, yearlyCost } from '../lib/cost';

  const form = document.querySelector<HTMLFormElement>('[data-calc]');
  if (form) {
    const inputs = [...form.querySelectorAll<HTMLInputElement>('input[type="range"]')];
    const year = form.querySelector<HTMLElement>('[data-year]')!;

    const show = (i: HTMLInputElement) => {
      const out = form.querySelector<HTMLElement>(`[data-val="${i.name}"]`);
      if (!out) return;
      const n = Number(i.value);
      out.textContent = ('money' in i.dataset ? money(n) : String(n)) + (i.dataset.unit ?? '');
    };
    const update = () => {
      const [wage, hours, people] = inputs.map((i) => Number(i.value));
      year.textContent = money(yearlyCost(weeklyCost(wage, hours, people)));
      inputs.forEach(show);
    };
    inputs.forEach((i) => i.addEventListener('input', update));
    update();
  }
</script>
