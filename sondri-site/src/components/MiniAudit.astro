      aiReportLede:
        'We test 2 unbranded buyer-intent questions (to see if AI recommends you organically) plus 1 direct brand question (to verify whether AI accurately understands what your business does).',
      statNamed: 'Answers naming you',
      statNamedSub: 'Out of 3 unbranded buyer questions run once on Gemini.',
      statCited: 'Answers citing your site',
      statCitedSub: 'Times your domain appeared in the grounded web sources.',
      statCompetitors: 'Named instead & sources cited',
      compSubLabel: 'Competitors named:',
