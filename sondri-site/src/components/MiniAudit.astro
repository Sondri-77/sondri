      cmpPaidHead: 'Auditoría Completa AEO / GEO ($99 USD)',
      cmpPaid1: '12 a 15 preguntas sin marca × 3 repeticiones por motor (36 a 45 revisiones por motor)',
      cmpPaid2: 'Medido en ChatGPT, Gemini, Google AI Overviews y Google AI Mode (sin sesión)',
      cmpPaid3: 'Mapa completo de competidores y fuentes citadas + revisión de exactitud',
      cmpPaid4: 'Lista de correcciones priorizadas (páginas, FAQs, schema, Perfil de Google, menciones)',
      priceLabel: 'Auditoría única a precio fijo',
      priceDisclaimer:
        'No prometemos un puesto ni un porcentaje. Medimos y reportamos el cambio con el mismo método cada vez.',
      buyBtn: 'Solicitar Auditoría Completa de 15 Preguntas ($99)',
      buyBtnLoading: 'Redirigiendo a Stripe Checkout…',
      stripeNote: 'Pago seguro con Stripe · Factura PDF al instante',
    },
  };

  const sectionEl = document.getElementById('mini-audit');
  let currentLang: 'en' | 'es' =
    (sectionEl?.getAttribute('data-default-lang') as 'en' | 'es') || 'en';
  let currentAudit: any = null;

  function applyAuditLang(lang: 'en' | 'es') {
    currentLang = lang;
    const dict = I18N[lang];
    document.querySelectorAll<HTMLElement>('[data-audit-i18n]').forEach((el) => {
      const key = el.getAttribute('data-audit-i18n');
      if (key && dict[key]) {
        el.textContent = dict[key];
      }
    });
    document.querySelectorAll<HTMLButtonElement>('[data-set-lang]').forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-set-lang') === lang);
    });
  }

  const urlLang = new URLSearchParams(window.location.search).get('lang');
  const savedLang = localStorage.getItem('sondri.lang');
  if (urlLang === 'es' || savedLang === 'es') {
    applyAuditLang('es');
  } else {
    applyAuditLang(currentLang);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-set-lang]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const l = btn.getAttribute('data-set-lang') === 'es' ? 'es' : 'en';
      applyAuditLang(l);
    });
  });

  function renderTechScan(audit: any) {
    const scan = audit.tech_scan;
    const reportEl = document.getElementById('auditReportContainer');
    if (!reportEl || !scan) return;
    reportEl.style.display = 'block';

    const badge = document.getElementById('readinessBadge');
    if (badge) {
      badge.textContent = `${scan.readinessScore}/100`;
    }

    const brandTitle = document.getElementById('detectedBrandTitle');
    if (brandTitle) {
      brandTitle.innerHTML = `${scan.detectedBrand || audit.domain} <span class="gdot">.</span>`;
    }

    const metaLine = document.getElementById('detectedMetaLine');
    if (metaLine) {
      metaLine.textContent =
        currentLang === 'es'
          ? `Dominio: ${audit.domain} · Rubro: ${audit.service} · Mercado: ${audit.city}`
          : `Domain: ${audit.domain} · Service: ${audit.service} · Market: ${audit.city}`;
    }

    const grid = document.getElementById('techCheckGrid');
    if (grid) {
      const items = [
        {
          label: currentLang === 'es' ? 'Schema Organization / LocalBusiness' : 'Organization / LocalBusiness Schema',
          ok: scan.hasOrganizationOrLocalBusiness,
        },
        {
          label: currentLang === 'es' ? 'Schema FAQPage' : 'FAQPage Schema',
          ok: scan.hasFaqSchema,
        },
        {
          label: currentLang === 'es' ? 'Señales de teléfono y dirección' : 'Phone & Address Signals',
          ok: scan.hasPhoneInHtml || scan.hasAddressSignals,
        },
        {
          label: 'sitemap.xml',
          ok: scan.sitemapFound,
        },
        {
          label: currentLang === 'es' ? 'llms.txt (opcional)' : 'llms.txt (optional)',
          ok: scan.llmsTxtFound,
          optional: true,
        },
      ];

      grid.innerHTML = items
        .map(
          (item) => `
          <div class="signal-row">
            <span class="sig-label">${item.label}</span>
            <span class="label sig-status ${item.ok ? 'ok' : item.optional ? 'opt' : 'miss'}">
              ${item.ok ? (currentLang === 'es' ? 'DETECTADO' : 'FOUND') : item.optional ? (currentLang === 'es' ? 'OPCIONAL' : 'OPTIONAL') : (currentLang === 'es' ? 'FALTA' : 'MISSING')}
            </span>
          </div>`
        )
        .join('');
    }

    const botChips = document.getElementById('botChips');
    if (botChips && Array.isArray(scan.bots)) {
      botChips.innerHTML = scan.bots
        .map(
          (b: any) => `
          <div class="signal-row">
            <span class="sig-label">${b.bot}</span>
            <span class="label sig-status ${b.allowed ? 'ok' : 'miss'}">
              ${b.allowed ? (currentLang === 'es' ? 'PERMITIDO' : 'ALLOWED') : (currentLang === 'es' ? 'BLOQUEADO' : 'BLOCKED')}
            </span>
          </div>`
        )
        .join('');
    }

    const gapsBlock = document.getElementById('gapsBlock');
    const gapsList = document.getElementById('gapsList');
    if (gapsBlock && gapsList) {
      if (Array.isArray(scan.gaps) && scan.gaps.length > 0) {
        gapsBlock.style.display = 'block';
        gapsList.innerHTML = scan.gaps.map((g: string) => `<li>${g}</li>`).join('');
      } else {
        gapsBlock.style.display = 'none';
      }
    }

    const qs: string[] = audit.questions || [];
    for (let i = 0; i < 3; i++) {
      const inp = document.getElementById(`qInput${i}`) as HTMLInputElement | null;
      if (inp && qs[i]) inp.value = qs[i];
    }
  }

  async function loadLighthouseAsync(audit: any) {
    const seoEl = document.getElementById('lhSeoScore');
    const perfEl = document.getElementById('lhPerfScore');
    const crawlEl = document.getElementById('lhCrawlableLine');
    const extraEl = document.getElementById('lhExtraMetrics');

    if (seoEl) seoEl.textContent = '…';
    if (perfEl) perfEl.textContent = '…';

    try {
      const res = await fetch(
        `${WORKER_BASE}/audit/lighthouse?audit_id=${encodeURIComponent(audit.id)}&url=${encodeURIComponent(audit.url)}`
      );
      const json = await res.json();
      if (json.success && json.data) {
        const lh = json.data;
        if (seoEl) seoEl.textContent = lh.seoScore !== null ? `${lh.seoScore}/100` : 'N/A';
        if (perfEl)
          perfEl.textContent = lh.performanceScore !== null ? `${lh.performanceScore}/100` : 'N/A';
        if (crawlEl && lh.isCrawlable !== null) {
          crawlEl.textContent = lh.isCrawlable
            ? currentLang === 'es'
              ? 'Página indexable y rastreable por buscadores.'
              : 'Page is indexable and crawlable by search engines.'
            : currentLang === 'es'
              ? 'Alerta: la página bloquea la indexación.'
              : 'Warning: page is blocked from indexing.';
        }
        if (extraEl) {
          const parts: string[] = [];
          if (lh.lcpDisplay) parts.push(`LCP: ${lh.lcpDisplay}`);
          if (lh.clsDisplay) parts.push(`CLS: ${lh.clsDisplay}`);
          if (parts.length > 0) extraEl.textContent = parts.join(' · ');
        }
      }
    } catch {
      if (seoEl) seoEl.textContent = 'N/A';
      if (perfEl) perfEl.textContent = 'N/A';
    }
  }

  function renderAiVisibility(audit: any) {
    const ai = audit.ai_visibility;
    if (!ai) return;

    const namedVal = document.getElementById('statNamedVal');
    const citedVal = document.getElementById('statCitedVal');
    if (namedVal) namedVal.textContent = `${ai.namedCount}/${ai.totalQuestions}`;
    if (citedVal) citedVal.textContent = `${ai.citedCount}/${ai.totalQuestions}`;

    const compCloud = document.getElementById('competitorsCloud');
    if (compCloud) {
      compCloud.textContent =
        Array.isArray(ai.competitorsSummary) && ai.competitorsSummary.length > 0
          ? ai.competitorsSummary.join(', ')
          : currentLang === 'es'
            ? 'Ninguno detectado en esta corrida'
            : 'None detected in this run';
    }

    const srcCloud = document.getElementById('sourcesCloud');
    if (srcCloud) {
      srcCloud.textContent =
        Array.isArray(ai.topSourceDomains) && ai.topSourceDomains.length > 0
          ? ai.topSourceDomains.join(' · ')
          : currentLang === 'es'
            ? 'Sin citas externas'
            : 'No external citations';
    }

    const runsList = document.getElementById('runsList');
    if (runsList && Array.isArray(ai.runs)) {
      runsList.innerHTML = ai.runs
        .map((run: any, idx: number) => {
          const statusLabel =
            run.status !== 'ok'
              ? currentLang === 'es'
                ? 'NO EJECUTADO'
                : 'NOT RUN'
              : run.brandNamed
                ? currentLang === 'es'
                  ? 'TE NOMBRA'
                  : 'NAMED'
                : currentLang === 'es'
                  ? 'NO TE NOMBRA'
                  : 'NOT NAMED';

          const statusClass =
            run.status !== 'ok' ? 'opt' : run.brandNamed ? 'ok' : 'miss';

          const comps =
            Array.isArray(run.competitorsNamed) && run.competitorsNamed.length > 0
              ? `<p class="body-s run-meta"><strong>${currentLang === 'es' ? 'Nombrados en su lugar:' : 'Named instead:'}</strong> ${run.competitorsNamed.join(', ')}</p>`
              : '';

          const cites =
            Array.isArray(run.sourcesCited) && run.sourcesCited.length > 0
              ? `<p class="body-s run-meta"><strong>${currentLang === 'es' ? 'Fuentes citadas:' : 'Sources cited:'}</strong> ${run.sourcesCited
                  .map((s: any) => s.title || s.domain)
                  .join(' · ')}</p>`
              : '';

          return `
            <div class="run-row">
              <div class="run-top">
                <p class="h6 run-q"><span class="label">0${idx + 1}</span> ${run.question}</p>
                <span class="label sig-status ${statusClass}">${statusLabel}</span>
              </div>
              <p class="run-excerpt">${run.answerExcerpt}</p>
              ${comps}
              ${cites}
            </div>
          `;
        })
        .join('');
    }

    const notRunNote = document.getElementById('notRunNote');
    if (notRunNote) {
      notRunNote.textContent =
        currentLang === 'es'
          ? 'Nota metodológica: Esta muestra gratuita ejecuta 1 revisión por pregunta vía API en Gemini con búsqueda de Google. Los motores no ejecutados en esta muestra (ChatGPT, Google AI Overviews, Google AI Mode sin sesión iniciada) se marcan como no ejecutados, nunca como cero, y se miden con 3 repeticiones en la Auditoría Completa de $99.'
          : 'Method note: This free snapshot runs 1 API check per question on Gemini with Google Search grounding. Engines not checked in this free preview (ChatGPT, Google AI Overviews, Google AI Mode logged out) are marked not run—never zero—and are tested 3 times per question in the $99 Full Audit.';
    }
  }

  // Unified Intake Form Submit: runs Step 1 Scan + Lighthouse + Step 2 AI Visibility in one flow
  document.getElementById('formAuditIntake')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('btnScan') as HTMLButtonElement;
    const errEl = document.getElementById('scanError') as HTMLElement;
    errEl.style.display = 'none';

    const url = (document.getElementById('auditUrl') as HTMLInputElement).value.trim();
    const service = (document.getElementById('auditService') as HTMLInputElement).value.trim();
    const city = (document.getElementById('auditCity') as HTMLInputElement).value.trim();
    const name = (document.getElementById('leadName') as HTMLInputElement).value.trim();
    const email = (document.getElementById('leadEmail') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('leadPhone') as HTMLInputElement).value.trim();

    btn.disabled = true;
    const spanText = btn.querySelector('[data-audit-i18n="scanBtn"]');
    if (spanText) spanText.textContent = I18N[currentLang].scanBtnLoading;

    try {
      // 1. Run Technical Scan & infer 3 buyer questions
      const scanRes = await fetch(`${WORKER_BASE}/audit/scan`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url, service, city, lang: currentLang }),
      });
      const scanJson = await scanRes.json();

      if (!scanJson.success || !scanJson.data) {
        throw new Error(scanJson.error?.message || 'Unable to scan website');
      }

      currentAudit = scanJson.data;
      renderTechScan(currentAudit);
      loadLighthouseAsync(currentAudit);

      document.getElementById('techSection')?.scrollIntoView({ behavior: 'smooth', block: 'start' });

      // 2. Capture lead (Name + Email + Phone) & run 3-question AI visibility check
      const aiRes = await fetch(`${WORKER_BASE}/audit/ai-visibility`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          audit_id: currentAudit.id,
          name,
          email,
          phone,
          questions: currentAudit.questions,
          city: currentAudit.city,
          service: currentAudit.service,
        }),
      });
      const aiJson = await aiRes.json();
      if (aiJson.success && aiJson.data) {
        currentAudit = aiJson.data;
        renderAiVisibility(currentAudit);
      }
    } catch (err: any) {
      errEl.textContent = err.message || 'Scan failed. Please check the URL and try again.';
      errEl.style.display = 'block';
    } finally {
      btn.disabled = false;
      if (spanText) spanText.textContent = I18N[currentLang].scanBtn;
    }
  });

  // Handle Custom Question Re-run
  document.getElementById('formStep2')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!currentAudit) return;

    const btn = document.getElementById('btnRunAi') as HTMLButtonElement;
    const errEl = document.getElementById('aiError') as HTMLElement;
    errEl.style.display = 'none';

    const name = (document.getElementById('leadName') as HTMLInputElement).value.trim();
    const email = (document.getElementById('leadEmail') as HTMLInputElement).value.trim();
    const phone = (document.getElementById('leadPhone') as HTMLInputElement).value.trim();
    const questions = [0, 1, 2]
      .map((i) => (document.getElementById(`qInput${i}`) as HTMLInputElement)?.value.trim())
      .filter(Boolean);

    btn.disabled = true;
    const spanText = btn.querySelector('[data-audit-i18n="runAiBtn"]');
    if (spanText) spanText.textContent = I18N[currentLang].runAiBtnLoading;

    try {
      const res = await fetch(`${WORKER_BASE}/audit/ai-visibility`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          audit_id: currentAudit.id,
          name,
          email,
          phone,
          questions,
          city: currentAudit.city,
          service: currentAudit.service,
        }),
      });
      const json = await res.json();

      if (!json.success || !json.data) {
        throw new Error(json.error?.message || 'Unable to run AI visibility check');
      }

      currentAudit = json.data;
      renderAiVisibility(currentAudit);
    } catch (err: any) {
      errEl.textContent = err.message || 'Unable to run live AI check.';
      errEl.style.display = 'block';
    } finally {
      btn.disabled = false;
      if (spanText) spanText.textContent = I18N[currentLang].runAiBtn;
    }
  });

  // Handle $99 Full Audit Stripe Checkout
  document.getElementById('btnBuyFullAudit')?.addEventListener('click', async () => {
    if (!currentAudit) return;
    const btn = document.getElementById('btnBuyFullAudit') as HTMLButtonElement;
    const spanText = btn.querySelector('[data-audit-i18n="buyBtn"]');
    const email = (document.getElementById('leadEmail') as HTMLInputElement)?.value.trim();

    btn.disabled = true;
    if (spanText) spanText.textContent = I18N[currentLang].buyBtnLoading;

    try {
      const res = await fetch(`${WORKER_BASE}/create-checkout-session`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          type: 'aeo_full_audit',
          client_email: email || undefined,
          audit_id: currentAudit.id,
          domain: currentAudit.domain,
          city: currentAudit.city,
          service: currentAudit.service,
          lang: currentLang,
          success_url: `${window.location.origin}/success?session_id={CHECKOUT_SESSION_ID}&type=aeo_audit`,
          cancel_url: window.location.href,
        }),
      });

      const json = await res.json();
      if (json.success && json.data?.checkout_url) {
        window.location.href = json.data.checkout_url;
      } else {
        alert(json.error?.message || 'Unable to start Stripe Checkout');
        btn.disabled = false;
        if (spanText) spanText.textContent = I18N[currentLang].buyBtn;
      }
    } catch (err: any) {
      alert(err.message || 'Connection error reaching Stripe Checkout');
      btn.disabled = false;
      if (spanText) spanText.textContent = I18N[currentLang].buyBtn;
    }
  });

  // Pre-fill from query params if linked from another page
  (function initFromQuery() {
    const q = new URLSearchParams(window.location.search);
    const qUrl = q.get('url');
    const qName = q.get('name');
    const qEmail = q.get('email');
    const qPhone = q.get('phone');
    const qCity = q.get('city');
    const qService = q.get('service');

    const urlInp = document.getElementById('auditUrl') as HTMLInputElement | null;
    const nameInp = document.getElementById('leadName') as HTMLInputElement | null;
    const emailInp = document.getElementById('leadEmail') as HTMLInputElement | null;
    const phoneInp = document.getElementById('leadPhone') as HTMLInputElement | null;
    const cityInp = document.getElementById('auditCity') as HTMLInputElement | null;
    const serviceInp = document.getElementById('auditService') as HTMLInputElement | null;

    if (qUrl && urlInp) urlInp.value = qUrl;
    if (qName && nameInp) nameInp.value = qName;
    if (qEmail && emailInp) emailInp.value = qEmail;
    if (qPhone && phoneInp) phoneInp.value = qPhone;
    if (qCity && cityInp) cityInp.value = qCity;
    if (qService && serviceInp) serviceInp.value = qService;

    if (qUrl && qName && qEmail && qPhone) {
      const form = document.getElementById('formAuditIntake') as HTMLFormElement | null;
      form?.requestSubmit();
    }
  })();
</script>

