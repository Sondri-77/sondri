---
import { BOOK_HREF, CONTACT_EMAIL, mailto } from '../data';

interface Props {
  defaultLang?: 'en' | 'es';
  embedded?: boolean;
}

const { defaultLang = 'en', embedded = false } = Astro.props;
---

<div id="mini-audit" data-default-lang={defaultLang} data-embedded={embedded ? 'true' : 'false'}>
  <!-- SECTION 1: HERO & UNIFIED INTAKE FORM (on-dark) -->
  <section class="section section-pad on-dark" id={embedded ? 'free-check' : undefined}>
    <div class="wrap">
      {!embedded && (
        <div class="top-bar">
          <a href="/" class="label back-link">← <span data-audit-i18n="backHome">Back to Sondri</span></a>
          <div class="lang-switch" role="group" aria-label="Audit language">
            <button type="button" class="lang-btn active" data-set-lang="en">EN (US)</button>
            <button type="button" class="lang-btn" data-set-lang="es">ES (Chile)</button>
          </div>
        </div>
      )}

      <div class="sec-head">
        <div>
          {embedded ? (
            <h2 class="h2">
              <span data-audit-i18n="title">Does AI name your business when a buyer asks</span><span class="gdot">?</span>
            </h2>
          ) : (
            <h1 class="h2">
              <span data-audit-i18n="title">Does AI name your business when a buyer asks</span><span class="gdot">?</span>
            </h1>
          )}
        </div>
        <div class="intro">
          <p class="lede" data-audit-i18n="subtitle">
            Enter your website and contact details to run a free technical AI readiness scan, check your Google Lighthouse base health, and test 3 unbranded buyer questions.
          </p>
        </div>
      </div>

      <form id="formAuditIntake" class="intake-form">
        <div class="intake-grid">
          <div class="field">
            <label for="auditUrl" class="label" data-audit-i18n="urlLabel">Website URL *</label>
            <input
              type="text"
              id="auditUrl"
              class="form-input"
              placeholder="yourcompany.com"
              required
              autocomplete="url"
            />
          </div>

          <div class="field">
            <label for="auditService" class="label" data-audit-i18n="serviceLabel">Primary service (optional)</label>
            <input
              type="text"
              id="auditService"
              name="target_service_custom"
              class="form-input"
              placeholder="e.g. Workflow automation, B2B SaaS, Dental clinic"
              autocomplete="off"
              data-lpignore="true"
              data-1p-ignore="true"
            />
          </div>

          <div class="field">
            <label for="auditCity" class="label" data-audit-i18n="cityLabel">Target market (optional)</label>
            <input
              type="text"
              id="auditCity"
              name="target_market_custom"
              class="form-input"
              placeholder="Defaults to United States / Global"
              autocomplete="off"
              data-lpignore="true"
              data-1p-ignore="true"
            />
          </div>

          <div class="field">
            <label for="leadName" class="label" data-audit-i18n="nameLabel">Your full name *</label>
            <input
              type="text"
              id="leadName"
              class="form-input"
              placeholder="Alex Rivera"
              required
              autocomplete="name"
            />
          </div>

          <div class="field">
            <label for="leadEmail" class="label" data-audit-i18n="emailLabel">Work email *</label>
            <input
              type="email"
              id="leadEmail"
              class="form-input"
              placeholder="you@company.com"
              required
              autocomplete="email"
            />
          </div>

          <div class="field">
            <label for="leadPhone" class="label" data-audit-i18n="phoneLabel">Phone / WhatsApp *</label>
            <input
              type="tel"
              id="leadPhone"
              class="form-input"
              placeholder="+1 555 234 5678"
              required
              autocomplete="tel"
            />
          </div>
        </div>

        <div class="intake-actions">
          <button type="submit" id="btnScan" class="btn btn-gold">
            <span data-audit-i18n="scanBtn">Run My Free AI Visibility Audit</span> <span class="arr">→</span>
          </button>
          <span class="label" data-audit-i18n="scanHint">
            Unbranded buyer prompts · Crawler & schema check · Google Lighthouse included
          </span>
        </div>

        <p id="scanError" class="error-banner" style="display: none;"></p>
      </form>
    </div>
  </section>

  <!-- RESULTS WRAPPER (Hidden until scan runs) -->
  <div id="auditReportContainer" style="display: none;">
    <!-- SECTION 2: TECHNICAL AI READINESS & LIGHTHOUSE (on-off) -->
    <section class="section section-pad on-off" id="techSection">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <h2 class="h2" id="detectedBrandTitle">Website Readiness<span class="gdot">.</span></h2>
          </div>
          <div class="intro report-head-actions">
            <p class="lede" id="detectedMetaLine"></p>
            <button type="button" id="btnDownloadPdf" class="btn btn-ghost-dark">
              <span data-audit-i18n="downloadPdfBtn">Download Audit PDF</span> <span class="arr">↓</span>
            </button>
          </div>
        </div>

        <!-- 3 KPI Columns: AI Readiness, Lighthouse SEO, Mobile Speed -->
        <div class="rule-cols cols-3 kpi-row">
          <div>
            <p class="label k-idx" data-audit-i18n="kpiReadiness">Technical AI Readiness</p>
            <p class="n kpi" id="readinessBadge">--</p>
            <p class="body-s" data-audit-i18n="kpiReadinessDesc">
              Based on AI crawler access, structured data (Organization/LocalBusiness & FAQPage), and clear entity signals.
            </p>
          </div>

          <div>
            <p class="label k-idx" data-audit-i18n="lhSeoLabel">Google Lighthouse SEO</p>
            <p class="n kpi" id="lhSeoScore">…</p>
            <p class="body-s" id="lhCrawlableLine" data-audit-i18n="lhSeoDesc">
              Checking mobile crawlability and baseline search indexability via Google PageSpeed Insights.
            </p>
          </div>

          <div>
            <p class="label k-idx" data-audit-i18n="lhPerfLabel">Mobile Speed (Lighthouse)</p>
            <p class="n kpi" id="lhPerfScore">…</p>
            <p class="body-s" id="lhExtraMetrics" data-audit-i18n="lhPerfDesc">
              Running live Google Lighthouse mobile performance check…
            </p>
          </div>
        </div>

        <!-- Extended Google PageSpeed Insights & Core Web Vitals Panel -->
        <div class="rule-cols cols-2 detail-cols" id="lhDetailsPanel" style="display: none;">
          <div>
            <h3 class="h5 detail-heading" data-audit-i18n="cwvTitle">Google PageSpeed & Core Web Vitals</h3>
            <div class="signal-list" id="lhMetricsGrid"></div>
          </div>

          <div>
            <h3 class="h5 detail-heading" data-audit-i18n="lhDiagTitle">Lighthouse opportunities & diagnostics</h3>
            <div class="signal-list" id="lhDiagGrid"></div>
          </div>
        </div>

        <!-- 2 Columns: Schema/Signals & AI Bots -->
        <div class="rule-cols cols-2 detail-cols">
          <div>
            <h3 class="h5 detail-heading" data-audit-i18n="signalsTitle">Structured data & site signals</h3>
            <div class="signal-list" id="techCheckGrid"></div>
          </div>

          <div>
            <h3 class="h5 detail-heading" data-audit-i18n="botsTitle">AI search crawlers (robots.txt)</h3>
            <div class="bot-list" id="botChips"></div>

            <div class="gaps-wrap" id="gapsBlock" style="display: none;">
              <h4 class="label gaps-heading" data-audit-i18n="gapsTitle">Priority technical gaps</h4>
              <ul class="gaps-list" id="gapsList"></ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: UNBRANDED BUYER QUESTIONS & LIVE AI VISIBILITY (on-paper) -->
    <section class="section section-pad on-paper" id="aiSection">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <h2 class="h2">
              <span data-audit-i18n="aiReportTitle">Unbranded buyer questions</span><span class="gdot">.</span>
            </h2>
          </div>
          <div class="intro">
            <p class="lede" data-audit-i18n="aiReportLede">
              We test targeted buyer-intent questions generated from your website copy without naming your brand—measuring whether AI recommends you or your competitors.
            </p>
          </div>
        </div>

        <div class="rule-cols cols-3 kpi-row">
          <div>
            <p class="label k-idx" data-audit-i18n="statNamed">Answers naming you</p>
            <p class="n kpi" id="statNamedVal">0/3</p>
            <p class="body-s" data-audit-i18n="statNamedSub">
              Out of 3 unbranded buyer questions run once on Gemini.
            </p>
          </div>

          <div>
            <p class="label k-idx" data-audit-i18n="statCited">Answers citing your site</p>
            <p class="n kpi" id="statCitedVal">0/3</p>
            <p class="body-s" data-audit-i18n="statCitedSub">
              Times your domain appeared in the grounded web sources.
            </p>
          </div>

          <div>
            <p class="label k-idx" data-audit-i18n="statCompetitors">Named instead & sources cited</p>
            <div class="summary-lists">
              <div>
                <span class="label" data-audit-i18n="compSubLabel">Competitors named:</span>
                <p class="body-s strong-text" id="competitorsCloud">—</p>
              </div>
              <div>
                <span class="label" data-audit-i18n="srcSubLabel">Sources cited:</span>
                <p class="body-s strong-text" id="sourcesCloud">—</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Question Breakdown List -->
        <div class="runs-ledger" id="runsList"></div>

        <p class="body-s method-note" id="notRunNote"></p>
      </div>
    </section>

    <!-- SECTION 4: $99 FULL AUDIT UPGRADE (on-dark) -->
    <section class="section section-pad on-dark" id="upgradeSection">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <h2 class="h2">
              <span data-audit-i18n="upgradeTitle">Get the full 15-question audit across ChatGPT, Gemini & Google AI</span><span class="gdot">.</span>
            </h2>
          </div>
          <div class="intro">
            <p class="lede" data-audit-i18n="upgradeDesc">
              A single API check is only a snapshot—AI answers change from run to run and differ when logged out. In our Full Audit, we run 12 to 15 unbranded buyer questions 3 times per engine across ChatGPT, Gemini, Google AI Overviews, and Google AI Mode, verify whether the AI describes your business accurately, and hand you a prioritized fix list.
            </p>
          </div>
        </div>

        <div class="rule-cols cols-2 upgrade-ledger">
          <div>
            <p class="label k-idx" data-audit-i18n="cmpFreeHead">Free Snapshot (Above)</p>
            <ul class="ledger-list">
              <li data-audit-i18n="cmpFree1">3 unbranded buyer questions</li>
              <li data-audit-i18n="cmpFree2">1 API check per question on Gemini Search Grounding</li>
              <li data-audit-i18n="cmpFree3">Automated homepage, crawler, schema & Lighthouse check</li>
            </ul>
          </div>

          <div>
            <p class="label k-idx" data-audit-i18n="cmpPaidHead">Full AEO / GEO Audit ($99 USD)</p>
            <ul class="ledger-list highlight-list">
              <li data-audit-i18n="cmpPaid1">12 to 15 unbranded buyer questions × 3 runs per engine (36–45 checks per engine)</li>
              <li data-audit-i18n="cmpPaid2">Measured on ChatGPT, Gemini, Google AI Overviews & Google AI Mode (logged out)</li>
              <li data-audit-i18n="cmpPaid3">Complete competitor & source citation map + factual accuracy review</li>
              <li data-audit-i18n="cmpPaid4">Prioritized fix list (service pages, FAQs, schema, Google Business Profile, citations)</li>
            </ul>
          </div>
        </div>

        <div class="checkout-bar">
          <div class="price-block">
            <span class="label" data-audit-i18n="priceLabel">Fixed one-time audit</span>
            <p class="price-kpi kpi">$99 <span class="cur">USD</span></p>
            <p class="body-s" data-audit-i18n="priceDisclaimer">
              We do not promise rankings or percentages. We measure and report change with the same method every time.
            </p>
          </div>

          <div class="checkout-action">
            <button type="button" id="btnBuyFullAudit" class="btn btn-gold">
              <span data-audit-i18n="buyBtn">Order Full 15-Question Audit ($99)</span> <span class="arr">→</span>
            </button>
            <span class="label" data-audit-i18n="stripeNote">
              Encrypted Stripe Checkout · Instant PDF tax invoice
            </span>
            <div class="audit-talk-row">
              <a href={BOOK_HREF} class="label audit-talk-link" data-audit-i18n="talkCallLink">
                Walk through my score (15-min call) →
              </a>
              <a
                id="auditEmailDomainLink"
                href={mailto('Review my Sondri Watch AI score')}
                class="label audit-talk-link"
                data-audit-i18n="talkEmailLink"
              >
                Email us this domain →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  const WORKER_BASE =
    window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
      ? 'http://localhost:8787'
      : 'https://billing.sondri.ai';

  const I18N: Record<'en' | 'es', Record<string, string>> = {
    en: {
