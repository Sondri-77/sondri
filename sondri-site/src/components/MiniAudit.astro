      subtitle:
        'Ingrese su sitio web y sus datos para ejecutar una revisión técnica gratuita para IA, medir Google Lighthouse y probar 3 preguntas reales de compra sin su marca.',
      urlLabel: 'Sitio web *',
      serviceLabel: 'Servicio principal (opcional)',
      cityLabel: 'Ciudad o comuna (opcional)',
      nameLabel: 'Nombre completo *',
      emailLabel: 'Correo de trabajo *',
      phoneLabel: 'Teléfono / WhatsApp *',
      scanBtn: 'Ejecutar Diagnóstico Gratuito de IA',
      scanBtnLoading: 'Analizando sitio y consultando IA…',
