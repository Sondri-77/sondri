  <div class="page-wrap">
    <div class="no-print-bar">
      <button class="print-btn" onclick="window.print()">${isEs ? 'Guardar como PDF / Imprimir' : 'Save as PDF / Print'}</button>
    </div>

    <div class="header">
      <div>
        <div class="brand-tag">SONDRI.AI · AEO &amp; GEO VISIBILITY AUDIT REPORT</div>
        <h1>${escapeHtml(scan.detectedBrand || audit.domain)}</h1>
        <div class="sub">${escapeHtml(audit.url)} · ${escapeHtml(audit.service || '')}</div>
      </div>
      <div class="meta-right">
        <div>DATE: ${escapeHtml(dateStr)}</div>
        <div>MARKET: ${escapeHtml(audit.city || 'United States')}</div>
        <div>AUDIT ID: ${escapeHtml(audit.id)}</div>
      </div>
    </div>

    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-label">${isEs ? 'Preparación IA' : 'AI Readiness Score'}</div>
        <div class="kpi-val">${escapeHtml(scan.readinessScore)}/100</div>
        <div class="kpi-note">${isEs ? 'Schema, bots y entidad' : 'Crawlers, schema & entity'}</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Lighthouse SEO</div>
        <div class="kpi-val">${lh.seoScore != null ? `${escapeHtml(lh.seoScore)}/100` : 'N/A'}</div>
        <div class="kpi-note">${lh.isCrawlable === false ? 'Blocked from indexing' : 'Indexable & crawlable'}</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">${isEs ? 'Velocidad Móvil' : 'Mobile Speed'}</div>
        <div class="kpi-val">${lh.performanceScore != null ? `${escapeHtml(lh.performanceScore)}/100` : 'N/A'}</div>
        <div class="kpi-note">${escapeHtml(lh.lcpDisplay ? `LCP: ${lh.lcpDisplay}` : 'Google PageSpeed v5')}</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">${isEs ? 'Menciones en IA' : 'AI Brand Mentions'}</div>
        <div class="kpi-val">${escapeHtml(ai.namedCount ?? 0)}/${escapeHtml(ai.totalQuestions ?? 3)}</div>
        <div class="kpi-note">${isEs ? `Citas web: ${escapeHtml(ai.citedCount ?? 0)}/${escapeHtml(ai.totalQuestions ?? 3)}` : `Domain cited: ${escapeHtml(ai.citedCount ?? 0)}/${escapeHtml(ai.totalQuestions ?? 3)}`}</div>
      </div>
    </div>

    <div class="meta-summary">
      <p><strong>${isEs ? 'Título detectado:' : 'Detected Title Tag:'}</strong> ${escapeHtml(scan.title || '—')}</p>
      <p><strong>${isEs ? 'Meta descripción:' : 'Meta Description:'}</strong> ${escapeHtml(scan.metaDescription || '—')}</p>
      <p><strong>${isEs ? 'Encabezado H1:' : 'Primary H1:'}</strong> ${escapeHtml((scan.h1s || []).join(' | ') || '—')}</p>
    </div>

    ${
      gapsList.length > 0
        ? `<div class="gaps-box">
            <h4>${isEs ? 'Brechas Técnicas Prioritarias' : 'Priority Technical Gaps Detected'}</h4>
            <ul>${gapsList.map((g: string) => `<li>${escapeHtml(g)}</li>`).join('')}</ul>
          </div>`
        : ''
    }

    <div class="sec-title">01 · ${isEs ? 'Señales Estructuradas y Rastreadores de IA' : 'Technical AEO Signals & AI Crawler Access (robots.txt)'}</div>
    <div class="two-col">
      <div class="box">
        <h3>${isEs ? 'Datos Estructurados y Señales' : 'Structured Data & Site Signals'}</h3>
        <table class="data-table">
          ${signalRows
            .map(
              (r) => `<tr>
                <td>${escapeHtml(r.name)}</td>
                <td class="val ${r.ok ? 'ok' : 'miss'}">${escapeHtml(r.status)}</td>
              </tr>`
            )
            .join('')}
        </table>
      </div>
      <div class="box">
        <h3>${isEs ? 'Acceso de Rastreadores IA' : 'AI Search Crawlers (robots.txt)'}</h3>
        <table class="data-table">
          ${botRows
            .map(
              (r: any) => `<tr>
                <td>${escapeHtml(r.name)}</td>
                <td class="val ${r.ok ? 'ok' : 'miss'}">${escapeHtml(r.status)}</td>
              </tr>`
            )
            .join('')}
        </table>
      </div>
    </div>

    <div class="sec-title">02 · Google PageSpeed Insights &amp; Core Web Vitals (Mobile)</div>
    <div class="two-col">
      <div class="box">
        <h3>${isEs ? 'Métricas de Rendimiento y Core Web Vitals' : 'Lighthouse Scores & Core Web Vitals'}</h3>
        <table class="data-table">
          ${cwvRows
            .map(
              (r) => `<tr>
                <td>${escapeHtml(r.name)}</td>
                <td class="val">${escapeHtml(r.val)}</td>
              </tr>`
            )
            .join('')}
        </table>
      </div>
      <div class="box">
        <h3>${isEs ? 'Oportunidades y Diagnósticos Lighthouse' : 'Lighthouse Opportunities & Diagnostics'}</h3>
        <table class="data-table">
          ${
            diagList.length > 0
              ? diagList
                  .map(
                    (d: any) => `<tr>
                      <td>${escapeHtml(d.title)}${d.displayValue ? ` <span style="color:#526c71">(${escapeHtml(d.displayValue)})</span>` : ''}</td>
                      <td class="val ${d.score >= 50 ? 'warn' : 'miss'}">${escapeHtml(d.score)}/100</td>
                    </tr>`
                  )
                  .join('')
              : `<tr><td>${isEs ? 'Sin cuellos de botella críticos detectados.' : 'No critical bottlenecks flagged in primary checks.'}</td><td class="val ok">PASS</td></tr>`
          }
        </table>
      </div>
    </div>

    <div class="sec-title">03 · ${isEs ? 'Preguntas de Compra Sin Marca y Respuestas de IA' : 'Unbranded Buyer Questions & Live AI Visibility'}</div>
    <div class="meta-summary">
      <p><strong>${isEs ? 'Competidores nombrados en su lugar:' : 'Competitors Named Instead:'}</strong> ${escapeHtml((ai.competitorsSummary || []).join(', ') || 'None')}</p>
      <p><strong>${isEs ? 'Dominios y fuentes citadas:' : 'Reference Domains Cited:'}</strong> ${escapeHtml((ai.topSourceDomains || []).join(' · ') || 'None')}</p>
    </div>

    ${runs
      .map(
        (r: any, idx: number) => `<div class="run-card">
          <div class="run-head">
            <div class="run-q">Q0${idx + 1}. ${escapeHtml(r.question)}</div>
            <span class="badge ${r.brandNamed ? 'ok' : 'miss'}">${
              r.brandNamed ? (isEs ? 'TE NOMBRA' : 'NAMED') : isEs ? 'NO TE NOMBRA' : 'NOT NAMED'
            }</span>
          </div>
          <div class="run-ans">${escapeHtml(r.answerExcerpt)}</div>
          <div class="run-foot">
            <strong>${isEs ? 'Competidores:' : 'Named instead:'}</strong> ${escapeHtml((r.competitorsNamed || []).join(', ') || '—')}
            &nbsp;|&nbsp;
            <strong>${isEs ? 'Fuentes:' : 'Sources:'}</strong> ${escapeHtml(
              (r.sourcesCited || []).map((s: any) => s.title || s.domain).join(', ') || '—'
            )}
          </div>
        </div>`
      )
      .join('')}

    <div class="footer-cta">
      <div>
        <h4>${isEs ? 'Auditoría Completa AEO / GEO de 15 Preguntas ($99 USD)' : 'Full 15-Question Multi-Engine AEO / GEO Audit ($99 USD)'}</h4>
        <p>${
          isEs
            ? '12–15 preguntas sin marca × 3 repeticiones en ChatGPT, Gemini, Google AI Overviews y Google AI Mode + plan de acción priorizado.'
            : '12–15 unbranded buyer questions × 3 runs across ChatGPT, Gemini, Google AI Overviews & Google AI Mode + prioritized fix roadmap.'
        }</p>
      </div>
      <div class="meta-right">sondri.ai/ai-audit</div>
    </div>
  </div>
  <script>
    window.addEventListener('load', function () {
      setTimeout(function () { window.print(); }, 250);
    });
  <\/script>
</body>
</html>`;

    const win = window.open('', '_blank');
    if (win) {
      win.opener = null;
      win.document.open();
      win.document.write(html);
      win.document.close();
    }
  }

  document.getElementById('btnDownloadPdf')?.addEventListener('click', () => {
    if (currentAudit) {
      openAuditPdfReport(currentAudit, currentLang);
    }
  });

  // Handle $99 Full Audit Stripe Checkout
  function syncEmailAuditLink(audit: any) {
    const emailLink = document.getElementById('auditEmailDomainLink') as HTMLAnchorElement | null;
    if (!emailLink || !audit) return;
    const dom = audit.domain || audit.url || '';
    const score = typeof audit.readinessScore === 'number' ? `${audit.readinessScore}/100` : '';
    const isEs = currentLang === 'es';
    const subj = isEs
      ? `Revisión Sondri Watch para ${dom || 'mi sitio web'}`
      : `Sondri Watch review for ${dom || 'my website'}`;
    const body = isEs
      ? `Hola equipo Sondri,\n\nAcabo de revisar ${dom} en Sondri Watch${score ? ` (puntaje ${score})` : ''} y me gustaría conversar sobre los siguientes pasos.\n`
      : `Hi Sondri team,\n\nI just scanned ${dom} on Sondri Watch${score ? ` (score ${score})` : ''} and would like to walk through next steps.\n`;
    emailLink.href = `mailto:sales@sondri.ai?subject=${encodeURIComponent(subj)}&body=${encodeURIComponent(body)}`;
  }

  document.getElementById('btnBuyFullAudit')?.addEventListener('click', async () => {
    const name = (document.getElementById('leadName') as HTMLInputElement)?.value.trim() || '';
    const email = (document.getElementById('leadEmail') as HTMLInputElement)?.value.trim() || '';
    const phone = (document.getElementById('leadPhone') as HTMLInputElement)?.value.trim() || '';
    const cityVal = (document.getElementById('auditCity') as HTMLInputElement)?.value.trim() || '';
    const serviceVal = (document.getElementById('auditService') as HTMLInputElement)?.value.trim() || '';
    const domainVal = currentAudit?.domain || (document.getElementById('auditUrl') as HTMLInputElement)?.value.trim() || '';

    if (document.getElementById('watchCheckoutDialog')) {
      window.dispatchEvent(
        new CustomEvent('sondri:open-checkout', {
          detail: {
            sku: 'aeo_full_audit',
            prefill: {
              audit_id: currentAudit?.id || '',
              name,
              email,
              phone,
              domain: domainVal,
              city: currentAudit?.city || cityVal,
              service: currentAudit?.service || serviceVal,
            },
          },
        })
      );
      return;
    }

    if (!currentAudit) return;
    const btn = document.getElementById('btnBuyFullAudit') as HTMLButtonElement;
    const spanText = btn.querySelector('[data-audit-i18n="buyBtn"]');

    btn.disabled = true;
    if (spanText) spanText.textContent = I18N[currentLang].buyBtnLoading;

    try {
      const res = await fetch(`${WORKER_BASE}/create-checkout-session`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          type: 'aeo_full_audit',
          client_name: name || undefined,
          client_email: email || undefined,
          client_phone: phone || undefined,
          audit_id: currentAudit.id,
          domain: currentAudit.domain,
          city: currentAudit.city,
          service: currentAudit.service,
          lang: currentLang,
          success_url: `${window.location.origin}/success?session_id={CHECKOUT_SESSION_ID}&type=aeo_audit`,
          cancel_url: window.location.href,
        }),
      });

      const json = await res.json();
      if (json.success && json.data?.checkout_url) {
        window.location.href = json.data.checkout_url;
      } else {
        alert(json.error?.message || 'Unable to start Stripe Checkout');
        btn.disabled = false;
        if (spanText) spanText.textContent = I18N[currentLang].buyBtn;
      }
    } catch (err: any) {
      alert(err.message || 'Connection error reaching Stripe Checkout');
      btn.disabled = false;
      if (spanText) spanText.textContent = I18N[currentLang].buyBtn;
    }
  });

  // Pre-fill from query params if linked from another page
  (function initFromQuery() {
    const q = new URLSearchParams(window.location.search);
    const qUrl = q.get('url');
    const qName = q.get('name');
    const qEmail = q.get('email');
    const qPhone = q.get('phone');
    const qCity = q.get('city');
    const qService = q.get('service');

    const urlInp = document.getElementById('auditUrl') as HTMLInputElement | null;
    const nameInp = document.getElementById('leadName') as HTMLInputElement | null;
    const emailInp = document.getElementById('leadEmail') as HTMLInputElement | null;
    const phoneInp = document.getElementById('leadPhone') as HTMLInputElement | null;
    const cityInp = document.getElementById('auditCity') as HTMLInputElement | null;
    const serviceInp = document.getElementById('auditService') as HTMLInputElement | null;

    if (qUrl && urlInp) urlInp.value = qUrl;
    if (qName && nameInp) nameInp.value = qName;
    if (qEmail && emailInp) emailInp.value = qEmail;
    if (qPhone && phoneInp) phoneInp.value = qPhone;
    if (qCity && cityInp) cityInp.value = qCity;
    if (qService && serviceInp) serviceInp.value = qService;
  })();
</script>

