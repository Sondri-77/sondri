---
interface Props {
  defaultLang?: 'en' | 'es';
}

const { defaultLang = 'en' } = Astro.props;
---

<section class="section section-pad on-dark audit-section" id="mini-audit" data-default-lang={defaultLang}>
  <div class="wrap">
    <div class="sec-head audit-head">
      <div class="kick-row">
        <span class="chip"><span class="gdot">■</span> <span data-audit-i18n="kicker">Free AEO / GEO Snapshot</span></span>
        <div class="lang-switch" role="group" aria-label="Audit language">
          <button type="button" class="lang-btn active" data-set-lang="en">EN (US)</button>
          <button type="button" class="lang-btn" data-set-lang="es">ES (Chile)</button>
        </div>
      </div>
      <h1 class="h2">
        <span data-audit-i18n="title">Does AI name your business when buyers ask</span><span class="gdot">?</span>
      </h1>
      <p class="lede" data-audit-i18n="subtitle">
        Enter your website to check whether AI search crawlers can read your site, inspect your structured data and Google Lighthouse base health, and run 3 unbranded buyer questions with live search grounding.
      </p>
    </div>

    <!-- STEP 1 FORM: URL + optional service/city -->
    <div class="panel audit-card">
      <form id="formStep1" class="audit-form">
        <div class="form-grid">
          <div class="form-group form-group-url">
            <label for="auditUrl" class="label" data-audit-i18n="urlLabel">Website URL *</label>
            <input
              type="text"
              id="auditUrl"
              class="form-input"
              placeholder="yourcompany.com"
              required
              autocomplete="url"
            />
          </div>

          <div class="form-group">
            <label for="auditService" class="label" data-audit-i18n="serviceLabel">Primary service (optional)</label>
            <input
              type="text"
              id="auditService"
              class="form-input"
              placeholder="e.g. Dental clinic, B2B SaaS, HVAC"
            />
          </div>

          <div class="form-group">
            <label for="auditCity" class="label" data-audit-i18n="cityLabel">City / market (optional)</label>
            <input
              type="text"
              id="auditCity"
              class="form-input"
              placeholder="e.g. Austin, TX or Concón, Chile"
            />
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" id="btnScan" class="btn btn-gold">
            <span data-audit-i18n="scanBtn">Run Free Technical & AI Readiness Scan</span> <span class="arr">→</span>
          </button>
          <span class="label meta-hint" data-audit-i18n="scanHint">
            <span class="gdot">■</span> Instant technical scan · Unbranded prompts · No rankings promised
          </span>
        </div>

        <p id="scanError" class="error-banner" style="display: none;"></p>
      </form>
    </div>

    <!-- STEP 1 RESULTS: Technical Scan + Async Lighthouse + Step 2 Prompt/Email Gate -->
    <div id="step1Results" class="results-stack" style="display: none;">
      <div class="grid-2">
        <!-- Left card: Technical AI Readiness -->
        <div class="panel result-card">
          <div class="card-top">
            <span class="label" data-audit-i18n="techCardKicker">/ 01 · Technical AI Readiness</span>
            <span id="readinessBadge" class="score-pill">-- / 100</span>
          </div>
          <h2 class="h4" id="detectedBrandTitle">Website Readiness</h2>
          <p class="body-s muted-line" id="detectedMetaLine"></p>

          <div class="check-grid" id="techCheckGrid"></div>

          <div class="sub-block">
            <p class="label sub-title" data-audit-i18n="botsTitle">AI Search Crawlers (robots.txt)</p>
            <div class="bot-chips" id="botChips"></div>
          </div>

          <div class="sub-block" id="gapsBlock" style="display: none;">
            <p class="label sub-title" data-audit-i18n="gapsTitle">Priority technical gaps found</p>
            <ul class="gaps-list" id="gapsList"></ul>
          </div>
        </div>

        <!-- Right card: Google Lighthouse Base Health (Async) -->
        <div class="panel result-card">
          <div class="card-top">
            <span class="label" data-audit-i18n="lhCardKicker">/ 02 · Base Web & SEO Health (Lighthouse)</span>
            <span id="lhStatusBadge" class="chip">Running PageSpeed…</span>
          </div>
          <h3 class="h4" data-audit-i18n="lhTitle">Crawlability & mobile speed</h3>
          <p class="body-s muted-line" data-audit-i18n="lhSubtitle">
            AI engines rely on fast, indexable web pages as their base—but high SEO scores alone do not mean AI answers name your business.
          </p>

          <div class="lh-meters" id="lhMeters">
            <div class="lh-box">
              <span class="label" data-audit-i18n="lhSeoLabel">Lighthouse SEO</span>
              <strong class="lh-num" id="lhSeoScore">…</strong>
            </div>
            <div class="lh-box">
              <span class="label" data-audit-i18n="lhPerfLabel">Mobile Performance</span>
              <strong class="lh-num" id="lhPerfScore">…</strong>
            </div>
            <div class="lh-box">
              <span class="label" data-audit-i18n="lhCrawlLabel">Indexable</span>
              <strong class="lh-num" id="lhCrawlable">…</strong>
            </div>
          </div>

          <p class="body-s muted-line" id="lhExtraMetrics"></p>
        </div>
      </div>

      <!-- STEP 2 GATE: Confirm 3 Unbranded Buyer Questions + Email -->
      <div class="panel audit-card step2-card" id="step2GateCard">
        <div class="card-top">
          <span class="label" data-audit-i18n="step2Kicker">/ 03 · Live AI Answer Check (Unbranded Prompts)</span>
          <span class="chip"><span class="gdot">■</span> Gemini + Google Search Grounding</span>
        </div>
        <h3 class="h4" data-audit-i18n="step2Title">Check whether AI names you or your competitors</h3>
        <p class="body-s muted-line" data-audit-i18n="step2Desc">
          We ask 3 buyer questions without your brand name. You can edit the questions below before running the live check.
        </p>

        <form id="formStep2" class="audit-form">
          <div class="questions-edit-list">
            <div class="form-group">
              <label for="qInput0" class="label"><span class="gdot">01</span> <span data-audit-i18n="qLabel">Unbranded buyer question</span></label>
              <input type="text" id="qInput0" class="form-input" required />
            </div>
            <div class="form-group">
              <label for="qInput1" class="label"><span class="gdot">02</span> <span data-audit-i18n="qLabel">Unbranded buyer question</span></label>
              <input type="text" id="qInput1" class="form-input" required />
            </div>
            <div class="form-group">
              <label for="qInput2" class="label"><span class="gdot">03</span> <span data-audit-i18n="qLabel">Unbranded buyer question</span></label>
              <input type="text" id="qInput2" class="form-input" required />
            </div>
          </div>

          <div class="lead-fields-grid">
            <div class="form-group">
              <label for="leadName" class="label" data-audit-i18n="nameLabel">Your full name *</label>
              <input
                type="text"
                id="leadName"
                class="form-input"
                placeholder="Alex Rivera"
                required
                autocomplete="name"
              />
            </div>

            <div class="form-group">
              <label for="leadEmail" class="label" data-audit-i18n="emailLabel">Work email *</label>
              <input
                type="email"
                id="leadEmail"
                class="form-input"
                placeholder="you@company.com"
                required
                autocomplete="email"
              />
            </div>

            <div class="form-group">
              <label for="leadPhone" class="label" data-audit-i18n="phoneLabel">Phone / WhatsApp *</label>
              <input
                type="tel"
                id="leadPhone"
                class="form-input"
                placeholder="+1 555 234 5678"
                required
                autocomplete="tel"
              />
            </div>
          </div>

          <div class="email-gate-row">
            <button type="submit" id="btnRunAi" class="btn btn-gold btn-ai-submit">
              <span data-audit-i18n="runAiBtn">Run Live AI Visibility Check</span> <span class="arr">→</span>
            </button>
          </div>

          <p id="aiError" class="error-banner" style="display: none;"></p>
        </form>
      </div>
    </div>

    <!-- STEP 2 RESULTS: Live AI Gap Report + $99 Full Audit Upgrade -->
    <div id="step2Results" class="results-stack" style="display: none;">
      <div class="panel result-card">
        <div class="card-top">
          <span class="label" data-audit-i18n="aiReportKicker">/ 04 · Live AI Visibility Snapshot</span>
          <span class="chip" id="aiEngineBadge">Gemini + Google Search Grounding (1x run)</span>
        </div>

        <div class="summary-stats">
          <div class="stat-box">
            <span class="label" data-audit-i18n="statNamed">Answers naming you</span>
            <strong class="stat-big" id="statNamedVal">0 / 3</strong>
          </div>
          <div class="stat-box">
            <span class="label" data-audit-i18n="statCited">Answers citing your site</span>
            <strong class="stat-big" id="statCitedVal">0 / 3</strong>
          </div>
          <div class="stat-box">
            <span class="label" data-audit-i18n="statCompetitors">Competitors named instead</span>
            <div class="tag-cloud" id="competitorsCloud"></div>
          </div>
          <div class="stat-box">
            <span class="label" data-audit-i18n="statSources">Top sources AI cited</span>
            <div class="tag-cloud" id="sourcesCloud"></div>
          </div>
        </div>

        <div class="runs-list" id="runsList"></div>

        <div class="not-run-note" id="notRunNote"></div>
      </div>

      <!-- UPGRADE CTA: $99 FULL AUDIT -->
      <div class="panel upgrade-card">
        <div class="upgrade-copy">
          <span class="chip"><span class="gdot">■</span> <span data-audit-i18n="upgradeChip">Full AEO / GEO Audit — $99 USD</span></span>
          <h3 class="h3" data-audit-i18n="upgradeTitle">See the full picture across ChatGPT, Gemini & Google AI.</h3>
          <p class="lede upgrade-lede" data-audit-i18n="upgradeDesc">
            A single API check is only a snapshot—AI answers change from run to run and differ when logged out. In our Full Audit, we run 12 to 15 unbranded buyer questions 3 times per engine across ChatGPT, Gemini, Google AI Overviews, and Google AI Mode, verify whether the AI describes your business accurately, and hand you a prioritized fix list.
          </p>

          <div class="compare-mini">
            <div class="cmp-col">
              <p class="label cmp-head" data-audit-i18n="cmpFreeHead">Free Snapshot (Above)</p>
              <ul>
                <li data-audit-i18n="cmpFree1">3 unbranded buyer questions</li>
                <li data-audit-i18n="cmpFree2">1 API run on Gemini Search Grounding</li>
                <li data-audit-i18n="cmpFree3">Automated homepage + schema check</li>
              </ul>
            </div>
            <div class="cmp-col cmp-highlight">
              <p class="label cmp-head"><span class="gdot">■</span> <span data-audit-i18n="cmpPaidHead">Full Audit ($99 USD)</span></p>
              <ul>
                <li data-audit-i18n="cmpPaid1">12–15 buyer questions × 3 runs per engine (36–45 checks per engine)</li>
                <li data-audit-i18n="cmpPaid2">ChatGPT, Gemini, Google AI Overviews & Google AI Mode (logged out)</li>
                <li data-audit-i18n="cmpPaid3">Full competitor & cited-source breakdown + accuracy check</li>
                <li data-audit-i18n="cmpPaid4">Prioritized fix list (pages, FAQs, schema, Google Business Profile, citations)</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="upgrade-cta-box">
          <div class="price-display">
            <span class="label" data-audit-i18n="priceLabel">Fixed one-time audit</span>
            <strong class="price-big">$99 <span class="price-cur">USD</span></strong>
            <span class="body-s muted-line" data-audit-i18n="priceDisclaimer">
              We do not promise rankings or percentages. We measure and report change with the same method every time.
            </span>
          </div>

          <button type="button" id="btnBuyFullAudit" class="btn btn-gold btn-full">
            <span data-audit-i18n="buyBtn">Order Full 15-Question Audit ($99)</span> <span class="arr">→</span>
          </button>

          <span class="label pay- footnote" data-audit-i18n="stripeNote">
            <span class="gdot">■</span> Instant Stripe Checkout · PDF tax invoice included
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

