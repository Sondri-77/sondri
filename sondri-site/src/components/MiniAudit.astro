      priceDisclaimer:
        'We do not promise rankings or percentages. We measure and report change with the same method every time.',
      buyBtn: 'Order Full 15-Question Audit ($99)',
      buyBtnLoading: 'Redirecting to Stripe Checkout…',
      stripeNote: 'Encrypted Stripe Checkout · Instant PDF tax invoice',
    },
