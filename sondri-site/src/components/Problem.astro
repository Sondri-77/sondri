---
import { problem, problemStats } from '../home-data';
import { splitDot } from '../lib/dot';
const [h2, dot] = splitDot(problem.h2);
// Straight quotes in the copy string set as curly ones, and the quoted
// phrase never breaks: the closer is one line on desktop.
const [closeHead, closeTail] = problem.close.replace(/"([^"]+)"/, '\u201c$1\u201d').split(/(?=\u201c)/);
---

<!-- ProblemStats, re-headed: the three big numbers under the workbench copy. -->
<section class="section section-pad on-off">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2 class="h2">{h2}<span class="gdot">{dot}</span></h2>
      </div>
      <div class="intro">
        <p class="lede">{problem.lede}</p>
      </div>
    </div>

    <p class="h4 close">{closeHead}<span class="nb">{closeTail}</span></p>

    <div class="rule-cols cols-3 stats">
      {problemStats.map((s, i) => (
        <div data-reveal style={`transition-delay:${i * 80}ms`}>
          <p class="n h1">{s.n}</p>
          <p class="body-s">{s.label}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .stats > * { display: flex; flex-direction: column; gap: var(--s-16); }
  .n { font-size: clamp(48px, 5vw, 76px); color: var(--accent); }
  .body-s { max-width: 32ch; }
  .close { padding-bottom: var(--s-40); max-width: 40ch; }
  @media (min-width: 900px) { .close { white-space: nowrap; max-width: none; } }
  .nb { white-space: nowrap; }
</style>
