---
import { howItWorks, steps } from '../home-data';
import { splitDot } from '../lib/dot';
const [h2, dot] = splitDot(howItWorks.h2);
---

<!-- Feel, re-headed: three ruled steps. -->
<section class="section section-pad on-dark" id="how">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <h2 class="h2">{h2}<span class="gdot">{dot}</span></h2>
      </div>
      <div class="intro">
        <p class="lede">{howItWorks.lede}</p>
      </div>
    </div>

    <div class="rule-cols cols-3 feel">
      {steps.map((s, i) => (
        <div data-reveal style={`transition-delay:${i * 80}ms`}>
          <h3 class="h5">{s.t}</h3>
          <p class="body-s">{s.b}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feel > * { display: flex; flex-direction: column; gap: var(--s-16); }
  /* --pale, not the inherited --steel: on the teal field that is the
     brighter of the two body inks, and it matches the Knife section. */
  .body-s { max-width: 32ch; color: var(--pale); }
</style>
