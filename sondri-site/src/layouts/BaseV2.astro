---
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '../styles/theme.css';
import Nav from '../components/v2/Nav.astro';
import Footer from '../components/v2/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import PrivacyNotice from '../components/v2/PrivacyNotice.astro';
import { CONTACT_EMAIL } from '../data';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Sondri',
  url: 'https://sondri.ai',
  email: CONTACT_EMAIL,
  description: 'Software and automation for small and midsize companies, delivered simply.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#081f1f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sondri" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <PrivacyNotice />

    <script>
      import { initMotion } from '../scripts/motion-v2';
      // Re-init on every client-side navigation (fires on first load too).
      document.addEventListener('astro:page-load', () => initMotion());
    </script>
  </body>
</html>
