---
/* One layout for the site: <head> (canonical, sitemap, OG, enriched
   Organization + WebSite JSON-LD, Markdown/llms.txt alternates) over
   brutal's Nav, Footer and reveal script. */
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/brutal.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CalModal from '../components/CalModal.astro';
import { BOOK_HREF, CONTACT_EMAIL } from '../data';
import { copy } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** The i18n keys the <title> and description swap by (index's by default). */
  titleKey?: string;
  descriptionKey?: string;
  /** Set true on transactional / error pages (/pay, /success, 404). */
  noindex?: boolean;
  /** Omit canonical URL (used on 404). */
  omitCanonical?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  /** Relative path to this page's Markdown mirror (e.g. '/index.md'). */
  mdPath?: string;
}

const {
  title,
  description,
  titleKey = 'meta.title',
  descriptionKey = 'meta.description',
  noindex = false,
  omitCanonical = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  mdPath,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://sondri.ai';
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL('/og.png', siteUrl);
const logoUrl = new URL('/brand/avatars/sondri-avatar-512.png', siteUrl);
const mdHref = mdPath ? new URL(mdPath, siteUrl) : undefined;

const siteGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Sondri',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: logoUrl.href,
        width: 512,
        height: 512,
      },
      image: ogImage.href,
      email: CONTACT_EMAIL,
      description:
        'Custom software, workflow automation, and practical AI integration built into the systems small and midsize companies already run.',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'US',
      },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'sales',
          email: CONTACT_EMAIL,
          url: BOOK_HREF,
          availableLanguage: ['English', 'Spanish'],
        },
      ],
      areaServed: ['United States', 'Latin America'],
      knowsAbout: [
        'Workflow Automation',
        'Custom Business Software',
        'AI Integration',
        'Data & Reporting',
        'Customer Operations Automation',
        'Back Office Reconciliation',
        'Answer Engine Optimization',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Sondri',
      description: copy.en.meta.description,
      publisher: { '@id': `${siteUrl}/#organization` },
      inLanguage: ['en', 'es'],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Language, before paint: `?lang=` wins, then the saved choice, then
         English. Spanish hides the body until scripts/i18n.ts has swapped the
         strings, with a 1.5s safety fallback. No JS: English, as built. -->
    <script is:inline>
      (function () {
        try {
          var q = new URLSearchParams(location.search).get('lang');
          var l = q || localStorage.getItem('sondri.lang') || 'en';
          if (l === 'es') {
            document.documentElement.lang = 'es';
            document.documentElement.classList.add('i18n-pending');
            setTimeout(function () {
              document.documentElement.classList.remove('i18n-pending');
            }, 1500);
          }
        } catch (e) {}
      })();
    </script>
    <style>html.i18n-pending body { visibility: hidden; }</style>
    <title data-i18n={titleKey}>{title}</title>
    <meta name="description" content={description} data-i18n-attr={`content=${descriptionKey}`} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!omitCanonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#081f1f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="Sondri LLMs Context" href="/llms.txt" />
    {mdHref && <link rel="alternate" type="text/markdown" href={mdHref} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_US" />
    <meta property="og:site_name" content="Sondri" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteGraph)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main" data-i18n="ui.skip">{copy.en.ui.skip}</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <CalModal />

    <script>
      import '../scripts/i18n';
      // Linear reveal, one observer, no library.
      const els = document.querySelectorAll('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
