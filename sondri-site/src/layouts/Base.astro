---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieArtifact from '../components/CookieArtifact.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0C1A1A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sondri" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400..700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieArtifact />

    <script>
      import { initDither } from '../scripts/dither';
      import { initOrbit } from '../scripts/orbit';
      import { initForge } from '../scripts/orbit/forge';
      import { initPatrol } from '../scripts/orbit/patrol';
      import { initClimb } from '../scripts/orbit/climb';
      import {
        initReveals, initNeonSign, initConsent, initMobileNav,
        initWordReveals, initCountUps, initMagnetic,
      } from '../scripts/enhance';
      initOrbit(); // must run before initDither: it resolves the hero fallback
      initForge();
      initPatrol();
      initClimb();
      initReveals();
      initWordReveals();
      initCountUps();
      initMagnetic();
      initNeonSign();
      initConsent();
      initMobileNav();
      initDither();
    </script>

    <style>
      .skip {
        position: fixed;
        top: -60px;
        left: 16px;
        z-index: 100;
        font-size: 11px;
        letter-spacing: 2px;
        color: var(--ink);
        background: var(--gold);
        padding: 10px 16px;
        transition: top 0.2s;
      }
      .skip:focus { top: 8px; }
    </style>
  </body>
</html>
