---
import BaseV2 from '../layouts/BaseV2.astro';
import { displayFonts, fontGroups, shortlist } from '../display-fonts';

// Exported lockups. Bitram is shortlisted but has no artwork yet.
const lockupFonts = [
  { slug: 'florexa', name: 'Florexa', family: 'Florexa' },
  { slug: 'matrixel', name: 'Matrixel', family: 'Matrixel' },
];
const lockupVariants = [
  { slug: 'white-gold', label: 'White + gold', ground: 'ink' },
  { slug: 'white', label: 'White', ground: 'ink' },
  { slug: 'green-gold', label: 'Green + gold', ground: 'bone' },
  { slug: 'black', label: 'Black', ground: 'bone' },
];

const swatches = [
  { name: 'Ink', token: '--ink', hex: '#081f1f', note: 'Hero + CTA field' },
  { name: 'Deep', token: '--deep', hex: '#031919', note: 'Deepest green' },
  { name: 'Pine', token: '--pine', hex: '#0c2b29', note: 'Raised surface' },
  { name: 'Moss', token: '--moss', hex: '#133a36', note: 'Raised surface, high' },
  { name: 'Slate', token: '--slate', hex: '#174040', note: 'Dividers, wells' },
  { name: 'Gold', token: '--gold', hex: '#fdb343', note: 'The signal' },
  { name: 'Gold 2', token: '--gold-2', hex: '#f5a71e', note: 'Buttons, the dot' },
  { name: 'Bone', token: '--bone', hex: '#e6f2f0', note: 'Light ground' },
  { name: 'Text hi', token: '--text-hi', hex: '#edf5f4', note: 'Headings' },
  { name: 'Pale', token: '--pale', hex: '#aac2c2', note: 'Body copy' },
  { name: 'Steel', token: '--steel', hex: '#6a8988', note: 'Muted, AA on ink' },
];

const scale = [
  { cls: 'display', label: '.display', spec: 'clamp(42 → 76px) / 1.04', swap: true },
  { cls: 'h2', label: '.h2', spec: 'clamp(30 → 46px) / 1.12', swap: true },
  { cls: 'sg-h3', label: 'h3', spec: '21px / 700 / 1.3', swap: false },
  { cls: 'lede', label: '.lede', spec: '19px / 1.6', swap: false },
  { cls: 'sg-body', label: 'body', spec: '16px / 1.65', swap: false },
  { cls: 'body-s', label: '.body-s', spec: '15.5px', swap: false },
  { cls: 'kicker', label: '.kicker', spec: '12.5px / 600 / 0.14em caps', swap: false },
];
---

<BaseV2
  title="Styleguide — Sondri"
  description="The Sondri design system: type, colour, components, motion, and live display-font trials."
>
  <!-- ── Font switcher ─────────────────────────────── -->
  <div class="sg-bar" id="sg-bar">
    <div class="wrap sg-bar-in">
      <label class="sg-field">
        <span class="sg-field-label">Display font</span>
        <select id="font-select" aria-label="Display font for headings and wordmark">
          <option value="">Fraunces (current)</option>
          <optgroup label="Shortlist">
            {shortlist.map((f) => <option value={f.family}>{f.name}</option>)}
          </optgroup>
          {fontGroups.map((group) => (
            <optgroup label={group.label}>
              {displayFonts
                .filter((f) => f.group === group.id)
                .map((f) => <option value={f.family}>{f.name}</option>)}
            </optgroup>
          ))}
        </select>
      </label>

      <label class="sg-field sg-field-slider">
        <span class="sg-field-label">Tracking <em id="track-val">0</em></span>
        <input id="track" type="range" min="-6" max="12" step="1" value="0" />
      </label>

      <label class="sg-field sg-field-slider">
        <span class="sg-field-label">Case</span>
        <select id="case-select" aria-label="Letter case for headings">
          <option value="none">As written</option>
          <option value="uppercase">UPPERCASE</option>
          <option value="lowercase">lowercase</option>
        </select>
      </label>

      <button class="sg-reset" id="sg-reset" type="button">Reset</button>
    </div>
  </div>

  <div class="wrap sg">
    <header class="sg-head">
      <p class="kicker">Design system <span class="k-dot">.</span></p>
      <h1 class="display sg-swap">Styleguide<span class="gdot">.</span></h1>
      <p class="lede">
        Every token, type style, and component the site is built from. Use the bar above to try
        a display face live — it drives the wordmark and every heading on this page.
      </p>
    </header>

    <!-- ── Wordmark ────────────────────────────────── -->
    <section class="sg-sec">
      <h2 class="sg-sec-title">Wordmark</h2>
      <p class="body-s sg-note">
        Shipping nav uses <code>/brand/lockup-wordmark.png</code>. These are type trials for a
        future set wordmark — swap a face above to judge it at lockup scale.
      </p>
      <div class="sg-lockups">
        <div class="sg-lockup sg-lockup-dark">
          <span class="sg-mark sg-swap">Sondri<span class="gdot">.</span></span>
          <span class="body-s">On ink</span>
        </div>
        <div class="sg-lockup sg-lockup-light">
          <span class="sg-mark sg-swap">Sondri<span class="gdot">.</span></span>
          <span class="body-s">On bone</span>
        </div>
        <div class="sg-lockup sg-lockup-dark">
          <span class="sg-mark sg-mark-sm sg-swap">Sondri<span class="gdot">.</span></span>
          <span class="body-s">Nav scale — 42px</span>
        </div>
      </div>
    </section>

    <!-- ── Shortlist lockups ───────────────────────── -->
    <section class="sg-sec" id="lockups">
      <h2 class="sg-sec-title">Shortlist — drawn lockups</h2>
      <p class="body-s sg-note">
        Exported artwork for the two faces in front. SVG is what ships; PNG at 1× and 3× sits
        alongside for decks and email. Bitram is still on the shortlist but has no lockup drawn yet.
      </p>

      {lockupFonts.map((font) => (
        <div class="sg-lockup-set">
          <div class="sg-lockup-head">
            <h3 class="sg-lockup-name" style={`font-family:'${font.family}'`}>{font.name}</h3>
            <button class="sg-tile-name" type="button" data-load={font.family}>Load in switcher</button>
          </div>
          <div class="sg-lockup-grid">
            {lockupVariants.map((v) => (
              <figure class:list={['sg-lockup-cell', `on-${v.ground}`]}>
                <img
                  src={`/brand/wordmarks/${font.slug}-${v.slug}.svg`}
                  alt={`Sondri wordmark in ${font.name}, ${v.label.toLowerCase()}`}
                  loading="lazy"
                />
                <figcaption>
                  <span>{v.label}</span>
                  <span class="sg-lockup-files">
                    <a href={`/brand/wordmarks/${font.slug}-${v.slug}.svg`} target="_blank">SVG</a>
                    <a href={`/brand/wordmarks/png/${font.slug}-${v.slug}.png`} target="_blank">1×</a>
                    <a href={`/brand/wordmarks/png/${font.slug}-${v.slug}@3x.png`} target="_blank">3×</a>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- ── Wordmark grid ───────────────────────────── -->
    <section class="sg-sec" id="grid">
      <h2 class="sg-sec-title">Every face at once</h2>
      <p class="body-s sg-note">
        Showing the {shortlist.length}-face shortlist by default. Switch to <em>All</em> to see the
        full {displayFonts.length} again, or <em>Starred</em> for your own picks. Click any name to
        load that face into the switcher above.
      </p>

      <div class="sg-grid-bar">
        <label class="sg-field sg-field-slider">
          <span class="sg-field-label">Size <em id="grid-size-val">34</em>px</span>
          <input id="grid-size" type="range" min="14" max="96" step="1" value="34" />
        </label>

        <label class="sg-field">
          <span class="sg-field-label">Case</span>
          <select id="grid-case" aria-label="Letter case for the wordmark grid">
            <option value="none">As written</option>
            <option value="uppercase">UPPERCASE</option>
            <option value="lowercase">lowercase</option>
          </select>
        </label>

        <label class="sg-field">
          <span class="sg-field-label">Show</span>
          <select id="grid-filter" aria-label="Which faces to show">
            <option value="shortlist">Shortlist</option>
            <option value="starred">Starred</option>
            <option value="all">All</option>
          </select>
        </label>
        <span class="body-s" id="fav-count">0 starred</span>
        <button class="sg-reset" id="fav-clear" type="button">Clear stars</button>
      </div>

      <div class="sg-grid" id="wordmark-grid">
        {displayFonts.map((f) => (
          <figure
            class:list={['sg-tile', { 'is-short': f.shortlist }]}
            data-family={f.family}
            data-shortlist={f.shortlist ? 'true' : 'false'}
          >
            <button
              class="sg-star"
              type="button"
              data-star={f.family}
              aria-pressed="false"
              aria-label={`Star ${f.name}`}
            >
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
                <path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.58 1.1 6.47L12 17.44 6.2 20.5l1.1-6.47L2.6 9.45l6.5-.95z" />
              </svg>
            </button>
            <div class="sg-tile-mark" style={`font-family:'${f.family}'`}>
              Sondri<span class="gdot">.</span>
            </div>
            <figcaption>
              <button class="sg-tile-name" type="button" data-load={f.family}>{f.name}</button>
              <span class="sg-tile-group">{f.group === 'pixel' ? 'Pixel' : 'Display'}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="body-s sg-empty" id="fav-empty" hidden>Nothing starred yet.</p>
    </section>

    <!-- ── Type scale ──────────────────────────────── -->
    <section class="sg-sec">
      <h2 class="sg-sec-title">Type scale</h2>
      <p class="body-s sg-note">
        Headings run on <code>--font-display</code>; body copy stays on Hanken Grotesk and never
        swaps. Pixel faces are display-only — they are not legible at body sizes.
      </p>
      <div class="sg-rows">
        {scale.map((row) => (
          <div class="sg-row">
            <div class="sg-row-meta">
              <code>{row.label}</code>
              <span class="body-s">{row.spec}</span>
            </div>
            <div class:list={[row.cls, { 'sg-swap': row.swap }]}>
              Software that fits how you already work<span class="gdot">.</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Specimen ────────────────────────────────── -->
    <section class="sg-sec">
      <h2 class="sg-sec-title">Specimen</h2>
      <p class="body-s sg-note">
        The chosen face, exercised. Watch for missing glyphs, tight numerals, and punctuation
        that breaks at large sizes.
      </p>
      <div class="sg-specimen sg-swap">
        <p class="sg-spec-lg">ABCDEFGHIJKLM</p>
        <p class="sg-spec-lg">NOPQRSTUVWXYZ</p>
        <p class="sg-spec-md">abcdefghijklmnopqrstuvwxyz</p>
        <p class="sg-spec-md">0123456789 &amp; @ # % $ € £</p>
        <p class="sg-spec-md">. , ; : ! ? ' " ( ) [ ] / — –</p>
      </div>
    </section>

    <!-- ── Colour ──────────────────────────────────── -->
    <section class="sg-sec">
      <h2 class="sg-sec-title">Colour</h2>
      <p class="body-s sg-note">
        Deep green is the field, bone the text, gold the single signal. Gold is never decoration —
        it marks one thing per view.
      </p>
      <div class="sg-swatches">
        {swatches.map((s) => (
          <div class="sg-swatch">
            <div class="sg-chip" style={`background:${s.hex}`}></div>
            <div class="sg-swatch-meta">
              <strong>{s.name}</strong>
              <code>{s.token}</code>
              <code class="sg-hex">{s.hex}</code>
              <span class="body-s">{s.note}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── Buttons ─────────────────────────────────── -->
    <section class="sg-sec">
      <h2 class="sg-sec-title">Buttons</h2>
      <div class="sg-panel">
        <div class="ctas">
          <a class="btn btn-gold" href="#styleguide">Book discovery <span class="arr">→</span></a>
          <a class="btn btn-ink" href="#styleguide">Secondary <span class="arr">→</span></a>
          <a class="btn btn-ghost" href="#styleguide">Ghost <span class="arr">→</span></a>
        </div>
        <p class="body-s sg-note">
          <code>.btn-gold</code> carries a sheen on hover and is the only primary action in a view.
        </p>
      </div>
    </section>

    <!-- ── Surfaces ────────────────────────────────── -->
    <section class="sg-sec">
      <h2 class="sg-sec-title">Surfaces &amp; chips</h2>
      <div class="sg-cards">
        <div class="card sg-card">
          <h3>Card</h3>
          <p class="body-s">
            <code>.card</code> — glass fill over the green field, hairline border, 14px radius.
          </p>
        </div>
        <div class="card sg-card">
          <h3>Chips</h3>
          <div class="sg-chips">
            <span class="chip">Operations</span>
            <span class="chip">Finance</span>
            <span class="chip">Field service</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Tokens ──────────────────────────────────── -->
    <section class="sg-sec">
      <h2 class="sg-sec-title">Tokens</h2>
      <div class="sg-tokens">
        <div><code>--wrap</code><span>1160px</span></div>
        <div><code>--pad-x</code><span>40 / 24 / 18px</span></div>
        <div><code>--r-card</code><span>14px</span></div>
        <div><code>--r-pill</code><span>999px</span></div>
        <div><code>--ease</code><span>cubic-bezier(.16, 1, .3, 1)</span></div>
        <div><code>--dur-micro</code><span>0.2s</span></div>
        <div><code>--dur-reveal</code><span>0.55s</span></div>
        <div><code>--font-display</code><span id="tok-display">var(--serif)</span></div>
      </div>
    </section>

    <!-- ── Adopting a face ─────────────────────────── -->
    <section class="sg-sec">
      <h2 class="sg-sec-title">Adopting a face</h2>
      <p class="body-s sg-note">
        Nothing here changes the live site. To ship the face you picked, set one token in
        <code>src/styles/theme.css</code>:
      </p>
      <pre class="sg-code"><code id="sg-snippet">--font-display: var(--serif);</code></pre>
    </section>
  </div>

  <style>
    /* ── Switcher bar ──────────────────────────────── */
    .sg-bar {
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgba(3, 25, 25, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }
    .sg-bar-in {
      display: flex;
      align-items: flex-end;
      gap: 22px;
      flex-wrap: wrap;
      padding-block: 14px;
    }
    .sg-field { display: flex; flex-direction: column; gap: 6px; }
    .sg-field-label {
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--steel);
    }
    .sg-field-label em { font-style: normal; color: var(--gold); }
    .sg-bar select {
      appearance: none;
      background: var(--pine) url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8'%3E%3Cpath fill='%23aac2c2' d='M1 1l5 5 5-5'/%3E%3C/svg%3E")
        no-repeat right 12px center / 11px;
      color: var(--text-hi);
      border: 1px solid var(--line-ink);
      border-radius: 8px;
      padding: 9px 34px 9px 12px;
      font: inherit;
      font-size: 14px;
      min-width: 200px;
      cursor: pointer;
    }
    .sg-bar select:hover { border-color: var(--steel); }
    .sg-field-slider { min-width: 160px; }
    .sg-bar input[type='range'] { accent-color: var(--gold-2); width: 100%; }
    .sg-reset {
      background: transparent;
      border: 1px solid var(--line-ink);
      border-radius: var(--r-pill);
      color: var(--pale);
      font: inherit;
      font-size: 13px;
      padding: 8px 18px;
      cursor: pointer;
      transition: border-color var(--dur-micro) var(--ease);
    }
    .sg-reset:hover { border-color: var(--pale); }

    /* ── Page ──────────────────────────────────────── */
    .sg { padding-block: 64px 120px; }
    .sg-head { max-width: 720px; margin-bottom: 84px; }
    .sg-head h1 { margin: 18px 0 22px; }

    .sg-sec { padding-top: 56px; margin-top: 56px; border-top: 1px solid var(--line); }
    .sg-sec:first-of-type { border-top: 0; margin-top: 0; padding-top: 0; }
    .sg-sec-title {
      font-family: var(--sans);
      font-size: 12.5px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--steel);
      margin-bottom: 20px;
    }
    .sg-note { max-width: 620px; margin-bottom: 28px; }
    .sg code {
      font-family: ui-monospace, 'SF Mono', Menlo, monospace;
      font-size: 12.5px;
      color: var(--gold);
    }

    /* ── Wordmark ──────────────────────────────────── */
    .sg-lockups { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
    .sg-lockup {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      min-height: 190px;
      border-radius: var(--r-card);
      border: 1px solid var(--line-ink);
      padding: 28px;
      text-align: center;
    }
    .sg-lockup-dark { background: var(--ink); }
    .sg-lockup-light { background: var(--bone); }
    .sg-lockup-light .sg-mark { color: var(--ink); }
    .sg-lockup-light .body-s { color: #3d5a58; }
    .sg-mark { font-size: 54px; line-height: 1; color: var(--text-hi); font-weight: 560; }
    .sg-mark-sm { font-size: 26px; }

    /* ── Shortlist lockups ─────────────────────────── */
    .sg-lockup-set + .sg-lockup-set { margin-top: 40px; }
    .sg-lockup-head {
      display: flex;
      align-items: baseline;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }
    .sg-lockup-name { font-size: 26px; color: var(--text-hi); font-weight: 400; }
    .sg-lockup-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }
    .sg-lockup-cell {
      border: 1px solid var(--line-ink);
      border-radius: var(--r-card);
      overflow: hidden;
    }
    .sg-lockup-cell img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 150px;
      object-fit: contain;
      padding: 30px 34px;
    }
    .sg-lockup-cell.on-ink img { background: var(--ink); }
    .sg-lockup-cell.on-bone img { background: var(--bone); }
    .sg-lockup-cell figcaption {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 14px;
      border-top: 1px solid var(--line);
      font-size: 13px;
      color: var(--pale);
    }
    .sg-lockup-files { display: flex; gap: 10px; }
    .sg-lockup-files a {
      color: var(--steel);
      font-size: 11.5px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      transition: color var(--dur-micro) var(--ease);
    }
    .sg-lockup-files a:hover { color: var(--gold); }

    /* ── Wordmark grid ─────────────────────────────── */
    .sg-grid-bar { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; margin-bottom: 22px; }
    .sg-toggle { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; cursor: pointer; }
    .sg-toggle input { accent-color: var(--gold-2); width: 15px; height: 15px; cursor: pointer; }
    .sg-grid {
      display: grid;
      /* Tiles are only as wide as the wordmark needs, so raising the size costs
         columns as slowly as possible. 4.5em ≈ "Sondri." across these faces. */
      grid-template-columns: repeat(auto-fill, minmax(max(150px, calc(var(--grid-size, 34px) * 4.5)), 1fr));
      gap: 8px;
      /* Break out of the 1160px text measure — the grid wants every pixel. */
      width: min(1600px, calc(100vw - 2 * var(--pad-x)));
      margin-inline: calc((100% - min(1600px, 100vw - 2 * var(--pad-x))) / 2);
    }
    .sg-tile {
      position: relative;
      display: flex;
      flex-direction: column;
      background: var(--ink);
      border: 1px solid var(--line-ink);
      border-radius: var(--r-card);
      overflow: hidden;
      /* Lets the wordmark size itself against the tile, so it never overflows
         however wide a given face runs. */
      container-type: inline-size;
      transition: border-color var(--dur-micro) var(--ease), transform var(--dur-micro) var(--ease);
    }
    .sg-tile:hover { border-color: var(--steel); transform: translateY(-2px); }
    .sg-tile.is-fav { border-color: var(--gold-2); }
    .sg-tile.is-short .sg-tile-group { color: var(--gold); }
    .sg-tile[hidden] { display: none; }
    .sg-tile-mark {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: calc(var(--grid-size, 34px) * 1.5 + 16px);
      padding: 8px 10px;
      font-size: min(var(--grid-size, 34px), 20cqw);
      line-height: 1.1;
      color: var(--text-hi);
      text-align: center;
      text-transform: var(--grid-case, none);
      white-space: nowrap;
      transition: font-size var(--dur-micro) var(--ease);
    }
    .sg-tile figcaption {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 6px 10px;
      border-top: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.025);
    }
    .sg-tile-name {
      background: none;
      border: 0;
      padding: 0;
      font: inherit;
      font-size: 12px;
      color: var(--pale);
      cursor: pointer;
      text-align: left;
      transition: color var(--dur-micro) var(--ease);
    }
    .sg-tile-name:hover { color: var(--gold); }
    .sg-tile-group {
      font-size: 10.5px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--steel);
      flex-shrink: 0;
    }
    .sg-star {
      position: absolute;
      top: 5px;
      right: 5px;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 24px;
      height: 24px;
      border: 0;
      border-radius: 50%;
      background: rgba(3, 25, 25, 0.6);
      cursor: pointer;
      transition: background var(--dur-micro) var(--ease);
    }
    .sg-star svg { fill: none; stroke: var(--steel); stroke-width: 1.6; transition: fill var(--dur-micro) var(--ease), stroke var(--dur-micro) var(--ease); }
    .sg-star:hover svg { stroke: var(--pale); }
    .sg-star[aria-pressed='true'] svg { fill: var(--gold-2); stroke: var(--gold-2); }
    .sg-empty { margin-top: 26px; }

    /* ── Type rows ─────────────────────────────────── */
    .sg-rows { display: flex; flex-direction: column; }
    .sg-row {
      display: grid;
      grid-template-columns: 190px 1fr;
      gap: 32px;
      align-items: baseline;
      padding: 26px 0;
      border-bottom: 1px solid var(--line);
    }
    .sg-row:last-child { border-bottom: 0; }
    .sg-row-meta { display: flex; flex-direction: column; gap: 4px; }
    .sg-h3 { font-size: 21px; font-weight: 700; line-height: 1.3; color: var(--text-hi); }
    .sg-body { font-size: 16px; line-height: 1.65; }

    /* ── Specimen ──────────────────────────────────── */
    .sg-specimen {
      background: var(--ink);
      border: 1px solid var(--line-ink);
      border-radius: var(--r-card);
      padding: 40px;
      color: var(--text-hi);
      overflow-x: auto;
    }
    .sg-spec-lg { font-size: clamp(24px, 3.4vw, 44px); line-height: 1.3; white-space: nowrap; }
    .sg-spec-md { font-size: clamp(17px, 2.1vw, 26px); line-height: 1.5; white-space: nowrap; }

    /* ── Colour ────────────────────────────────────── */
    .sg-swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 18px; }
    .sg-swatch { border: 1px solid var(--line-ink); border-radius: var(--r-card); overflow: hidden; }
    .sg-chip { height: 84px; }
    .sg-swatch-meta { display: flex; flex-direction: column; gap: 3px; padding: 14px 16px 16px; }
    .sg-swatch-meta strong { color: var(--text-hi); font-size: 15px; }
    .sg-hex { color: var(--steel) !important; text-transform: uppercase; }

    /* ── Panels ────────────────────────────────────── */
    .sg-panel {
      border: 1px solid var(--line-ink);
      border-radius: var(--r-card);
      padding: 36px;
      background: var(--card-glass);
    }
    .sg-panel .sg-note { margin: 26px 0 0; }
    .sg-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; }
    .sg-card { padding: 28px; }
    .sg-card h3 { margin-bottom: 12px; }
    .sg-chips { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }

    /* ── Tokens ────────────────────────────────────── */
    .sg-tokens { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r-card); overflow: hidden; }
    .sg-tokens > div { display: flex; justify-content: space-between; gap: 16px; padding: 16px 20px; background: var(--canvas); font-size: 14px; }
    .sg-tokens span { color: var(--pale); }

    .sg-code {
      background: var(--deep);
      border: 1px solid var(--line-ink);
      border-radius: 10px;
      padding: 18px 22px;
      overflow-x: auto;
    }
    .sg-code code { color: var(--text-hi); }

    @media (max-width: 720px) {
      .sg-row { grid-template-columns: 1fr; gap: 12px; }
      .sg-bar-in { gap: 14px; }
      .sg-bar select { min-width: 150px; }
    }
  </style>

  <script>
    const KEY = 'sondri-styleguide-display';

    document.addEventListener('astro:page-load', () => {
      const select = document.getElementById('font-select') as HTMLSelectElement | null;
      const track = document.getElementById('track') as HTMLInputElement | null;
      const caseSel = document.getElementById('case-select') as HTMLSelectElement | null;
      const reset = document.getElementById('sg-reset');
      if (!select || !track || !caseSel || !reset) return;

      const trackVal = document.getElementById('track-val');
      const snippet = document.getElementById('sg-snippet');
      const tokenRow = document.getElementById('tok-display');
      const root = document.documentElement;

      const apply = () => {
        const family = select.value;
        const value = family ? `'${family}'` : 'var(--serif)';
        root.style.setProperty('--font-display', value);
        // Pixel faces have their own built-in sidebearings; the brand's -0.015em
        // tightening is wrong for them, so tracking is driven explicitly here.
        root.style.setProperty('--sg-track', `${track.value}px`);
        root.style.setProperty('--sg-case', caseSel.value);

        if (trackVal) trackVal.textContent = track.value;
        if (snippet) snippet.textContent = `--font-display: ${value};`;
        if (tokenRow) tokenRow.textContent = value;

        try {
          localStorage.setItem(KEY, JSON.stringify({ family, track: track.value, casing: caseSel.value }));
        } catch {
          /* private browsing — the trial just won't persist */
        }
      };

      try {
        const saved = JSON.parse(localStorage.getItem(KEY) || '{}');
        if (saved.family) select.value = saved.family;
        if (saved.track) track.value = saved.track;
        if (saved.casing) caseSel.value = saved.casing;
      } catch {
        /* ignore malformed state */
      }

      // ── Wordmark grid: starring + filtering ──────────
      const FAV_KEY = 'sondri-styleguide-favs';
      const grid = document.getElementById('wordmark-grid');
      const gridFilter = document.getElementById('grid-filter') as HTMLSelectElement | null;
      const favCount = document.getElementById('fav-count');
      const favClear = document.getElementById('fav-clear');
      const favEmpty = document.getElementById('fav-empty');

      const FILTER_KEY = 'sondri-styleguide-filter';
      try {
        const savedFilter = localStorage.getItem(FILTER_KEY);
        if (savedFilter && gridFilter) gridFilter.value = savedFilter;
      } catch {
        /* ignore */
      }

      let favs = new Set<string>();
      try {
        favs = new Set(JSON.parse(localStorage.getItem(FAV_KEY) || '[]'));
      } catch {
        /* ignore malformed state */
      }

      const paintFavs = () => {
        let shown = 0;
        const mode = gridFilter?.value || 'shortlist';
        grid?.querySelectorAll<HTMLElement>('.sg-tile').forEach((tile) => {
          const family = tile.dataset.family || '';
          const on = favs.has(family);
          tile.classList.toggle('is-fav', on);
          tile.querySelector('.sg-star')?.setAttribute('aria-pressed', String(on));
          const short = tile.dataset.shortlist === 'true';
          const hide = mode === 'starred' ? !on : mode === 'shortlist' ? !short : false;
          tile.hidden = hide;
          if (!hide) shown++;
        });
        if (favCount) favCount.textContent = `${favs.size} starred`;
        if (favEmpty) {
          favEmpty.hidden = shown > 0;
          favEmpty.textContent =
            mode === 'starred' ? 'Nothing starred yet.' : 'Nothing to show.';
        }
        try {
          localStorage.setItem(FAV_KEY, JSON.stringify([...favs]));
        } catch {
          /* private browsing — stars just won't persist */
        }
      };

      grid?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const star = target.closest<HTMLElement>('[data-star]');
        if (star) {
          const family = star.dataset.star!;
          favs.has(family) ? favs.delete(family) : favs.add(family);
          paintFavs();
          return;
        }
        const load = target.closest<HTMLElement>('[data-load]');
        if (load) {
          select.value = load.dataset.load!;
          apply();
          document.getElementById('sg-bar')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });

      // Grid size + case, independent of the switcher above.
      const GRID_KEY = 'sondri-styleguide-grid';
      const gridSize = document.getElementById('grid-size') as HTMLInputElement | null;
      const gridCase = document.getElementById('grid-case') as HTMLSelectElement | null;
      const gridSizeVal = document.getElementById('grid-size-val');

      const applyGrid = () => {
        if (!grid || !gridSize || !gridCase) return;
        grid.style.setProperty('--grid-size', `${gridSize.value}px`);
        grid.style.setProperty('--grid-case', gridCase.value);
        if (gridSizeVal) gridSizeVal.textContent = gridSize.value;
        try {
          localStorage.setItem(GRID_KEY, JSON.stringify({ size: gridSize.value, casing: gridCase.value }));
        } catch {
          /* private browsing — grid settings just won't persist */
        }
      };

      try {
        const savedGrid = JSON.parse(localStorage.getItem(GRID_KEY) || '{}');
        if (savedGrid.size && gridSize) gridSize.value = savedGrid.size;
        if (savedGrid.casing && gridCase) gridCase.value = savedGrid.casing;
      } catch {
        /* ignore malformed state */
      }

      gridSize?.addEventListener('input', applyGrid);
      gridCase?.addEventListener('change', applyGrid);
      applyGrid();

      gridFilter?.addEventListener('change', () => {
        paintFavs();
        try {
          localStorage.setItem(FILTER_KEY, gridFilter.value);
        } catch {
          /* private browsing — the filter just won't persist */
        }
      });
      favClear?.addEventListener('click', () => {
        favs.clear();
        paintFavs();
      });
      paintFavs();

      select.addEventListener('change', apply);
      track.addEventListener('input', apply);
      caseSel.addEventListener('change', apply);
      reset.addEventListener('click', () => {
        select.value = '';
        track.value = '0';
        caseSel.value = 'none';
        apply();
      });

      apply();
    });
  </script>

  <style is:global>
    /* Applied on the styleguide only — the switcher writes these on :root. */
    .sg-swap {
      font-family: var(--font-display);
      letter-spacing: var(--sg-track, -0.015em);
      text-transform: var(--sg-case, none);
    }
  </style>
</BaseV2>
