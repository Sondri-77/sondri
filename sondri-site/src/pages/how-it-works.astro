---
import BaseV2 from '../layouts/BaseV2.astro';
import PageHero from '../components/v2/PageHero.astro';
import CtaBand from '../components/v2/CtaBand.astro';
import { timeline, teamModel, framework, faq, BOOK_HREF } from '../data';
---

<BaseV2
  title="How it works — Sondri"
  description="Two weeks to a board-ready roadmap. Eight weeks to production. How Sondri takes enterprise AI from zero to one to many."
>
  <PageHero kicker="How it works">
    <Fragment slot="title">From kickoff to production in eight weeks<span class="gdot hero-dot">.</span></Fragment>
    <Fragment slot="lede">
      A senior core team designs the system. A vetted specialist network builds it.
      You get results in the systems you already own — not a platform.
    </Fragment>
  </PageHero>

  <!-- ── Timeline ─────────────────────────────────────── -->
  <section class="tl">
    <div class="wrap">
      <div class="tl-grid" data-reveal data-reveal-group>
        {timeline.map((t) => (
          <div class="card tcell">
            <span class="wk">{t.wk.toLowerCase()}</span>
            <h3>{t.title}</h3>
            <p class="body-s">{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Team model ───────────────────────────────────── -->
  <section class="team">
    <div class="wrap">
      <div data-reveal>
        <p class="kicker">01 <span class="k-dot">·</span> Who does the work</p>
        <h2 class="h2">Senior architects. Vetted builders. Your operators<span class="gdot">.</span></h2>
      </div>
      <div class="tm-grid" data-reveal data-reveal-group>
        {teamModel.map((m) => (
          <div class="tm">
            <span class="tm-tag">{m.tag.toLowerCase()}</span>
            <h3>{m.title}</h3>
            <p class="body-s">{m.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Pricing ──────────────────────────────────────── -->
  <section class="pricing">
    <div class="wrap">
      <div data-reveal>
        <p class="kicker">02 <span class="k-dot">·</span> Pricing</p>
        <h2 class="h2">Priced by phase. You commit one rung at a time<span class="gdot">.</span></h2>
      </div>
      <div class="pr-grid" data-reveal data-reveal-group>
        {framework.map((p) => (
          <div class:list={['card', 'pr', { hot: p.num === '1' }]}>
            <div class="pr-top">
              <span class="pr-n h-serif">{p.num}</span>
              <span class="pr-price">{p.price.toLowerCase()}</span>
            </div>
            <h3>{p.name} <span class="pr-when">· {p.when.toLowerCase()}</span></h3>
            <p class="body-s">{p.does}</p>
            <p class="body-s pr-gets">{p.gets}</p>
          </div>
        ))}
      </div>
      <p class="pr-note" data-reveal>
        Long-term customers can add a standing advisory seat — a permanent partner for every AI
        decision the business faces next. Scoped individually.
      </p>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────── -->
  <section class="faqs">
    <div class="wrap">
      <div data-reveal>
        <p class="kicker">03 <span class="k-dot">·</span> Questions</p>
        <h2 class="h2">Asked on almost every intro call<span class="gdot">.</span></h2>
      </div>
      <div class="faq-list" data-reveal>
        {faq.map((f) => (
          <details class="faq">
            <summary>{f.q}<span class="faq-mark" aria-hidden="true">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA band ─────────────────────────────────────── -->
  <CtaBand kicker="Next step">
    <Fragment slot="title">The first conversation is free<span class="gdot">.</span></Fragment>
    <Fragment slot="actions">
      <a class="btn btn-gold" href={BOOK_HREF}>Book a discovery call <span class="arr">→</span></a>
      <a class="btn btn-ghost-dark" href="/get-in-touch/">Get in touch</a>
    </Fragment>
  </CtaBand>
</BaseV2>

<style>
  /* ── Timeline ── */
  .tl { padding: 84px 0 30px; }
  .tl-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  .tcell { padding: 30px 26px; }
  .wk {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-2);
    margin-bottom: 14px;
  }
  .tcell h3 { margin-bottom: 8px; }

  /* ── Team ── */
  .team { padding: 80px 0 100px; }
  .team .kicker { margin-bottom: 16px; }
  .team .h2 { max-width: 720px; margin-bottom: 44px; }
  .tm-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .tm-tag {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-2);
    margin-bottom: 10px;
  }
  .tm h3 { margin-bottom: 8px; }

  /* ── Pricing ── */
  .pricing { background: var(--bone); padding: 100px 0; }
  .pricing .kicker { margin-bottom: 16px; }
  .pricing .h2 { max-width: 720px; margin-bottom: 44px; }
  .pr-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: stretch; }
  .pr { display: flex; flex-direction: column; padding: 32px 28px; }
  .pr.hot { border-color: var(--gold-2); box-shadow: 0 12px 32px rgba(13, 26, 26, 0.06); }
  .pr-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 34px; }
  .pr-n { font-size: 38px; }
  .pr-price {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .pr h3 { margin-bottom: 10px; }
  .pr-when { font-family: var(--sans); font-size: 13px; font-weight: 600; color: var(--steel); }
  .pr-gets { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--line); }
  .pr-note { color: var(--steel); font-size: 14.5px; max-width: 640px; margin-top: 28px; }

  /* ── FAQ ── */
  .faqs { padding: 100px 0 110px; }
  .faqs .kicker { margin-bottom: 16px; }
  .faqs .h2 { margin-bottom: 40px; }
  .faq-list { max-width: 780px; border-top: 1px solid var(--line); }
  .faq { border-bottom: 1px solid var(--line); }
  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    cursor: pointer;
    list-style: none;
    padding: 22px 2px;
    font-weight: 700;
    font-size: 17.5px;
    color: var(--ink);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover { color: var(--slate); }
  .faq-mark {
    color: var(--gold-2);
    font-size: 20px;
    font-weight: 400;
    line-height: 1;
    transition: transform var(--dur-micro) var(--ease);
  }
  .faq[open] .faq-mark { transform: rotate(45deg); }
  .faq p { color: var(--slate); font-size: 15.5px; padding: 0 2px 24px; max-width: 640px; }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .tl-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .tm-grid, .pr-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .tl-grid { grid-template-columns: 1fr; }
    .tl { padding-top: 56px; }
    .team, .pricing, .faqs { padding-block: 72px; }
  }
</style>
