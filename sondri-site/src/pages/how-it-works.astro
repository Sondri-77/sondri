---
import Base from '../layouts/Base.astro';
import { timeline, teamModel, framework, faq, BOOK_HREF } from '../data';
---

<Base
  title="How it works — Sondri"
  description="Two weeks to a board-ready roadmap. Eight weeks to an agent in production. How Sondri takes enterprise AI from zero to one to many."
>
  <div class="pagepad">
    <!-- HEADER -->
    <section class="wrap head">
      <span class="kicker" data-reveal>HOW IT WORKS</span>
      <h1 class="display head-title" data-reveal>From kickoff to production in eight weeks.</h1>
      <p class="lede head-lede" data-reveal>
        A senior core team designs the system. A vetted specialist network builds it.
        You get agents running in the systems you already own — not a platform.
      </p>
    </section>

    <!-- TIMELINE -->
    <section class="wrap tl">
      <div class="grid-lined g4" data-reveal>
        {timeline.map((t) => (
          <div class="cell">
            <span class="wk">{t.wk}</span>
            <span class="cell-title">{t.title}</span>
            <p class="cell-body">{t.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- TEAM MODEL -->
    <section class="wrap section">
      <div class="tm-head" data-reveal>
        <span class="kicker">WHO DOES THE WORK</span>
        <h2 class="display tm-title">Senior architects. Vetted builders. Your operators.</h2>
      </div>
      <div class="grid-lined g3" data-reveal>
        {teamModel.map((m) => (
          <div class="tm">
            <span class="tm-tag">{m.tag}</span>
            <div class="tm-name">{m.title}</div>
            <p class="tm-body">{m.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- PRICING -->
    <section class="band">
      <div class="wrap section">
        <div class="pr-head" data-reveal>
          <span class="kicker">PRICING</span>
          <h2 class="display pr-title">Priced by phase. You commit one rung at a time.</h2>
        </div>
        <div class="pr-grid" data-reveal>
          {framework.map((p) => (
            <div class="pr-card">
              <div class="pr-top">
                <span class="pr-num">{p.num}</span>
                <span class="pr-price">{p.price}</span>
              </div>
              <div class="pr-name">{p.name} <span class="pr-when">· {p.when}</span></div>
              <p class="pr-body">{p.does}</p>
              <p class="pr-gets">{p.gets}</p>
            </div>
          ))}
        </div>
        <p class="pr-note" data-reveal>
          Long-term customers can add a standing advisory seat — a permanent partner for every
          AI decision the business faces next. Scoped individually.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="wrap section faq-section">
      <div class="faq-head" data-reveal>
        <span class="kicker">QUESTIONS</span>
        <h2 class="display faq-title">Asked on almost every intro call.</h2>
      </div>
      <div class="faq-list" data-reveal>
        {faq.map((f) => (
          <details class="faq">
            <summary class="faq-q">{f.q}<span class="faq-mark" aria-hidden="true">+</span></summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-band">
      <div class="wrap cta-inner" data-reveal>
        <span class="kicker">NEXT STEP</span>
        <h2 class="display cta-title">The first conversation is free.</h2>
        <div class="ctas">
          <a class="btn-primary" href={BOOK_HREF}>BOOK A DISCOVERY CALL &nbsp;&rarr;</a>
          <a class="btn-ghost" href="/get-in-touch/">GET IN TOUCH</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .pagepad { padding-top: 110px; }
  .head { padding: 80px var(--pad-x) 70px; }
  .head-title { font-size: clamp(38px, 5.4vw, 76px); line-height: 1.02; letter-spacing: -1px; margin-top: 16px; max-width: 18ch; }
  .head-lede { max-width: 56ch; margin-top: 26px; }

  .tl { padding: 0 var(--pad-x); }
  .cell { padding: 30px 26px; }
  .wk { font-size: 10px; letter-spacing: 2px; color: var(--gold); }
  .cell-title { display: block; font-family: var(--font-display); font-weight: 700; font-size: 22px; color: var(--bone); margin-top: 14px; }
  .cell-body { font-size: 12px; line-height: 1.85; color: var(--clay); margin-top: 10px; }

  .tm-head { margin-bottom: 56px; }
  .tm-title { font-size: clamp(28px, 3.8vw, 52px); line-height: 1.05; letter-spacing: -0.5px; margin-top: 14px; max-width: 24ch; }
  .tm { padding: 34px 28px; }
  .tm-tag { font-size: 9px; letter-spacing: 2px; color: var(--gold); }
  .tm-name { font-family: var(--font-display); font-weight: 700; font-size: 21px; color: var(--bone); margin-top: 14px; }
  .tm-body { font-size: 12px; line-height: 1.85; color: var(--clay); margin-top: 12px; }

  .band { border-top: 1px solid var(--line); background: var(--ink-deep); }
  .band .grid-lined > * { background: var(--ink-deep); }
  .pr-head { margin-bottom: 56px; }
  .pr-title { font-size: clamp(28px, 3.8vw, 52px); line-height: 1.05; letter-spacing: -0.5px; margin-top: 14px; max-width: 24ch; }
  .pr-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .pr-card { border: 1px solid var(--line); border-top: 2px solid var(--gold); background: var(--ink); padding: 30px 26px; }
  .pr-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .pr-num { font-family: var(--font-display); font-weight: 700; font-size: 40px; color: var(--gold); }
  .pr-price { font-size: 10px; letter-spacing: 2px; color: var(--bone); text-align: right; }
  .pr-name { font-family: var(--font-display); font-weight: 700; font-size: 20px; color: var(--bone); margin-top: 12px; }
  .pr-when { font-family: var(--font-mono); font-weight: 400; font-size: 10px; letter-spacing: 2px; color: var(--dim-2); }
  .pr-body { font-size: 12px; line-height: 1.8; color: var(--clay); margin-top: 12px; }
  .pr-gets { font-size: 12px; line-height: 1.8; color: var(--body-2); margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line); }
  .pr-note { font-size: 12px; line-height: 1.9; color: var(--dim); margin-top: 28px; max-width: 62ch; }

  .faq-head { margin-bottom: 44px; }
  .faq-title { font-size: clamp(28px, 3.8vw, 52px); line-height: 1.05; letter-spacing: -0.5px; margin-top: 14px; }
  .faq-list { border-top: 1px solid var(--line); max-width: 780px; }
  .faq { border-bottom: 1px solid var(--line); }
  .faq-q {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    cursor: pointer;
    list-style: none;
    padding: 22px 4px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    color: var(--bone);
  }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q:hover { color: var(--gold-soft); }
  .faq-mark { color: var(--gold); font-family: var(--font-mono); font-size: 15px; transition: transform 0.2s; }
  .faq[open] .faq-mark { transform: rotate(45deg); }
  .faq-a { font-size: 13px; line-height: 1.95; color: var(--clay); padding: 0 4px 24px; max-width: 64ch; }

  .cta-band {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(ellipse 60% 90% at 50% 110%, rgba(255, 204, 120, 0.07), transparent 70%),
      var(--ink);
  }
  .cta-inner { padding: 110px var(--pad-x) 130px; text-align: center; }
  .cta-title { font-size: clamp(30px, 4.6vw, 64px); line-height: 1.04; letter-spacing: -0.5px; margin-top: 18px; }
  .ctas { display: flex; gap: 18px; margin-top: 38px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .pagepad { padding-top: 90px; }
    .head { padding: 60px var(--pad-x) 50px; }
    .pr-grid { grid-template-columns: 1fr; }
  }
</style>
