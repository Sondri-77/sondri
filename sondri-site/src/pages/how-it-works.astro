---
import BaseV2 from '../layouts/BaseV2.astro';
import PageHero from '../components/v2/PageHero.astro';
import CtaBand from '../components/v2/CtaBand.astro';
import { timeline, teamModel, faq, BOOK_HREF, CTA_PRIMARY } from '../data';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseV2
  title="How It Works — Sondri"
  description="A board-ready roadmap first, then working software in production — proven on your workflows, measured on your P&L. How Sondri takes a business from zero to one to many."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <PageHero>
    <Fragment slot="title">From kickoff to production, without the <span class="nb">drag<span class="gdot hero-dot">.</span></span></Fragment>
    <Fragment slot="lede">
      A senior core team designs the solution. A vetted specialist network builds it.
      You get results in the systems you already own — not another platform.
    </Fragment>
  </PageHero>

  <!-- ── Timeline ─────────────────────────────────────── -->
  <section class="tl">
    <div class="wrap">
      <div class="tl-grid" data-reveal data-reveal-group>
        {timeline.map((t) => (
          <div class="card tcell">
            <span class="wk">{t.wk.toLowerCase()}</span>
            <h3>{t.title}</h3>
            <p class="body-s">{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Team model ───────────────────────────────────── -->
  <section class="team">
    <div class="wrap">
      <div data-reveal>
        <h2 class="h2">Senior architects. Vetted builders. Your operators<span class="gdot">.</span></h2>
      </div>
      <div class="tm-grid" data-reveal data-reveal-group>
        {teamModel.map((m) => (
          <div class="tm">
            <h3>{m.title}</h3>
            <p class="body-s">{m.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FAQ ──────────────────────────────────────────── -->
  <section class="faqs">
    <div class="wrap">
      <div data-reveal>
        <h2 class="h2">Asked on almost every intro call<span class="gdot">.</span></h2>
      </div>
      <div class="faq-list" data-reveal>
        {faq.map((f) => (
          <details class="faq">
            <summary>{f.q}<span class="faq-mark" aria-hidden="true">+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA band ─────────────────────────────────────── -->
  <CtaBand>
    <Fragment slot="title">Proven on your workflows. Measured on your P&L<span class="gdot">.</span></Fragment>
    <Fragment slot="actions">
      <a class="btn btn-gold" href={BOOK_HREF}>{CTA_PRIMARY} <span class="arr">→</span></a>
      <a class="btn btn-ghost-dark" href="/get-in-touch/">Get in Touch</a>
    </Fragment>
  </CtaBand>
</BaseV2>

<style>
  /* ── Timeline (dark anchor) ── */
  .tl { background: var(--deep); padding: 84px 0 100px; }
  .tl-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; align-items: stretch; }
  .tcell {
    padding: 30px 26px;
    background: rgba(255, 255, 255, 0.045);
    border-color: var(--line-ink);
    transition: transform var(--dur-micro) var(--ease), box-shadow var(--dur-micro) var(--ease), border-color var(--dur-micro) var(--ease);
  }
  .tcell:hover {
    transform: translateY(-2px);
    border-color: var(--gold-2);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.35);
  }
  .wk {
    display: block;
    font-family: var(--serif);
    font-weight: 560;
    font-size: 30px;
    line-height: 1;
    color: var(--gold);
    margin-bottom: 24px;
  }
  .tcell h3 { color: #fff; margin-bottom: 8px; }
  .tcell .body-s { color: var(--pale); }

  /* ── Team ── */
  .team { background: var(--pine); padding: 80px 0 100px; }
  .team .kicker { margin-bottom: 16px; }
  .team .h2 { max-width: 720px; margin-bottom: 44px; }
  .tm-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .tm h3 { margin-bottom: 8px; }

  /* ── FAQ ── */
  .faqs { background: var(--moss); padding: 100px 0 110px; }
  .faqs .kicker { margin-bottom: 16px; }
  .faqs .h2 { margin-bottom: 40px; }
  .faq-list { max-width: 780px; border-top: 1px solid var(--line); }
  .faq { border-bottom: 1px solid var(--line); }
  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    cursor: pointer;
    list-style: none;
    padding: 22px 2px;
    font-weight: 700;
    font-size: 17.5px;
    color: var(--text-hi);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover { color: var(--pale); }
  .faq-mark {
    color: var(--gold-2);
    font-size: 20px;
    font-weight: 400;
    line-height: 1;
    transition: transform var(--dur-micro) var(--ease);
  }
  .faq[open] .faq-mark { transform: rotate(45deg); }
  .faq p { color: var(--pale); font-size: 15.5px; padding: 0 2px 24px; max-width: 640px; }
  .faq[open] p { animation: faq-in 0.35s var(--ease); }
  @keyframes faq-in {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq[open] p { animation: none; }
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .tl-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .tm-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .tl-grid { grid-template-columns: 1fr; }
    .tl { padding-block: 56px 72px; }
    .team, .faqs { padding-block: 72px; }
  }
</style>
