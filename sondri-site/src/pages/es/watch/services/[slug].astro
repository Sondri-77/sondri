---
import WatchServiceDetailPage from '../../../../components/watch/WatchServiceDetailPage.astro';
import { getWatchServices } from '../../../../data/watch-content';

export function getStaticPaths() {
  return getWatchServices('es').map((srv) => ({
    params: { slug: srv.slug },
  }));
}

const { slug } = Astro.params;
---

<WatchServiceDetailPage lang="es" slug={slug} />
