---
import BaseV2 from '../layouts/BaseV2.astro';
import PageHero from '../components/v2/PageHero.astro';
---

<BaseV2
  title="Payments & deposits — Sondri"
  description="Submit an agreed invoice deposit or custom payment for Sondri AI automation services."
>
  <PageHero kicker="Sondri payments">
    <Fragment slot="title">Secure client payment portal<span class="gdot hero-dot">.</span></Fragment>
    <Fragment slot="lede">
      Submit an agreed project deposit, retainer payment, or invoice. All transactions run
      through encrypted Stripe Checkout with instant receipt generation.
    </Fragment>
  </PageHero>

  <!-- CUSTOM DEPOSIT CARD -->
  <section class="pay-section">
    <div class="wrap">
      <div class="card pay-card" data-reveal>
        <p class="plan-code">Client payment portal</p>
        <h2 class="pay-title">Pay an invoice or deposit</h2>
        <p class="body-s pay-b">
          Enter your billing email, the custom amount agreed with the Sondri engineering team,
          and your project reference.
        </p>

        <form id="formCustomPay" class="pay-form">
          <div class="form-group">
            <label for="cEmail" class="form-label">Billing email address *</label>
            <input type="email" id="cEmail" class="form-input" placeholder="billing@company.com" required />
          </div>

          <div class="form-group">
            <label for="cAmount" class="form-label">Payment amount ($ USD) *</label>
            <input type="number" step="0.01" min="10" id="cAmount" class="form-input" placeholder="2500.00" required />
          </div>

          <div class="form-group">
            <label for="cDesc" class="form-label">Invoice reference / project description *</label>
            <input type="text" id="cDesc" class="form-input" placeholder="Deposit for AI Workflow Sprint" required />
          </div>

          <button type="submit" id="btnSubmit" class="btn btn-gold btn-full">
            Proceed to secure checkout <span class="arr">→</span>
          </button>
        </form>
      </div>

      <p class="sec-note" data-reveal>
        <span class="sec-dot" aria-hidden="true"></span>
        256-bit encrypted · Automatic PDF tax receipts · Powered by Stripe
      </p>
    </div>
  </section>

  <script>
    const WORKER_BASE = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
      ? 'http://localhost:8787'
      : 'https://billing.sondri.ai';

    // Handle Custom Payment Form Submission
    document.getElementById('formCustomPay')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnSubmit') as HTMLButtonElement;
      if (btn) btn.innerText = 'Generating checkout...';

      const client_email = (document.getElementById('cEmail') as HTMLInputElement).value;
      const custom_amount = parseFloat((document.getElementById('cAmount') as HTMLInputElement).value);
      const description = (document.getElementById('cDesc') as HTMLInputElement).value;

      try {
        const res = await fetch(`${WORKER_BASE}/create-checkout-session`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'custom',
            client_email,
            custom_amount,
            description,
          }),
        });

        const json = await res.json();

        if (json.success && json.data?.checkout_url) {
          window.location.href = json.data.checkout_url;
        } else {
          alert(`Checkout Error: ${json.error?.message || 'Unable to generate checkout session'}`);
          if (btn) btn.innerText = 'Proceed to secure checkout →';
        }
      } catch (err: any) {
        alert(`Connection Error: ${err.message || 'Unable to reach payment gateway'}`);
        if (btn) btn.innerText = 'Proceed to secure checkout →';
      }
    });
  </script>

  <style>
    .pay-section { padding: 72px 0 100px; }

    .pay-card { max-width: 640px; margin: 0 auto; padding: 44px; }
    .plan-code {
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold-2);
      margin-bottom: 12px;
    }
    .pay-title { font-size: 26px; margin-bottom: 10px; }
    .pay-b { margin-bottom: 30px; }

    .pay-form { display: flex; flex-direction: column; gap: 20px; }
    .form-group { display: flex; flex-direction: column; gap: 8px; }
    .form-label {
      font-size: 12.5px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--steel);
    }
    .form-input {
      background: #fff;
      border: 1px solid var(--pale);
      border-radius: 8px;
      color: var(--ink);
      font-family: var(--sans);
      font-size: 15px;
      padding: 14px 16px;
      transition: border-color var(--dur-micro) var(--ease);
    }
    .form-input:focus {
      outline: 2px solid var(--gold-2);
      outline-offset: 1px;
      border-color: var(--gold-2);
    }
    .btn-full { width: 100%; justify-content: center; margin-top: 10px; }

    .sec-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 44px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--steel);
    }
    .sec-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--gold-2);
    }

    @media (max-width: 640px) {
      .pay-section { padding: 48px 0 72px; }
      .pay-card { padding: 30px 22px; }
    }
  </style>
</BaseV2>
