---
import BaseV2 from '../layouts/BaseV2.astro';
import PageHero from '../components/v2/PageHero.astro';
import { contactSteps, BOOK_HREF, CONTACT_EMAIL, mailto } from '../data';
---

<BaseV2
  title="Get in touch — Sondri"
  description="Talk to a Sondri founder. Thirty minutes, straight answers, and a free discovery session if there's a case."
>
  <PageHero kicker="Get in touch">
    <Fragment slot="title">Talk to a founder<span class="gdot hero-dot">.</span></Fragment>
    <Fragment slot="lede">
      No SDRs, no qualification form. You'll talk to the people who build the systems,
      and you'll get a straight answer about whether there's a case.
    </Fragment>
  </PageHero>

  <!-- ── Contact actions ──────────────────────────────── -->
  <section class="reach">
    <div class="wrap">
      <div class="ctas" data-reveal>
        <a class="btn btn-gold" href={BOOK_HREF}>Book a discovery call <span class="arr">→</span></a>
        <a class="btn btn-ghost" href={mailto('Hello Sondri')}>{CONTACT_EMAIL}</a>
      </div>
    </div>
  </section>

  <!-- ── What happens next ────────────────────────────── -->
  <section class="steps">
    <div class="wrap">
      <div data-reveal>
        <p class="kicker">What happens next</p>
        <h2 class="h2">Three steps. The first two are free<span class="gdot">.</span></h2>
      </div>
      <div class="step-grid" data-reveal data-reveal-group>
        {contactSteps.map((s) => (
          <div class="card cstep">
            <span class="cstep-i h-serif">{s.i}</span>
            <h3>{s.t}</h3>
            <p class="body-s">{s.b}</p>
          </div>
        ))}
      </div>
      <p class="pay-note" data-reveal>
        Existing customer settling an invoice? <a href="/pay/">Pay an invoice →</a>
      </p>
    </div>
  </section>
</BaseV2>

<style>
  .reach { padding: 64px 0 20px; }

  .steps { padding: 80px 0 110px; }
  .steps .kicker { margin-bottom: 16px; }
  .steps .h2 { margin-bottom: 44px; }
  .step-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .cstep { padding: 32px 28px; }
  .cstep-i { display: block; font-size: 34px; color: var(--gold-2); margin-bottom: 18px; }
  .cstep h3 { margin-bottom: 8px; }

  .pay-note { color: var(--steel); font-size: 14.5px; margin-top: 34px; }
  .pay-note a { color: var(--ink); font-weight: 600; text-decoration: none; }
  .pay-note a:hover { color: var(--slate); }

  @media (max-width: 900px) {
    .step-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .reach { padding-top: 44px; }
    .steps { padding-block: 64px 80px; }
  }
</style>
