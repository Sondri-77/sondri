---
import Base from '../layouts/Base.astro';
---

<Base
  title="Payment Confirmed | Sondri.ai"
  description="Thank you for your payment to Sondri.ai."
>
  <section class="success-hero">
    <div class="container">
      <div class="success-card">
        <div class="icon-circle">✓</div>
        <span class="badge">Payment Confirmed</span>
        <h1>Thank You for Your Payment!</h1>
        <p class="subtitle">
          Your payment has been successfully processed by Stripe. A detailed receipt and tax invoice have been sent to your email.
        </p>

        <div id="downloadsContainer" class="downloads-box" style="display: none;">
          <p class="downloads-title">YOUR TRANSACTION DOCUMENTS</p>
          <div class="downloads-actions">
            <a id="btnReceipt" href="#" target="_blank" rel="noopener" class="btn-dl btn-dl-gold" style="display: none;">
              📥 DOWNLOAD PDF RECEIPT
            </a>
            <a id="btnInvoice" href="#" target="_blank" rel="noopener" class="btn-dl btn-dl-outline" style="display: none;">
              📄 VIEW INVOICE PDF
            </a>
          </div>
        </div>

        <a href="/" class="btn-home">Return to Home Page</a>
      </div>
    </div>
  </section>

  <script>
    const WORKER_BASE = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
      ? 'http://localhost:8787'
      : 'https://billing.sondri.ai';

    async function loadTransactionDocs() {
      const urlParams = new URLSearchParams(window.location.search);
      const sessionId = urlParams.get('session_id');

      if (!sessionId) return;

      try {
        const res = await fetch(`${WORKER_BASE}/checkout-session/${sessionId}`);
        const json = await res.json();

        if (json.success && json.data) {
          const { receipt_url, invoice_url, invoice_pdf } = json.data;
          const container = document.getElementById('downloadsContainer');
          const btnReceipt = document.getElementById('btnReceipt') as HTMLAnchorElement;
          const btnInvoice = document.getElementById('btnInvoice') as HTMLAnchorElement;

          let showContainer = false;

          if (receipt_url && btnReceipt) {
            btnReceipt.href = receipt_url;
            btnReceipt.style.display = 'inline-flex';
            showContainer = true;
          }

          const finalInvoiceLink = invoice_pdf || invoice_url;
          if (finalInvoiceLink && btnInvoice) {
            btnInvoice.href = finalInvoiceLink;
            btnInvoice.style.display = 'inline-flex';
            showContainer = true;
          }

          if (showContainer && container) {
            container.style.display = 'block';
          }
        }
      } catch (err) {
        console.warn('Unable to load receipt/invoice links:', err);
      }
    }

    loadTransactionDocs();
  </script>

  <style>
    .success-hero {
      padding: 140px 0 100px;
      background: var(--bg, #0c1a1a);
      color: var(--ink, #e2e8f0);
      min-height: 85vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Space Grotesk', sans-serif;
    }

    .success-card {
      max-width: 540px;
      margin: 0 auto;
      background: rgba(15, 23, 42, 0.8);
      border: 1px solid rgba(234, 179, 8, 0.3);
      border-radius: 20px;
      padding: 48px;
      text-align: center;
    }

    .icon-circle {
      width: 64px;
      height: 64px;
      background: rgba(16, 185, 129, 0.15);
      border: 2px solid #10b981;
      color: #10b981;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      font-weight: 700;
      margin: 0 auto 20px;
    }

    .badge {
      display: inline-block;
      padding: 4px 12px;
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid #10b981;
      color: #10b981;
      border-radius: 9999px;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 16px;
    }

    .success-card h1 {
      font-size: 26px;
      margin-bottom: 12px;
    }

    .subtitle {
      color: #94a3b8;
      font-size: 14px;
      line-height: 1.6;
      margin-bottom: 24px;
    }

    .info-box {
      background: rgba(0, 0, 0, 0.3);
      border-left: 3px solid var(--gold, #eab308);
      padding: 16px;
      border-radius: 0 8px 8px 0;
      text-align: left;
      font-size: 13px;
      color: #cbd5e1;
      margin-bottom: 32px;
    }

    .info-box p {
      margin-bottom: 4px;
    }

    .btn-home {
      display: inline-block;
      background: var(--gold, #eab308);
      color: #0c1a1a;
      font-weight: 700;
      padding: 12px 28px;
      border-radius: 8px;
      text-decoration: none;
      transition: transform 0.1s;
      margin-top: 12px;
    }

    .btn-home:hover {
      background: #facc15;
    }

    .downloads-box {
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 204, 120, 0.25);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 24px;
      text-align: center;
    }

    .downloads-title {
      font-family: var(--font-mono, monospace);
      font-size: 10px;
      letter-spacing: 2px;
      color: var(--gold, #ffcc78);
      margin-bottom: 14px;
    }

    .downloads-actions {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-dl {
      font-family: var(--font-mono, monospace);
      font-size: 11px;
      letter-spacing: 1.5px;
      padding: 12px 18px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 700;
      transition: all 0.2s ease;
      align-items: center;
      gap: 6px;
    }

    .btn-dl-gold {
      background: var(--gold, #ffcc78);
      color: #0c1a1a;
    }

    .btn-dl-gold:hover {
      background: #ffd99b;
    }

    .btn-dl-outline {
      background: transparent;
      border: 1px solid var(--gold, #ffcc78);
      color: var(--gold, #ffcc78);
    }

    .btn-dl-outline:hover {
      background: rgba(255, 204, 120, 0.15);
    }
  </style>
</Base>
