---
import BaseV2 from '../layouts/BaseV2.astro';
---

<BaseV2
  title="Payment confirmed — Sondri"
  description="Thank you for your payment to Sondri."
>
  <section class="success-section">
    <div class="wrap">
      <div class="card success-card">
        <div class="status-badge">
          <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Payment confirmed</span>
        </div>

        <h1 class="success-title">Thank you for your payment<span class="gdot">.</span></h1>

        <p class="body-s success-lede">
          Your payment has been successfully processed by Stripe. A confirmation email with your
          tax invoice and receipt has been dispatched to your email address.
        </p>

        <div id="downloadsContainer" class="action-wrapper" style="display: none;">
          <a id="btnReceipt" href="#" target="_blank" rel="noopener" class="btn btn-gold btn-full">
            View official receipt &amp; invoice <span class="arr">→</span>
          </a>
        </div>

        <a href="/" class="link-home">← Return to the Sondri homepage</a>
      </div>
    </div>
  </section>

  <script>
    const WORKER_BASE = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1'
      ? 'http://localhost:8787'
      : 'https://billing.sondri.ai';

    async function loadTransactionDocs() {
      const urlParams = new URLSearchParams(window.location.search);
      const sessionId = urlParams.get('session_id');

      if (!sessionId) return;

      try {
        const res = await fetch(`${WORKER_BASE}/checkout-session/${sessionId}`);
        const json = await res.json();

        if (json.success && json.data) {
          const { receipt_url, invoice_url, invoice_pdf } = json.data;
          const container = document.getElementById('downloadsContainer');
          const btnReceipt = document.getElementById('btnReceipt') as HTMLAnchorElement;

          const targetUrl = receipt_url || invoice_url || invoice_pdf;

          if (targetUrl && btnReceipt && container) {
            btnReceipt.href = targetUrl;
            container.style.display = 'block';
          }
        }
      } catch (err) {
        console.warn('Unable to load receipt link:', err);
      }
    }

    loadTransactionDocs();
  </script>

  <style>
    .success-section { padding: 130px 0 110px; }

    .success-card {
      max-width: 580px;
      margin: 0 auto;
      padding: 48px;
      text-align: center;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 16px;
      background: rgba(247, 192, 98, 0.14);
      border: 1px solid var(--gold-2);
      border-radius: var(--r-pill);
      color: var(--ink);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 24px;
    }
    .check-icon { width: 14px; height: 14px; color: var(--gold-2); }

    .success-title { font-size: clamp(26px, 4vw, 34px); line-height: 1.2; margin-bottom: 14px; }
    .success-lede { margin-bottom: 32px; }

    .action-wrapper { margin-bottom: 24px; }
    .btn-full { width: 100%; justify-content: center; }

    .link-home {
      font-size: 14px;
      font-weight: 600;
      color: var(--steel);
      text-decoration: none;
      transition: color var(--dur-micro) var(--ease);
    }
    .link-home:hover { color: var(--ink); }

    @media (max-width: 640px) {
      .success-section { padding: 88px 0 72px; }
      .success-card { padding: 32px 22px; }
    }
  </style>
</BaseV2>
