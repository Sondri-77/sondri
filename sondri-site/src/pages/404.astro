---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Sondri" description="The page you requested does not exist.">
  <section class="section section-pad on-dark lost">
    <div class="wrap">
      <div class="eyebrow"><span class="label">/ 404</span></div>
      <h1 class="h1">Nothing here<span class="gdot">.</span></h1>
      <p class="lede">The page you requested does not exist, or has been moved.</p>
      <a class="btn btn-gold" href="/">Back to the front page <span class="arr">→</span></a>
    </div>
  </section>
</Base>

<style is:global>
  /* No hero under the bar here — solid ink from the start. */
  #siteheader { background: var(--ink); }
</style>

<style>
  .lost { min-height: 70vh; }
  .lost .h1 { margin-block: var(--s-24); }
  .lost .lede { max-width: 48ch; margin-bottom: var(--s-32); }
</style>
