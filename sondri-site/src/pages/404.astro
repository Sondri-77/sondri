---
import BaseV2 from '../layouts/BaseV2.astro';
---

<BaseV2
  title="404 — Sondri"
  description="Signal lost. The page you requested does not exist."
>
  <section class="lost hero-ink">
    <canvas class="glyph-field" data-variant="calm" aria-hidden="true"></canvas>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap">
      <h1 class="anim a2">404<span class="gdot hero-dot">.</span></h1>
      <p class="lede anim a3">The page you requested does not exist, or has been moved.</p>
      <div class="anim a4">
        <a class="btn btn-gold" href="/">← Return Home</a>
      </div>
    </div>
  </section>
</BaseV2>

<style>
  .lost { padding: 140px 0 160px; min-height: 60vh; }
  .lost h1 { font-size: clamp(80px, 12vw, 160px); line-height: 1; margin-bottom: 12px; }
  .lost .lede { margin-bottom: 36px; }
</style>
