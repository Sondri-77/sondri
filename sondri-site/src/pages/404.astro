---
import Base from '../layouts/Base.astro';
---

<Base
  title="404 — Sondri"
  description="Signal lost. The page you requested does not exist."
>
  <section class="lost">
    <div class="artifact panel">
      <div class="artifact-bar">
        <span class="artifact-title">SIGNAL LOST</span>
        <span class="x">404</span>
      </div>
      <div class="body">
        <p class="artifact-body">
          THE PAGE YOU REQUESTED DOES NOT EXIST, OR HAS BEEN MOVED. THE PICTURE NEVER DEVELOPED.
        </p>
        <a class="back" href="/">&larr; RETURN HOME</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 140px var(--pad-x) 80px;
  }
  .panel { width: 420px; max-width: 100%; }
  .x {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
    border: 1px solid var(--ink);
    padding: 0 7px;
  }
  .body { padding: 16px 12px 18px; }
  .body p { margin: 0; }
  .back {
    display: inline-block;
    margin-top: 14px;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }
</style>
