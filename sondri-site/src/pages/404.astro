---
import Base from '../layouts/Base.astro';
import { en } from '../i18n';
import { splitDot } from '../lib/dot';
const nf = en.notFound;
const [h1, dot] = splitDot(nf.h1);
---

<Base title={nf.title} description={nf.description} titleKey="notFound.title" descriptionKey="notFound.description">
  <section class="section section-pad on-dark lost">
    <div class="wrap">
      <div class="eyebrow"><span class="label">/ 404</span></div>
      <h1 class="h1"><span data-i18n="notFound.h1.text">{h1}</span><span class="gdot" data-i18n="notFound.h1.dot">{dot}</span></h1>
      <p class="lede" data-i18n="notFound.lede">{nf.lede}</p>
      <a class="btn btn-gold" href="/"><span data-i18n="notFound.back">{nf.back}</span> <span class="arr">→</span></a>
    </div>
  </section>
</Base>

<style is:global>
  /* No hero under the bar here — solid ink from the start. */
  #siteheader { background: var(--ink); }
</style>

<style>
  .lost { min-height: 70vh; }
  .lost .h1 { margin-block: var(--s-24); }
  .lost .lede { max-width: 48ch; margin-bottom: var(--s-32); }
</style>
