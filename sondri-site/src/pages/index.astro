---
import Base from '../layouts/Base.astro';
import { problemStats, framework, industries, BOOK_HREF } from '../data';
---

<Base
  title="Sondri — AI agents that run inside your business"
  description="Sondri designs, builds, and operates AI agents for private equity, financial services, fintech, healthtech, CPG, and real estate. Live in production in eight weeks."
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-kicker" data-reveal>
        <span class="rule"></span>
        <span class="kicker">SONDRI</span>
      </div>
      <h1 class="display hero-title" data-reveal>
        We build AI agents that run inside your business.
      </h1>
      <p class="lede hero-lede" data-reveal>
        Sondri designs, builds, and operates AI for private equity, financial services, fintech,
        healthtech, CPG, and real estate. Live in production in eight weeks. Measured against
        your P&amp;L.
      </p>
      <div class="hero-ctas" data-reveal>
        <a class="btn-primary" href={BOOK_HREF}>BOOK A DISCOVERY CALL &nbsp;&rarr;</a>
        <a class="btn-ghost" href="/how-it-works/">HOW IT WORKS</a>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="band">
    <div class="wrap section">
      <div class="prob-head" data-reveal>
        <span class="kicker">THE PROBLEM</span>
        <h2 class="display prob-title">Most enterprise AI never ships.</h2>
        <p class="lede prob-lede">
          Pilots launch, decks get approved, and the value never reaches production.
        </p>
      </div>
      <div class="grid-lined g3" data-reveal>
        {problemStats.map((s) => (
          <div class="stat">
            <div class="stat-n" data-count>{s.n}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE FRAMEWORK: 0 → 1 → n -->
  <section class="wrap section">
    <div class="fw-head" data-reveal>
      <span class="kicker">INTRODUCING</span>
      <h2 class="display fw-title">0 &rarr; 1 &rarr; <em class="fw-n">n</em></h2>
      <p class="lede fw-lede">
        Every engagement follows the same arc: prove it, put it in production, then multiply it.
        Zero to one in eight weeks. One to many every month after.
      </p>
    </div>
    <div class="fw-grid" data-reveal>
      {framework.map((p) => (
        <div class="fw-card">
          <div class="fw-top">
            <span class="fw-num">{p.num}</span>
            <span class="fw-when">{p.when}</span>
          </div>
          <div class="fw-name">{p.name}</div>
          <p class="fw-does">{p.does}</p>
          <div class="fw-gets">
            <span class="fw-gets-label">YOU WALK AWAY WITH</span>
            <p>{p.gets}</p>
          </div>
          <span class="fw-price">{p.price}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="band">
    <div class="wrap section">
      <div class="ind-head" data-reveal>
        <span class="kicker">WHO IT'S FOR</span>
        <h2 class="display ind-title">Six industries. One delivery engine.</h2>
      </div>
      <div class="grid-lined g3 ind-grid" data-reveal>
        {industries.map((ind) => (
          <div class="ind">
            <div class="ind-name">{ind.name}</div>
            <p class="ind-line">{ind.line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-band">
    <div class="wrap cta-inner" data-reveal>
      <span class="kicker">NEXT STEP</span>
      <h2 class="display cta-title">Two weeks to a roadmap. Eight weeks to production.</h2>
      <div class="hero-ctas cta-ctas">
        <a class="btn-primary" href={BOOK_HREF}>BOOK A DISCOVERY CALL &nbsp;&rarr;</a>
        <a class="btn-ghost" href="/get-in-touch/">GET IN TOUCH</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ─── HERO ─────────────────────────────────────────────────────────── */
  .hero { padding: 190px var(--pad-x) 120px; }
  .hero-kicker { display: flex; align-items: center; gap: 14px; margin-bottom: 30px; }
  .rule { width: 30px; height: 1px; background: var(--gold); }
  .hero-title {
    font-size: clamp(42px, 6.2vw, 92px);
    line-height: 1.02;
    letter-spacing: -1px;
    max-width: 18ch;
  }
  .hero-lede { max-width: 58ch; margin-top: 30px; letter-spacing: 0.5px; }
  .hero-ctas { display: flex; gap: 18px; margin-top: 42px; flex-wrap: wrap; }

  /* ─── PROBLEM ──────────────────────────────────────────────────────── */
  .band { border-top: 1px solid var(--line); background: var(--ink-deep); }
  .prob-head { margin-bottom: 56px; }
  .prob-title { font-size: clamp(32px, 4.4vw, 60px); line-height: 1.04; letter-spacing: -0.5px; margin-top: 14px; }
  .prob-lede { max-width: 56ch; margin-top: 18px; }
  .stat { padding: 40px 30px; }
  .stat-n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(44px, 6vw, 74px);
    line-height: 1;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }
  .stat-label { font-size: 12px; line-height: 1.9; letter-spacing: 1px; color: var(--clay); margin-top: 18px; }
  .band .grid-lined > * { background: var(--ink-deep); }

  /* ─── FRAMEWORK ────────────────────────────────────────────────────── */
  .fw-head { text-align: center; margin-bottom: 64px; }
  .fw-title { font-size: clamp(44px, 7vw, 100px); line-height: 1; letter-spacing: 1px; margin-top: 18px; }
  .fw-n { font-style: italic; color: var(--gold); }
  .fw-lede { max-width: 58ch; margin: 22px auto 0; }
  .fw-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .fw-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-top: 2px solid var(--gold);
    background: var(--ink);
    padding: 34px 28px;
    transition: border-color 0.25s, transform 0.25s;
  }
  .fw-card:hover { border-color: var(--gold); transform: translateY(-4px); }
  .fw-top { display: flex; align-items: baseline; justify-content: space-between; }
  .fw-num { font-family: var(--font-display); font-weight: 700; font-size: 54px; color: var(--gold); }
  .fw-when { font-size: 10px; letter-spacing: 2px; color: var(--dim-2); }
  .fw-name { font-family: var(--font-display); font-weight: 700; font-size: 24px; color: var(--bone); margin-top: 18px; }
  .fw-does { font-size: 12px; line-height: 1.85; color: var(--clay); margin-top: 12px; }
  .fw-gets { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); }
  .fw-gets-label { font-size: 9px; letter-spacing: 2px; color: var(--gold); }
  .fw-gets p { font-size: 12px; line-height: 1.8; color: var(--body-2); margin-top: 8px; }
  .fw-price { margin-top: auto; padding-top: 24px; font-size: 10px; letter-spacing: 2px; color: var(--dim); }

  /* ─── INDUSTRIES ───────────────────────────────────────────────────── */
  .ind-head { margin-bottom: 56px; }
  .ind-title { font-size: clamp(30px, 4vw, 54px); line-height: 1.05; letter-spacing: -0.5px; margin-top: 14px; }
  .ind { padding: 30px 28px; }
  .ind-name { font-family: var(--font-display); font-weight: 700; font-size: 19px; color: var(--bone); }
  .ind-line { font-size: 12px; line-height: 1.8; color: var(--clay); margin-top: 10px; }

  /* ─── CTA ──────────────────────────────────────────────────────────── */
  .cta-band {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(ellipse 60% 90% at 50% 110%, rgba(255, 204, 120, 0.07), transparent 70%),
      var(--ink);
  }
  .cta-inner { padding: 130px var(--pad-x) 140px; text-align: center; }
  .cta-title {
    font-size: clamp(30px, 4.6vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.5px;
    margin-top: 18px;
    margin-left: auto;
    margin-right: auto;
    max-width: 22ch;
  }
  .cta-ctas { justify-content: center; margin-top: 38px; }

  /* ─── responsive ───────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .hero { padding: 150px var(--pad-x) 90px; }
    .fw-grid { grid-template-columns: 1fr; }
  }
</style>
