---
/* Home = the locked sections, in order (decisions.md D1; "Why Sondri exists" removed by the captain 2026-09-21). Copy comes from
   home-data.ts, verbatim from the workbench's approved home-edgy page (D4). */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Problem from '../components/Problem.astro';
import Knife from '../components/Knife.astro';
import Solution from '../components/Solution.astro';
import SocialProof from '../components/SocialProof.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Comparison from '../components/Comparison.astro';
import Features from '../components/Features.astro';
import Faq from '../components/Faq.astro';
import Solutions from '../components/Solutions.astro';
import FinalCta from '../components/FinalCta.astro';
import { features, homeFaq, socialProof } from '../home-data';
import { en } from '../i18n';

const siteUrl = Astro.site ? Astro.site.origin : 'https://sondri.ai';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${siteUrl}/#service`,
  name: 'Custom Software & AI Workflow Automation',
  serviceType: 'Custom Software & AI Workflow Automation',
  description: en.meta.description,
  url: `${siteUrl}/`,
  provider: { '@id': `${siteUrl}/#organization` },
  areaServed: ['United States', 'Latin America'],
  keywords: [
    'workflow automation',
    'custom business software',
    'AI integration',
    'answer engine optimization',
    'data reporting automation',
    'back office automation',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Sondri Capabilities',
    itemListElement: features.map((f) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: f.t,
        description: f.b,
      },
    })),
  },
};
---

<Base title={en.meta.title} description={en.meta.description} mdPath="/index.md">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <Hero />
  <Marquee />
  <Problem />
  <Knife />
  <!-- From here the scroll follows the nav: How it works, Framework,
       Solutions, Compare, FAQ (captain, 2026-10-31). -->
  <HowItWorks />
  <Solution />
  {socialProof.enabled && <SocialProof />}
  <Solutions />
  <Comparison />
  <Features />
  <Faq />
  <FinalCta />
</Base>

<script>
  import { initDitherBlocks } from '../scripts/dither-block';
  initDitherBlocks();
</script>
