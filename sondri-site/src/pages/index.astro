---
import BaseV2 from '../layouts/BaseV2.astro';
import CtaBand from '../components/v2/CtaBand.astro';
import { BOOK_HREF, problemStats, framework, industries } from '../data';
---

<BaseV2
  title="Sondri — Complex problems. Compressed timelines."
  description="Sondri solves your hardest operational problems with AI, inside the systems you already run. Live in production in eight weeks, measured against your P&L."
>
  <!-- ── Hero ─────────────────────────────────────────── -->
  <section id="hero" class="hero hero-ink" aria-label="Introduction">
    <canvas class="glyph-field" data-variant="full" aria-hidden="true"></canvas>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="wrap" id="content">
      <p class="kicker anim a1">Sondri <span class="k-dot">·</span> Enterprise AI made simple</p>
      <h1 class="display anim a2">
        Complex problems. Compressed <span class="nb"><em>timelines</em><span class="gdot hero-dot">.</span></span>
      </h1>
      <p class="lede anim a3">
        We solve your hardest operational problems with AI, inside the systems you already run.
      </p>
      <div class="ctas anim a4">
        <a class="btn btn-gold" href={BOOK_HREF}>Book a discovery call <span class="arr">→</span></a>
        <a class="btn btn-ghost-dark" href="/how-it-works/">How it works</a>
      </div>
    </div>
  </section>

  <!-- ── Sector strip ─────────────────────────────────── -->
  <div class="sectors" aria-label="Industries served">
    <div class="wrap sect-in">
      {industries.map((i) => <span>{i.name}</span>)}
    </div>
  </div>

  <!-- ── The problem ──────────────────────────────────── -->
  <section class="problem">
    <div class="wrap">
      <div data-reveal>
        <p class="kicker">01 <span class="k-dot">·</span> The problem</p>
        <h2 class="h2">Most enterprise AI never ships<span class="gdot">.</span></h2>
        <p class="lede prob-lede">
          Pilots launch, decks get approved, and the value never reaches production.
        </p>
      </div>
      <div class="stats" data-reveal data-reveal-group>
        {problemStats.map((s) => (
          <div class="stat">
            <b data-count>{s.n}</b>
            <i class="tick" aria-hidden="true"></i>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── The framework: 0 → 1 → n ─────────────────────── -->
  <section class="framework">
    <div class="wrap">
      <div data-reveal>
        <p class="kicker">02 <span class="k-dot">·</span> Introducing</p>
        <h2 class="h2 fw-mark h-serif">0 → 1 → <em>n</em><span class="gdot">.</span></h2>
        <p class="lede fw-lede">
          Every engagement follows the same arc: prove it, put it in production, then multiply it.
          Zero to one in eight weeks. One to many every month after.
        </p>
      </div>
      <div class="fw-grid" data-reveal data-reveal-group>
        {framework.map((p) => (
          <div class:list={['card', 'fw', { hot: p.num === '1' }]}>
            <div class="fw-top">
              <span class="fw-n h-serif">{p.num}</span>
              <span class="fw-when">{p.when.toLowerCase()}</span>
            </div>
            <h3>{p.name}</h3>
            <p class="body-s">{p.does}</p>
            <div class="fw-gets">
              <span class="fw-gets-label">You walk away with</span>
              <p class="body-s">{p.gets}</p>
            </div>
            <span class="fw-price">{p.price.toLowerCase()}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Industries ───────────────────────────────────── -->
  <section class="industries">
    <div class="wrap">
      <div data-reveal>
        <p class="kicker">03 <span class="k-dot">·</span> Who it's for</p>
        <h2 class="h2">Six industries. One delivery engine<span class="gdot">.</span></h2>
      </div>
      <div class="ind-grid" data-reveal data-reveal-group>
        {industries.map((i) => (
          <div class="ind">
            <h3>{i.name}</h3>
            <p class="body-s">{i.line}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA band ─────────────────────────────────────── -->
  <CtaBand kicker="Next step">
    <Fragment slot="title">Two weeks to a roadmap. Eight weeks to production<span class="gdot">.</span></Fragment>
    <Fragment slot="lede">The first conversation is free — and you keep the roadmap either way.</Fragment>
    <Fragment slot="actions">
      <a class="btn btn-gold" href={BOOK_HREF}>Book a discovery call <span class="arr">→</span></a>
      <a class="btn btn-ghost-dark" href="/get-in-touch/">Get in touch</a>
    </Fragment>
  </CtaBand>
</BaseV2>

<style>
  /* ── Hero (ink opening) ── */
  .hero {
    position: relative;
    background: var(--ink);
    color: #fff;
    padding: 120px 0 104px;
    overflow: hidden;
  }
  .hero h1 { color: #fff; max-width: 900px; margin-bottom: 26px; }
  .hero .lede { color: var(--pale); max-width: 620px; margin-bottom: 38px; }

  /* ── Sector strip ── */
  .sectors { background: var(--deep); padding: 18px 0; }
  .sect-in { display: flex; justify-content: space-between; gap: 18px; flex-wrap: wrap; }
  .sect-in span {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--pale);
    transition: color 0.6s var(--ease);
  }
  .sect-in span.lit { color: var(--gold); }

  /* ── Problem ── */
  .problem { padding: 110px 0 100px; }
  .problem .kicker { margin-bottom: 18px; }
  .problem .h2 { max-width: 720px; margin-bottom: 18px; }
  .prob-lede { max-width: 680px; margin-bottom: 56px; }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .stat {
    background: var(--bone);
    border-radius: var(--r-card);
    padding: 34px 32px;
  }
  .stat b {
    display: block;
    font-family: var(--serif);
    font-weight: 560;
    font-size: 52px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat .tick {
    display: block;
    width: 44px;
    height: 2px;
    margin: 12px 0;
    background: var(--gold-2);
    transform: scaleX(0);
    transform-origin: left;
  }
  .stat span { color: var(--steel); font-size: 15px; line-height: 1.5; display: block; }

  /* ── Framework ── */
  .framework { padding: 20px 0 110px; }
  .framework .kicker { margin-bottom: 14px; }
  .fw-mark { margin-bottom: 18px; }
  .fw-lede { max-width: 680px; margin-bottom: 48px; }
  .fw-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: stretch; }
  .fw { display: flex; flex-direction: column; padding: 34px 30px; }
  .fw:hover { transform: translateY(-2px); box-shadow: 0 14px 34px rgba(13, 26, 26, 0.07); }
  .fw-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 48px;
  }
  .fw-n { font-size: 44px; }
  .fw-when {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel);
  }
  .fw h3 { margin-bottom: 10px; }
  .fw.hot { border-color: var(--gold-2); box-shadow: 0 12px 32px rgba(13, 26, 26, 0.06); }
  .fw-gets { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line); }
  .fw-gets-label {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-2);
    margin-bottom: 6px;
  }
  .fw-price {
    margin-top: auto;
    padding-top: 22px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
  }

  /* ── Industries ── */
  .industries { background: var(--bone); padding: 100px 0 110px; }
  .industries .kicker { margin-bottom: 16px; }
  .industries .h2 { margin-bottom: 44px; }
  .ind-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .ind {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: 28px 26px;
  }
  .ind h3 { font-size: 18px; margin-bottom: 8px; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero { padding: 84px 0 72px; }
    .stats, .fw-grid, .ind-grid { grid-template-columns: 1fr; }
    .sect-in { justify-content: flex-start; row-gap: 8px; }
  }
  @media (max-width: 640px) {
    .problem, .framework, .industries { padding-block: 72px; }
    .framework { padding-top: 0; }
  }
</style>
