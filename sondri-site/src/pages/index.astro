---
/* Home = the locked sections, in order (decisions.md D1; "Why Sondri exists" removed by the captain 2026-09-21). Copy comes from
   home-data.ts, verbatim from the workbench's approved home-edgy page (D4). */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Problem from '../components/Problem.astro';
import Knife from '../components/Knife.astro';
import Solution from '../components/Solution.astro';
import SocialProof from '../components/SocialProof.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Comparison from '../components/Comparison.astro';
import Features from '../components/Features.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { homeFaq, socialProof } from '../home-data';
import { en } from '../i18n';

// The FAQ section lives on this page, so its structured data does too.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title={en.meta.title} description={en.meta.description}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Hero />
  <Marquee />
  <Problem />
  <Knife />
  <Solution />
  {socialProof.enabled && <SocialProof />}
  <HowItWorks />
  <Comparison />
  <Features />
  <Faq />
  <FinalCta />
</Base>

<script>
  import { initDitherBlocks } from '../scripts/dither-block';
  initDitherBlocks();
</script>
