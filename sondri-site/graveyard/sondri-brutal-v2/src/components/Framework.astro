---
import { framework } from '../data';
import { phaseTags } from '../v2-data';
import { BOOK_HREF } from '../data';
---

<!-- Their `projects`: a top rule, a centred title, then three columns divided
     by full-height vertical rules, each numbered. -->
<section class="fw px" id="framework">
  <div class="rule-t top"></div>

  <div class="my-grid">
    <div class="head">
      <h2 class="my-title">The framework</h2>
    </div>
  </div>

  <div class="my-grid list">
    <div class="vrules my-grid" aria-hidden="true">
      <div class="c c1"></div>
      <div class="c c2"></div>
      <div class="c c3"></div>
    </div>

    {framework.map((p, i) => (
      <article class="item" data-reveal style={`transition-delay:${i * 70}ms`}>
        <div class="meta">
          <span class="label">{String(i + 1).padStart(2, '0')}</span>
          <span class="label">{phaseTags[i]}</span>
        </div>
        <div class="plate"><span class="my-title">{p.num}</span></div>
        <h3 class="t-sm">{p.gets}</h3>
        <p class="my-text">{p.does}</p>
      </article>
    ))}
  </div>

  <div class="foot">
    <a class="btn btn-solid" href={BOOK_HREF}>View the whole roadmap</a>
  </div>
</section>

<style>
  .fw { padding-bottom: var(--s-15); }
  .top { padding-top: var(--s-50); }
  @media (min-width: 1024px) { .top { padding-top: var(--s-100); } }

  .head { grid-column: 1 / -1; text-align: center; }
  @media (min-width: 1024px) { .head { grid-column: 3 / -3; } }

  .list { position: relative; margin-top: var(--s-66); row-gap: var(--s-60); }
  @media (min-width: 1024px) { .list { margin-top: var(--s-130); padding-bottom: var(--s-40); } }

  .vrules .c { display: none; }
  @media (min-width: 1024px) {
    .vrules .c { display: block; border-left: 1px solid var(--line); grid-row: 1; }
    .c1 { grid-column: 1 / 5; }
    .c2 { grid-column: 5 / 9; }
    .c3 { grid-column: 9 / -1; }
  }

  .item { grid-column: 1 / -1; display: flex; flex-direction: column; gap: var(--s-20); }
  @media (min-width: 1024px) {
    .item { padding-left: var(--gutter); padding-right: var(--gutter); }
    .item:nth-child(2) { grid-column: 1 / 5; }
    .item:nth-child(3) { grid-column: 5 / 9; }
    .item:nth-child(4) { grid-column: 9 / -1; }
  }

  .meta { display: flex; justify-content: space-between; }
  .plate { background: var(--teal); color: var(--white); aspect-ratio: 4 / 3; display: grid; place-items: center; }
  .plate .my-title { font-size: clamp(60px, 7vw, 110px); line-height: 1; }
  .item p { max-width: 40ch; }

  .foot { padding-top: var(--s-60); }
</style>
