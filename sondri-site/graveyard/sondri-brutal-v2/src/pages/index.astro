---
/* Home = the locked 12 sections, in order (decisions.md D1). Copy comes from
   home-data.ts, verbatim from the workbench's home-alt page. */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LogoStrip from '../components/LogoStrip.astro';
import Problem from '../components/Problem.astro';
import Knife from '../components/Knife.astro';
import Solution from '../components/Solution.astro';
import SocialProof from '../components/SocialProof.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Comparison from '../components/Comparison.astro';
import Features from '../components/Features.astro';
import Why from '../components/Why.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { hero } from '../home-data';
---

<Base title={`Sondri — ${hero.h1}`} description={hero.lede}>
  <Hero />
  <LogoStrip />
  <Problem />
  <Knife />
  <Solution />
  <SocialProof />
  <HowItWorks />
  <Comparison />
  <Features />
  <Why />
  <Faq />
  <FinalCta />
</Base>

<script>
  import { initDitherBlocks } from '../scripts/dither-block';
  initDitherBlocks();
</script>
