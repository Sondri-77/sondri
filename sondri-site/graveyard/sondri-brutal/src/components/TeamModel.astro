---
import { teamModel } from '../data';
---

<section class="section section-pad" id="about">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="eyebrow"><span class="sq"></span><span class="label">/ The model</span></div>
        <h2 class="h2">Senior architects. Vetted builders. Your operators<span class="gdot">.</span></h2>
      </div>
      <div class="intro">
        <p class="lede">
          One quality gate held by the people who designed the system, and a delivery bench that
          doesn&rsquo;t cost what a big-four bench costs.
        </p>
      </div>
    </div>

    <div class="rule-cols cols-3 cards">
      {teamModel.map((t, i) => (
        <article data-reveal style={`transition-delay:${i * 80}ms`}>
          <p class="label tag">{t.tag}</p>
          <h3 class="h5">{t.title}</h3>
          <p class="body-s">{t.body}</p>
          <span class="idx label">{String(i + 1).padStart(2, '0')} / 03</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cards article { display: flex; flex-direction: column; gap: var(--s-16); min-height: 320px; }
  .tag { color: var(--accent); }
  .idx { margin-top: auto; padding-top: var(--s-24); border-top: 1px solid var(--line-soft); }
</style>
