---
import { timeline } from '../data';
---

<section class="section section-pad" id="how">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="eyebrow"><span class="sq"></span><span class="label">/ How it works</span></div>
        <h2 class="h2">Four weeks, start to running<span class="gdot">.</span></h2>
      </div>
      <div class="intro">
        <p class="lede">
          No discovery phase that bills for a quarter. We sit with your operators in week one and
          your software is live in your environment by week four.
        </p>
      </div>
    </div>

    <ol class="rule-cols cols-4 steps">
      {timeline.map((t, i) => (
        <li data-reveal style={`transition-delay:${i * 70}ms`}>
          <p class="label wk">WK {t.wk}</p>
          <div class="tick" aria-hidden="true"><span></span></div>
          <h3 class="h5">{t.title}</h3>
          <p class="body-s">{t.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; }
  .steps li { display: flex; flex-direction: column; gap: var(--s-16); min-height: 300px; }
  .wk { color: var(--accent); }
  /* Their list marker: a filled square ahead of the mono index. */
    .wk::before {
    content: ''; display: inline-block;
    width: 7px; height: 7px; margin-right: 10px; vertical-align: 1px;
    background: currentColor;
  }
  .tick { height: 1px; background: var(--line); position: relative; margin-block: var(--s-08); }
  .tick span { position: absolute; left: 0; top: -3px; width: 7px; height: 7px; background: var(--accent); }
  .steps h3 { margin-top: var(--s-08); }
  .steps .body-s { margin-top: auto; }
</style>
