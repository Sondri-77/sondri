---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { CTA_PRIMARY, RISK_REVERSAL, problemStats, framework, capabilities, feelSteps } from '../data/copy';
---

<Base title="Sondri — Simple solutions to not-so-simple problems">
  <section>
    <h1>Simple solutions to not-so-simple problems.</h1>
    <p>We build software for the work slowing your business down.</p>
    <div class="ctas">
      <Btn href="#">{CTA_PRIMARY} →</Btn>
      <Btn href="/how-it-works/">See How It Works</Btn>
    </div>
    <p>{RISK_REVERSAL}</p>
  </section>

  <section>
    <div class="strip">{capabilities.map((c) => <span>{c}</span>)}</div>
  </section>

  <section>
    <h2>Everyone has an AI initiative. Almost nobody has one in production.</h2>
    <p>Teams approve AI pilots that never become software people use.</p>
    <div class="cards">
      {problemStats.map((s) => (
        <div class="card stat">
          <b>{s.n}</b>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section>
    <h2>0 → 1 → n.</h2>
    <p>Start with one workflow, then decide whether to fund the next build.</p>
    <div class="cards">
      {framework.map((p) => (
        <div class="card">
          <p>{p.num}</p>
          <h3>{p.name}</h3>
          <p>{p.does}</p>
          <p>You walk away with</p>
          <p>{p.gets}</p>
        </div>
      ))}
    </div>
    <p>Long-term customers can hire us to advise on technology purchases and plans.</p>
  </section>

  <section>
    <h2>You never have to become an AI company.</h2>
    <p>Here’s how we build software with your team.</p>
    <div class="cards">
      {feelSteps.map((s) => (
        <div class="card">
          <p>{s.i}</p>
          <h3>{s.t}</h3>
          <p>{s.b}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <div class="card">
      <p>"We started Sondri after watching teams spend eighteen months on AI pilots that never shipped. We help them choose a workflow to fix, build the software, and put it to use."</p>
      <a href="/get-in-touch/">Get in Touch →</a>
    </div>
  </section>

  <section>
    <h2>The first conversation is free. The roadmap is yours either way.</h2>
    <div class="ctas">
      <Btn href="#">{CTA_PRIMARY} →</Btn>
    </div>
  </section>
</Base>
