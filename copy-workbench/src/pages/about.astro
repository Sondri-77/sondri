---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { mailto } from '../data/copy';
---

<Base title="About — Sondri">
  <section>
    <h1>Built by people who’ve put AI to work.</h1>
    <p>Our senior team and specialist network build AI software for businesses. We’re hiring our first ten people.</p>
    <div class="ctas">
      <Btn href="#">Book a Discovery Sprint →</Btn>
    </div>
  </section>

  <section>
    <h2>Why we started Sondri.</h2>
    <p>We build software for small and midsize businesses that can’t afford enterprise consulting fees. It runs in their existing systems, and we measure how much time and money it saves.</p>
    <p>Help us build it. <a href={mailto('Founding-team application')}>Careers →</a></p>
  </section>
</Base>
