---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
---

<Base title="Payment confirmed — Sondri">
  <section>
    <div class="card">
      <p>Payment confirmed</p>
      <h1>Thank you for your payment.</h1>
      <p>Stripe processed your payment and emailed your invoice and receipt.</p>
      <div class="ctas">
        <Btn href="#">View Receipt &amp; Invoice →</Btn>
      </div>
      <a href="/">← Return to the Sondri homepage</a>
    </div>
  </section>
</Base>
