---
/**
 * EDGY — the locked 12 sections (decision D1), rewritten in the captain's
 * voice. Same order and roughly the same facts as home-alt; different mouth.
 * Slot 2 is the capability strip from the live site (no logo strip).
 * Every big heading has 3 variants (primary + 2), cycled by the ‹ › control.
 * `[placeholder]` marks proof we don't have yet.
 */
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import Heading from '../components/Heading.astro';
import { CTA_PRIMARY, RISK_REVERSAL, problemStats, capabilities } from '../data/copy';

const VALUE_LINE =
  'We fix the work costing your team time and money, using AI where it helps.';

const knife = [
  { t: 'Money', b: 'An hour a day wasted, for every person stuck doing it. Count them. [placeholder: cost-of-inaction calculator]' },
  { t: 'Time', b: 'As volume grows, more people get stuck doing it by hand. Waiting makes the fix harder.' },
  { t: 'People', b: 'Your best people are stuck doing data entry. If Greg quits, who else knows all the steps?' },
];

const benefits = [
  { t: 'Cost and savings', b: 'Pick a cost to cut or a way to increase revenue. We measure the change.' },
  { t: 'Your systems, your code', b: 'Built into your existing ERP, CRM, and spreadsheets. You own the code.' },
  { t: 'One phase at a time', b: 'Agree on a fixed price for each phase, then review the work before funding the next.' },
];

const testimonials = [
  { q: '[placeholder] "We’d been talking about fixing invoice matching for two years. Six weeks later it was live and it just… works."', who: '[placeholder] COO, regional logistics company · [placeholder] 14 hrs/week back to the finance team' },
  { q: '[placeholder] "They told us on the first call which of our three ideas was worth doing. That’s why we hired them."', who: '[placeholder] CFO, mid-market manufacturer · [placeholder] first build in production in 7 weeks' },
  { q: '[placeholder] "Our team owns the code and can read every line."', who: '[placeholder] Head of Ops, healthcare services group · [placeholder] $180k annual cost gone' },
];

const steps = [
  { i: '01', t: 'Tell us what’s slow', b: 'Spend thirty minutes describing the work wasting your week. Come as you are.' },
  { i: '02', t: 'We build it into your systems', b: 'You keep running the business. We build on the tech and data you already have.' },
  { i: '03', t: 'Check what changed', b: 'Compare the hours and money spent on the job before and after the build.' },
];

const comparison = {
  cols: ['Sondri', 'Typical agency / SI', 'Hiring in-house', 'DIY tools'],
  rows: [
    { k: 'Time to something in production', v: ['Weeks [placeholder: 6–8]', 'Quarters [placeholder: 6–9 mo.]', 'Months to hire, then months to build', 'Days to try; integration takes longer'] },
    { k: 'Cost shape', v: ['Fixed price per phase, quoted before it starts', 'Time & materials; cost depends on scope', 'Salary + benefits + management, project or not', 'Low fees; you do the work'] },
    { k: 'Who owns the code', v: ['You; runs in your environment', 'Often the vendor’s platform or license', 'You', 'You, and whoever set it up'] },
    { k: 'Commitment up front', v: ['One phase; discovery is free', 'Multi-phase SOW before the first thing ships', 'A full-time headcount', 'No contract; maintenance is on you'] },
    { k: 'After launch', v: ['We maintain it and build the next workflow', 'Change orders, or a handoff deck', 'Depends on whether that person stays', 'You fix it when the workflow changes'] },
  ],
};

const features = [
  { t: 'Workflow Automation', b: 'The three-person, half-a-day process, done by software, with a human approval gate where it matters.' },
  { t: 'Data & Reporting', b: 'The numbers you argue about in meetings, pulled from the systems of record and kept current without anyone re-keying them.' },
  { t: 'Customer Operations', b: 'Handle quotes, onboarding, tickets, and renewals faster without adding headcount.' },
  { t: 'Back Office', b: 'Invoicing, matching, claims, collections, close. The unglamorous work where a typo costs real money.' },
  { t: 'Integrations', b: 'Connect the systems your team copies data between, including that spreadsheet nobody is allowed to delete.' },
  { t: 'Agentic AI Solutions', b: 'AI that runs a multi-step job end to end, with monitoring, audit trails, and a person who can pull the plug.' },
];

const faq = [
  { q: 'Does our data leave our systems?', a: 'Everything we build runs in your environment, with your access controls, approval steps, and audit logs.' },
  { q: 'What do you build on?', a: 'We connect to your existing ERP, CRM, spreadsheets, and payment systems. You can run the code without a Sondri platform or license.' },
  { q: 'Who owns what you build?', a: 'You own the code, integrations, and docs, all in your environment.' },
  { q: 'What does it cost?', a: 'We quote a fixed price before each phase. You decide whether to fund the next one.' },
  { q: 'What if the first build misses its baseline?', a: 'We agree on a baseline before we start and measure the build against it. If it falls short, you keep the roadmap and measurements and owe nothing further.' },
  { q: 'How fast can we start?', a: 'The first call is free, the roadmap takes days, and working software follows in weeks.' },
  { q: 'Why not just hire an agency, or someone in-house?', a: 'An agency may suit a larger project; a hire can make sense for ongoing work. Check their costs and lead times against our price for one phase. You own the code, and we stick around to maintain it. If hiring fits better, we’ll say so.' },
  { q: 'Do you use AI for everything?', a: 'We choose AI or regular software based on the job. We’re not going to fuck up your business just to say we used AI.' },
];
---

<Base title="Sondri — Home (edgy)" footerLine={VALUE_LINE}>
  <section>
    <p class="label">Hero</p>
    <Heading tag="h1" v={['We fix expensive bullshit. (Using AI where it helps)', 'We fix problems costing you time, money, and the will to fucking live.', 'Fix the process costing you a fucking fortune.']} />
    <p>Live in your existing systems in weeks, using AI where it helps.</p>
    <div class="ctas">
      <Btn href="#">{CTA_PRIMARY} →</Btn>
    </div>
    <p>{RISK_REVERSAL} The roadmap is yours either way.</p>
  </section>

  <section>
    <p class="label">Things we do</p>
    <div class="marquee" aria-label="Capabilities">
      <div class="track">
        {[...capabilities, ...capabilities].map((c) => <span>{c}</span>)}
      </div>
    </div>
  </section>

  <section>
    <p class="label">Problem</p>
    <Heading tag="h2" v={['Your people aren’t inefficient. The shit you make them use is.', 'Somewhere in your business, an expensive person is copying and pasting something.', 'Everyone has an AI initiative. Almost nobody has one in production.']} />
    <p>Good people are wasting hours on a process everybody agrees is stupid. The available software doesn’t handle it, and traditional consulting costs a small fucking fortune.</p>
    <div class="cards">
      {problemStats.map((s) => (
        <div class="card stat">
          <b>{s.n}</b>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
    <p>Eighteen months after the pilot launched, your team is still doing the same shit by hand.</p>
  </section>

  <section>
    <p class="label">Twist the knife</p>
    <Heading tag="h2" v={['That workaround has been temporary for four fucking years.', 'Now there are extra steps to fix the workaround.', 'Leaving it alone isn’t free.']} />
    <p>Count the hours your team spends keeping the workaround going.</p>
    <div class="cards">
      {knife.map((k) => (
        <div class="card">
          <h3>{k.t}</h3>
          <p>{k.b}</p>
        </div>
      ))}
    </div>
    <p>Your team knows every extra step by heart. They still have to waste time doing them.</p>
  </section>

  <section>
    <p class="label">Solution &amp; benefits</p>
    <Heading tag="h2" v={['We unf*ck how work gets done.', 'Fix the process everyone complains about.', '0 → 1 → n.']} />
    <p>Pick three workflows worth fixing, then build for the first. Reuse that work for the next one.</p>
    <ul>
      {benefits.map((b) => (
        <li><b>{b.t}.</b> {b.b}</li>
      ))}
    </ul>
  </section>

  <section>
    <p class="label">Social proof</p>
    <Heading tag="h2" v={['From “this is fucking stupid” to “it just works.”', 'What customers say about the work.', 'Ask customers how their software holds up.']} />
    <div class="cards">
      {testimonials.map((t) => (
        <div class="card">
          <p>{t.q}</p>
          <p class="who">{t.who}</p>
        </div>
      ))}
    </div>
    <p class="ph">All three are placeholders, shape only (role, company type, number). Replace with real customer quotes before this ships.</p>
  </section>

  <section>
    <p class="label">How it works</p>
    <Heading tag="h2" v={['Just fix the damn thing.', 'You never have to become an AI company.', 'Thirty minutes. Then we build.']} />
    <p>Here’s how we fix the process slowing your team down.</p>
    <div class="cards">
      {steps.map((s) => (
        <div class="card">
          <p>{s.i}</p>
          <h3>{s.t}</h3>
          <p>{s.b}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <p class="label">Competitor comparison</p>
    <Heading tag="h2" v={['A lot of consultants will charge you to rename your problem.', 'Let’s find out why your software sucks.', 'What will it take to fix it?']} />
    <p>Compare the time and money each option takes. Ask who’s responsible for fixing it after launch.</p>
    <table>
      <thead>
        <tr>
          <th></th>
          {comparison.cols.map((c) => <th>{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {comparison.rows.map((r) => (
          <tr>
            <th>{r.k}</th>
            {r.v.map((cell) => <td>{cell}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="ph">Numbers marked [placeholder] need a source or a real engagement behind them before publishing.</p>
  </section>

  <section>
    <p class="label">Features</p>
    <Heading tag="h2" v={['Unsexy solutions that work ridiculously well.', 'Retire the fucking workaround.', 'Six things we build. Bring us the messy one.']} />
    <ul>
      {features.map((f) => (
        <li><b>{f.t}.</b> {f.b}</li>
      ))}
    </ul>
  </section>

  <section>
    <p class="label">Why Sondri exists</p>
    <Heading tag="h2" v={['Fuck the future of work. Let’s fix the work you have now.', 'We use AI when it helps with the job.', 'How much did you spend on that unused AI strategy?']} />
    <div class="card">
      <p>"We started Sondri after watching teams spend eighteen months on AI pilots that never shipped. People were still stuck with the same expensive, annoying work. We build software they can put to use."</p>
      <p>Show us the process so we can understand the damn thing and fix it.</p>
      <a href="/get-in-touch/">Get in Touch →</a>
    </div>
  </section>

  <section>
    <p class="label">FAQ</p>
    <Heading tag="h2" v={['Things people ask before they trust us with money.', 'Asked on almost every intro call.', 'Fine. Ask.']} />
    {faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section>
    <p class="label">Final CTA</p>
    <Heading tag="h2" v={['Stop paying smart people to babysit stupid systems.', 'Tell us which system is wasting your time.', 'The first conversation is free. The roadmap is yours either way.']} />
    <p>Spend thirty minutes with a founder on the process that pisses you off most. We’ll tell you whether we can fix it or whether you’re better off hiring someone.</p>
    <div class="ctas">
      <Btn href="#">{CTA_PRIMARY} →</Btn>
    </div>
    <p>{RISK_REVERSAL}</p>
  </section>
</Base>

<script>
  // Cycle heading variants in place. One handler for the whole page.
  document.querySelectorAll<HTMLElement>('.hv').forEach((hv) => {
    const vs = hv.querySelectorAll<HTMLElement>('.v');
    const n = hv.querySelector<HTMLElement>('.n')!;
    let i = 0;
    const show = () => {
      vs.forEach((v, k) => (v.hidden = k !== i));
      n.textContent = `${i + 1}/${vs.length}`;
    };
    hv.querySelector('.prev')!.addEventListener('click', () => { i = (i + vs.length - 1) % vs.length; show(); });
    hv.querySelector('.next')!.addEventListener('click', () => { i = (i + 1) % vs.length; show(); });
    show();
  });
</script>

<style>
  @font-face {
    font-family: 'Florexa';
    src: url('/fonts/florexa.woff2') format('woff2');
    font-display: swap;
  }
  .label { color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
  .sub { font-size: 18px; }
  .ph { color: #888; font-size: 14px; }
  .who { color: #666; font-size: 14px; }
  .marquee { overflow: hidden; border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 10px 0; }
  .track { display: flex; gap: 40px; width: max-content; white-space: nowrap; animation: scroll 24s linear infinite; }
  .track span { font-family: 'Florexa', sans-serif; font-size: 20px; text-transform: uppercase; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 0 0 12px; }
  th, td { border: 1px solid #eee; padding: 8px; text-align: left; vertical-align: top; }
  thead th { background: #f5f5f5; }
  tbody th { font-weight: normal; color: #666; }
</style>
