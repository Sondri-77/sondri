---
/**
 * PROPOSAL — alternate home page (first-draft copy).
 * Blends the 10 sections from docs/comparison-sections.html with the site's
 * existing home sections (founder note kept as its own section) plus two
 * added after Problem: "Twist the knife".
 * Numbered labels are intentional on this page. `[placeholder]` marks
 * proof/claims we don't have yet.
 */
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { CTA_PRIMARY, RISK_REVERSAL, problemStats, faq } from '../data/copy';

const knife = [
  { t: 'Money', b: 'An hour a day adds up across everyone doing the workaround. [placeholder: cost-of-inaction calculator]' },
  { t: 'Time', b: 'As volume grows, your team spends more time on manual work. The longer you wait, the more processes depend on the workaround.' },
  { t: 'People', b: 'Experienced people spend hours on data entry. When they leave, undocumented steps can be lost.' },
];

const benefits = [
  { t: 'Cost and savings', b: 'We agree on a cost to cut or a way to increase revenue, then measure the change.' },
  { t: 'Your systems, your code', b: 'Built into your existing ERP, CRM, and spreadsheets, with code your team owns.' },
  { t: 'One phase at a time', b: 'Agree on a fixed price for each phase, then review the work before funding the next.' },
];

const testimonials = [
  { q: '[placeholder] "We had talked about fixing invoice matching for two years. It was live in six weeks and it just… works."', who: '[placeholder] COO, regional logistics company · [placeholder] 14 hrs/week back to the finance team' },
  { q: '[placeholder] "They told us on the first call which of our three ideas was worth doing. That honesty is why we hired them."', who: '[placeholder] CFO, mid-market manufacturer · [placeholder] first solution in production in 7 weeks' },
  { q: '[placeholder] "Our team owns the code and can read every line."', who: '[placeholder] Head of Ops, healthcare services group · [placeholder] $180k annual cost removed' },
];

const steps = [
  { i: '01', t: 'Tell us what’s slow', b: 'Spend thirty minutes describing the process that slows you down. You can come without preparing anything.' },
  { i: '02', t: 'We build it into your systems', b: 'You keep running the business. We build on the tech and data you already have.' },
  { i: '03', t: 'Check the time and cost saved', b: 'Compare the time and cost of the workflow before and after the build.' },
];

const comparison = {
  cols: ['Sondri', 'Typical agency / SI', 'Hiring in-house', 'DIY tools'],
  rows: [
    { k: 'Time to something in production', v: ['Weeks [placeholder: 6–8]', 'Quarters [placeholder: 6–9 mo.]', 'Months to hire, then months to build', 'Days to try; integration takes longer'] },
    { k: 'Cost shape', v: ['Fixed price per phase, quoted before it starts', 'Time & materials; cost depends on scope', 'Salary + benefits + management, whether or not there’s a project', 'Low fees; your team does the work'] },
    { k: 'Who owns the code', v: ['You; runs in your environment', 'Often the vendor’s platform or license', 'You', 'You — and whoever set it up'] },
    { k: 'Commitment up front', v: ['One phase; discovery is free', 'Multi-phase contract before launch', 'A full-time headcount', 'No contract; your team maintains it'] },
    { k: 'After launch', v: ['We maintain it and build the next workflow', 'Change orders, or a handoff deck', 'Depends on whether that person stays', 'Your team updates it when the workflow changes'] },
  ],
};

const features = [
  { t: 'Workflow Automation', b: 'The three-person, half-a-day process, done by software with a human approval gate where it matters.' },
  { t: 'Data & Reporting', b: 'The numbers you argue about in meetings, pulled from the systems of record and kept current without anyone re-keying them.' },
  { t: 'Customer Operations', b: 'Quoting, onboarding, tickets, renewals — faster responses without adding headcount.' },
  { t: 'Back Office', b: 'Invoicing, matching, claims, collections, close. The unglamorous work where errors cost real money.' },
  { t: 'Integrations', b: 'Connect your systems and spreadsheets so staff can stop copying data between them.' },
  { t: 'Agentic AI Solutions', b: 'AI that runs a multi-step job end to end — with monitoring, audit trails, and a person who can stop it.' },
];

const extraFaq = [
  {
    q: 'Why not just hire an agency, or someone in-house?',
    a: 'An agency may suit a larger project; a hire can make sense for ongoing work. Compare their costs and lead times with our fixed price for one phase. You own what we build, and we support it after launch. We’ll recommend hiring if that fits your needs better.',
  },
  {
    q: 'Do you use AI for everything?',
    a: 'We choose AI or regular software based on the job it needs to do.',
  },
];
---

<Base title="Sondri — Home (alt: 10-section proposal)">
  <section>
    <p class="label">1 · Hero</p>
    <h1>Simple solutions to not-so-simple problems.</h1>
    <p>We build software into your existing systems in weeks, using AI when it helps.</p>
    <div class="ctas">
      <Btn href="#">{CTA_PRIMARY} →</Btn>
    </div>
    <p>{RISK_REVERSAL} The roadmap is yours either way.</p>
  </section>

  <section>
    <p class="label">2 · Logo / social-proof strip</p>
    <p>Customer references: <span class="ph">[placeholder] client count / one-line proof</span></p>
    <div class="logos">
      {[1, 2, 3, 4, 5, 6].map(() => <div class="logo">[placeholder] client logo</div>)}
    </div>
  </section>

  <section>
    <p class="label">3 · Problem</p>
    <h2>Everyone has an AI initiative. Almost nobody has one in production.</h2>
    <p>Eighteen months after the pilot launched, people are still doing the work by hand. The team hasn’t found a way to put the software into use.</p>
    <div class="cards">
      {problemStats.map((s) => (
        <div class="card stat">
          <b>{s.n}</b>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
    <p>Start with the process costing your team the most time.</p>
  </section>


  <section>
    <p class="label">4 · Twist the knife</p>
    <h2>Leaving it alone isn’t free.</h2>
    <p>Count the hours your team spends on the workaround.</p>
    <div class="cards">
      {knife.map((k) => (
        <div class="card">
          <h3>{k.t}</h3>
          <p>{k.b}</p>
        </div>
      ))}
    </div>
    <p>How many hours have you spent on it since you first discussed a fix?</p>
  </section>

  <section>
    <p class="label">5 · Solution &amp; benefits</p>
    <h2>0 → 1 → n.</h2>
    <p>Discovery identifies three workflows to improve. We build for the first, then reuse that work for the next.</p>
    <ul>
      {benefits.map((b) => (
        <li><b>{b.t}.</b> {b.b}</li>
      ))}
    </ul>
  </section>

  <section>
    <p class="label">6 · Social proof</p>
    <h2>What customers say about the work.</h2>
    <div class="cards">
      {testimonials.map((t) => (
        <div class="card">
          <p>{t.q}</p>
          <p class="who">{t.who}</p>
        </div>
      ))}
    </div>
    <p class="ph">All three are placeholders — shape only (role, company type, measured change). Replace with real customer quotes before this ships.</p>
  </section>

  <section>
    <p class="label">7 · How it works</p>
    <h2>You never have to become an AI company.</h2>
    <p>Here’s how we build software with your team.</p>
    <div class="cards">
      {steps.map((s) => (
        <div class="card">
          <p>{s.i}</p>
          <h3>{s.t}</h3>
          <p>{s.b}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <p class="label">8 · Competitor comparison</p>
    <h2>Compare ways to get the work done.</h2>
    <p>Compare the cost of outside help with the time your own team can commit.</p>
    <table>
      <thead>
        <tr>
          <th></th>
          {comparison.cols.map((c) => <th>{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {comparison.rows.map((r) => (
          <tr>
            <th>{r.k}</th>
            {r.v.map((cell) => <td>{cell}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="ph">Numbers marked [placeholder] need a source or a real engagement behind them before publishing.</p>
  </section>

  <section>
    <p class="label">9 · Features</p>
    <h2>Six things we build. Bring us the messy one.</h2>
    <ul>
      {features.map((f) => (
        <li><b>{f.t}.</b> {f.b}</li>
      ))}
    </ul>
  </section>

  <section>
    <p class="label">10 · Why Sondri exists</p>
    <div class="card">
      <p>"We started Sondri after watching teams spend eighteen months on AI pilots that never shipped. We help them choose a workflow to fix, build the software, and put it to use."</p>
      <p>We use AI when it helps with the job.</p>
      <a href="/get-in-touch/">Get in Touch →</a>
    </div>
  </section>

  <section>
    <p class="label">11 · FAQ</p>
    <h2>Asked on almost every intro call.</h2>
    {[...faq, ...extraFaq].map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section>
    <p class="label">12 · Final CTA</p>
    <h2>The first conversation is free. The roadmap is yours either way.</h2>
    <p>Spend thirty minutes with a founder describing the process you want to fix. We’ll tell you whether we can help.</p>
    <div class="ctas">
      <Btn href="#">{CTA_PRIMARY} →</Btn>
    </div>
    <p>{RISK_REVERSAL}</p>
  </section>
</Base>

<style>
  .label { color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
  .ph { color: #888; font-size: 14px; }
  .who { color: #666; font-size: 14px; }
  .logos { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 8px; }
  .logo { background: #ddd; color: #666; font-size: 11px; text-align: center; height: 48px; display: flex; align-items: center; justify-content: center; padding: 4px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 0 0 12px; }
  th, td { border: 1px solid #eee; padding: 8px; text-align: left; vertical-align: top; }
  thead th { background: #f5f5f5; }
  tbody th { font-weight: normal; color: #666; }
</style>
