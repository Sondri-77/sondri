---
/**
 * PROPOSAL — alternate home page (first-draft copy).
 * Blends the 10 sections from docs/comparison-sections.html with the site's
 * existing home sections (founder note kept as its own section) plus two
 * added after Problem: "Describe the problem" and "Twist the knife".
 * Numbered labels are intentional on this page. `[placeholder]` marks
 * proof/claims we don't have yet.
 */
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { CTA_PRIMARY, RISK_REVERSAL, problemStats, faq } from '../../../sondri-site/src/data';

const symptoms = [
  'The same data gets typed into two systems because they don’t talk.',
  'One process only works because Dana knows how it works. Nobody talks about what happens if Dana leaves.',
  'The month-end number lives in a spreadsheet that three people email around and nobody fully trusts.',
  'A quote, a claim, or an approval sits in someone’s inbox for days. The customer notices.',
  'Everyone has a workaround. None of them are the same workaround.',
  'You tried the software. It created three new problems.',
];

const knife = [
  { t: 'Money', b: 'A workaround that costs an hour a day is a salary a year — per person doing it. Multiply by the number of people who’ve quietly learned to live with it. [placeholder: cost-of-inaction calculator]' },
  { t: 'Time', b: 'Every quarter the problem stays, growth makes it heavier. More volume means more manual work, not more leverage. The fix doesn’t get cheaper by waiting — it gets harder to unwind.' },
  { t: 'People', b: 'Your best operators are spending their judgment on data entry. That’s the work people leave over. And when they go, the process leaves with them.' },
];

const benefits = [
  { t: 'A number, not a deck', b: 'Every engagement starts from a line on your P&L — a cost to cut or revenue to unlock — and is measured against it.' },
  { t: 'Your systems, your code', b: 'Built into the ERP, CRM, and spreadsheets you already run. No Sondri platform to adopt, nothing to license, nothing to migrate off later.' },
  { t: 'One rung at a time', b: 'Fixed price per phase, agreed before it starts. Prove it before you fund production. Fund production before you fund scale.' },
];

const testimonials = [
  { q: '[placeholder] "We had talked about fixing invoice matching for two years. It was live in six weeks and it just… works."', who: '[placeholder] COO, regional logistics company · [placeholder] 14 hrs/week back to the finance team' },
  { q: '[placeholder] "They told us on the first call which of our three ideas was worth doing. That honesty is why we hired them."', who: '[placeholder] CFO, mid-market manufacturer · [placeholder] first solution in production in 7 weeks' },
  { q: '[placeholder] "No platform, no lock-in. Our team owns it and can read every line."', who: '[placeholder] Head of Ops, healthcare services group · [placeholder] $180k annual cost removed' },
];

const steps = [
  { i: '01', t: 'Tell us what’s slow', b: 'Thirty minutes on the work that eats your team’s time. No prep, no jargon, no deck.' },
  { i: '02', t: 'We build it into your systems', b: 'You keep running the business. We build on the tech and data you already have.' },
  { i: '03', t: 'You see the number move', b: 'A workflow that used to be slow, running fast — and a line on the P&L that changed.' },
];

const comparison = {
  cols: ['Sondri', 'Typical agency / SI', 'Hiring in-house', 'DIY tools'],
  rows: [
    { k: 'Time to something in production', v: ['Weeks [placeholder: 6–8]', 'Quarters [placeholder: 6–9 mo.]', 'Months to hire, then months to build', 'Days — until it touches a real system'] },
    { k: 'Cost shape', v: ['Fixed price per phase, quoted before it starts', 'Time & materials; scope grows with the invoice', 'Salary + benefits + management, whether or not there’s a project', 'Cheap, then your time'] },
    { k: 'Who owns the code', v: ['You. Runs in your environment', 'Often the vendor’s platform or license', 'You', 'You — and whoever set it up'] },
    { k: 'Commitment up front', v: ['One rung. Discovery is free', 'Multi-phase SOW before the first result', 'A full-time headcount', 'None — and no one accountable'] },
    { k: 'After launch', v: ['We operate, tune, and ship the next one', 'Change orders, or a handoff deck', 'Depends on whether that person stays', 'It breaks when the workflow changes'] },
  ],
};

const features = [
  { t: 'Workflow Automation', b: 'The three-person, half-a-day process, done by software with a human approval gate where it matters.' },
  { t: 'Data & Reporting', b: 'The numbers you argue about in meetings, pulled from the systems of record and kept current without anyone re-keying them.' },
  { t: 'Customer Operations', b: 'Quoting, onboarding, tickets, renewals — faster responses without adding headcount.' },
  { t: 'Back Office', b: 'Invoicing, matching, claims, collections, close. The unglamorous work where errors cost real money.' },
  { t: 'Integrations', b: 'The systems that don’t talk, made to talk. Yes, that includes the spreadsheet.' },
  { t: 'Agentic AI Solutions', b: 'AI that runs a multi-step job end to end — with monitoring, audit trails, and a person who can stop it.' },
];

const extraFaq = [
  {
    q: 'Why not just hire an agency, or someone in-house?',
    a: 'Both work — if you have a quarter and a budget to burn before the first result. An agency sells you a multi-phase engagement up front; a hire takes months to land and only helps if that person stays. We quote one phase at a time, you own everything we build, and we stay on to run it. If the honest answer for you is “hire someone,” we’ll say so on the first call.',
  },
  {
    q: 'Do you use AI for everything?',
    a: 'No. We use AI where it makes the solution better and regular software where it doesn’t. Nobody is impressed that it uses AI. What matters is whether the problem is gone.',
  },
];
---

<Base title="Sondri — Home (alt: 10-section proposal)">
  <section>
    <p class="label">1 · Hero</p>
    <h1>Simple solutions to not-so-simple problems.</h1>
    <p>We fix the problems costing you time and money — built into the systems you already run, live in weeks. AI where it helps. Regular software where it doesn’t.</p>
    <div class="ctas">
      <Btn href="#">{CTA_PRIMARY} →</Btn>
    </div>
    <p>{RISK_REVERSAL} The roadmap is yours either way.</p>
  </section>

  <section>
    <p class="label">2 · Logo / social-proof strip</p>
    <p>Trusted by operators who were tired of pilots. <span class="ph">[placeholder] client count / one-line proof</span></p>
    <div class="logos">
      {[1, 2, 3, 4, 5, 6].map(() => <div class="logo">[placeholder] client logo</div>)}
    </div>
  </section>

  <section>
    <p class="label">3 · Problem</p>
    <h2>Everyone has an AI initiative. Almost nobody has one in production.</h2>
    <p>The deck got approved. The pilot launched. Eighteen months later, smart people are still doing the slow thing by hand because nobody built them a better way. The technology was never the issue — the overwhelm was.</p>
    <div class="cards">
      {problemStats.map((s) => (
        <div class="card stat">
          <b>{s.n}</b>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
    <p>Your business doesn’t need more AI. It needs fewer problems.</p>
  </section>

  <section>
    <p class="label">4 · Describe the problem</p>
    <h2>You already know which one it is.</h2>
    <p>It’s the process everyone complains about, nobody owns, and people have quietly learned to work around. It usually looks like one of these:</p>
    <ul>
      {symptoms.map((x) => <li>{x}</li>)}
    </ul>
    <p>“Why do we still do it this way?” “It’s how we’ve always done it.” That’s not a reason.</p>
  </section>

  <section>
    <p class="label">5 · Twist the knife</p>
    <h2>Leaving it alone isn’t free.</h2>
    <p>The workaround feels cheap because nobody sends an invoice for it. Here’s what it’s actually costing.</p>
    <div class="cards">
      {knife.map((k) => (
        <div class="card">
          <h3>{k.t}</h3>
          <p>{k.b}</p>
        </div>
      ))}
    </div>
    <p>You’ve been talking about fixing this for two years. That’s the real number.</p>
  </section>

  <section>
    <p class="label">6 · Solution &amp; benefits</p>
    <h2>0 → 1 → n.</h2>
    <p>Prove it, ship it, multiply it. Discovery finds the three workflows where the money moves fastest. Production puts the first one live inside your systems. Multiply ships the next ones on the foundation already built — each faster and cheaper than the last.</p>
    <ul>
      {benefits.map((b) => (
        <li><b>{b.t}.</b> {b.b}</li>
      ))}
    </ul>
  </section>

  <section>
    <p class="label">7 · Social proof</p>
    <h2>What it looks like when the number moves.</h2>
    <div class="cards">
      {testimonials.map((t) => (
        <div class="card">
          <p>{t.q}</p>
          <p class="who">{t.who}</p>
        </div>
      ))}
    </div>
    <p class="ph">All three are placeholders — shape only (role, company type, outcome number). Replace with real customer quotes before this ships.</p>
  </section>

  <section>
    <p class="label">8 · How it works</p>
    <h2>You never have to become an AI company.</h2>
    <p>Most teams don’t need to understand AI. They need it to work. The whole experience:</p>
    <div class="cards">
      {steps.map((s) => (
        <div class="card">
          <p>{s.i}</p>
          <h3>{s.t}</h3>
          <p>{s.b}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <p class="label">9 · Competitor comparison</p>
    <h2>Your other options, honestly.</h2>
    <p>None of these are wrong. They’re just slower, pricier, or riskier than they need to be for a problem this size.</p>
    <table>
      <thead>
        <tr>
          <th></th>
          {comparison.cols.map((c) => <th>{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {comparison.rows.map((r) => (
          <tr>
            <th>{r.k}</th>
            {r.v.map((cell) => <td>{cell}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="ph">Numbers marked [placeholder] need a source or a real engagement behind them before publishing.</p>
  </section>

  <section>
    <p class="label">10 · Features</p>
    <h2>Six things we build. Bring us the messy one.</h2>
    <ul>
      {features.map((f) => (
        <li><b>{f.t}.</b> {f.b}</li>
      ))}
    </ul>
  </section>

  <section>
    <p class="label">11 · Why Sondri exists</p>
    <div class="card">
      <p>"We started Sondri because we kept watching the same movie: a capable team, a real problem, and eighteen months of AI pilots that never shipped. The technology was never the issue — the overwhelm was. So we built the company we wished existed: it shows up, solves the problem simply, and proves it on a number you already track."</p>
      <p>We use AI, but we’re not emotionally attached to it. We’re attached to fixing the problem.</p>
      <a href="/get-in-touch/">Get in Touch →</a>
    </div>
  </section>

  <section>
    <p class="label">12 · FAQ</p>
    <h2>Asked on almost every intro call.</h2>
    {[...faq, ...extraFaq].map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section>
    <p class="label">13 · Final CTA</p>
    <h2>The first conversation is free. The roadmap is yours either way.</h2>
    <p>Thirty minutes with a founder. You describe the operation; we tell you honestly whether there’s a case.</p>
    <div class="ctas">
      <Btn href="#">{CTA_PRIMARY} →</Btn>
    </div>
    <p>{RISK_REVERSAL}</p>
  </section>
</Base>

<style>
  .label { color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
  .ph { color: #888; font-size: 14px; }
  .who { color: #666; font-size: 14px; }
  .logos { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 8px; }
  .logo { background: #ddd; color: #666; font-size: 11px; text-align: center; height: 48px; display: flex; align-items: center; justify-content: center; padding: 4px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 0 0 12px; }
  th, td { border: 1px solid #eee; padding: 8px; text-align: left; vertical-align: top; }
  thead th { background: #f5f5f5; }
  tbody th { font-weight: normal; color: #666; }
</style>
