---
/**
 * PROPOSAL — alternate home page (first-draft copy).
 * Blends the 10 sections from docs/comparison-sections.html with the site's
 * existing home sections (founder note kept as its own section) plus two
 * added after Problem: "Twist the knife".
 * Numbered labels are intentional on this page. `[placeholder]` marks
 * proof/claims we don't have yet.
 */
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { CTA_PRIMARY, RISK_REVERSAL, problemStats, faq } from '../data/copy';

const knife = [
  { t: 'Money', b: 'Count the time each person on your team spends on the workaround. [placeholder: cost-of-inaction calculator]' },
  { t: 'Time', b: 'As volume grows, your team spends more time on manual work. The longer you wait, the more processes depend on the workaround.' },
  { t: 'People', b: 'Your experienced staff spend hours on data entry. If someone leaves, you may have to work out their steps again.' },
];

const benefits = [
  { t: 'Cost and savings', b: 'We agree on a cost to cut or a way to increase revenue, then measure the change.' },
  { t: 'Your systems, your code', b: 'Built into the software and spreadsheets you already use, with code your team owns.' },
  { t: 'One phase at a time', b: 'Agree on a fixed price for each phase, then review the work before funding the next.' },
];

const testimonials = [
  { q: '[placeholder] "We had talked about fixing invoice matching for two years. It was live in six weeks and we use it every day."', who: '[placeholder] COO, regional logistics company · [placeholder] 14 hrs/week back to the finance team' },
  { q: '[placeholder] "They told us on the first call which of our three ideas was worth doing. That honesty is why we hired them."', who: '[placeholder] CFO, mid-market manufacturer · [placeholder] first software in use in 7 weeks' },
  { q: '[placeholder] "Our team owns the code and can read every line."', who: '[placeholder] Head of Ops, healthcare services group · [placeholder] $180k annual cost removed' },
];

const steps = [
  { i: '01', t: 'Tell us what’s slow', b: 'Spend thirty minutes describing the process that slows you down. You can come without preparing anything.' },
  { i: '02', t: 'We build it into your systems', b: 'You keep running your business while we build with your existing software and data.' },
  { i: '03', t: 'Check the time and cost saved', b: 'Compare the time and cost of the workflow before and after the build.' },
];

const comparison = {
  cols: ['Sondri', 'Software agency', 'Hiring in-house', 'DIY tools'],
  rows: [
    { k: 'Time until you can use it', v: ['Weeks [placeholder: 6–8]', 'Quarters [placeholder: 6–9 mo.]', 'Months to hire, then months to build', 'Days to try; integration takes longer'] },
    { k: 'What you pay', v: ['Fixed price per phase, quoted before it starts', 'You pay for hours and expenses', 'Salary + benefits + management, whether or not there’s a project', 'Low fees; your team does the work'] },
    { k: 'Who owns the code', v: ['You; runs in your systems', 'Often the vendor’s platform or license', 'You', 'Check ownership terms with your tool provider'] },
    { k: 'Commitment up front', v: ['One phase; your planning session is free', 'Multi-phase contract before launch', 'A full-time employee', 'No contract; your team maintains it'] },
    { k: 'After launch', v: ['We maintain it and build the next workflow', 'You pay for changes or take over the upkeep', 'Depends on whether that person stays', 'Your team updates it when the workflow changes'] },
  ],
};

const features = [
  { t: 'Workflow Automation', b: 'Automate the steps taking up your day, with your staff checking work that needs approval.' },
  { t: 'Data & Reporting', b: 'See current figures from your software without typing them in again.' },
  { t: 'Customer Operations', b: 'Help your staff answer customers and send quotes faster.' },
  { t: 'Back Office', b: 'Cut mistakes in your invoices, payment matching, and monthly accounts.' },
  { t: 'Integrations', b: 'Connect your systems and spreadsheets so staff can stop copying data between them.' },
  { t: 'AI for multi-step jobs', b: 'Use AI for jobs with several steps, with records you can check and a way for your staff to stop it.' },
];

const extraFaq = [
  {
    q: 'Why not just hire an agency, or someone in-house?',
    a: 'An agency may suit a larger project; a hire can make sense for ongoing work. Compare their costs and lead times with our fixed price for one phase. You own what we build, and we support it after launch. We’ll recommend hiring if that fits your needs better.',
  },
  {
    q: 'Do you use AI for everything?',
    a: 'We use AI if it helps with your job.',
  },
];
---

<Base title="Sondri — Home (alt: 10-section proposal)">
  <section>
    <p class="label">1 · Hero</p>
    <h1>Simple solutions to not-so-simple problems.</h1>
    <p>We build software into your existing systems in weeks, using AI when it helps.</p>
    <div class="ctas">
      <Btn href="#">{CTA_PRIMARY} →</Btn>
    </div>
    <p>{RISK_REVERSAL} The roadmap is yours either way.</p>
  </section>

  <section>
    <p class="label">2 · Logo / social-proof strip</p>
    <p>Customer references: <span class="ph">[placeholder] client count / one-line proof</span></p>
    <div class="logos">
      {[1, 2, 3, 4, 5, 6].map(() => <div class="logo">[placeholder] client logo</div>)}
    </div>
  </section>

  <section>
    <p class="label">3 · Problem</p>
    <h2>Still doing the work by hand after trying AI?</h2>
    <p>You’ve spent months trying AI, but your team still does the work by hand.</p>
    <div class="cards">
      {problemStats.map((s) => (
        <div class="card stat">
          <b>{s.n}</b>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
    <p>Start with the process costing your team the most time.</p>
  </section>


  <section>
    <p class="label">4 · Twist the knife</p>
    <h2>Leaving it alone isn’t free.</h2>
    <p>The workaround feels cheap because nobody sends you an invoice for it.</p>
    <div class="cards">
      {knife.map((k) => (
        <div class="card">
          <h3>{k.t}</h3>
          <p>{k.b}</p>
        </div>
      ))}
    </div>
    <p>How many hours have you spent on it since you first discussed a fix?</p>
  </section>

  <section>
    <p class="label">5 · Solution &amp; benefits</p>
    <h2>Fix one job at a time.</h2>
    <p>You choose three jobs worth fixing with us. We build for the first and reuse what we can for the next.</p>
    <ul>
      {benefits.map((b) => (
        <li><b>{b.t}.</b> {b.b}</li>
      ))}
    </ul>
  </section>

  <section>
    <p class="label">6 · Social proof</p>
    <h2>What customers say about working with us.</h2>
    <div class="cards">
      {testimonials.map((t) => (
        <div class="card">
          <p>{t.q}</p>
          <p class="who">{t.who}</p>
        </div>
      ))}
    </div>
    <p class="ph">All three are placeholders — shape only (role, company type, measured change). Replace with real customer quotes before this ships.</p>
  </section>

  <section>
    <p class="label">7 · How it works</p>
    <h2>Keep running your business while we build.</h2>
    <p>You show us the work you want to fix, and we build with your team.</p>
    <div class="cards">
      {steps.map((s) => (
        <div class="card">
          <p>{s.i}</p>
          <h3>{s.t}</h3>
          <p>{s.b}</p>
        </div>
      ))}
    </div>
  </section>

  <section>
    <p class="label">8 · Competitor comparison</p>
    <h2>Compare ways to get the work done.</h2>
    <p>Compare the cost of outside help with the time your own team can commit.</p>
    <table>
      <thead>
        <tr>
          <th></th>
          {comparison.cols.map((c) => <th>{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {comparison.rows.map((r) => (
          <tr>
            <th>{r.k}</th>
            {r.v.map((cell) => <td>{cell}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="ph">Numbers marked [placeholder] need a source or a real engagement behind them before publishing.</p>
  </section>

  <section>
    <p class="label">9 · Features</p>
    <h2>What can we help you fix?</h2>
    <ul>
      {features.map((f) => (
        <li><b>{f.t}.</b> {f.b}</li>
      ))}
    </ul>
  </section>

  <section>
    <p class="label">10 · Why Sondri exists</p>
    <div class="card">
      <p>We started Sondri because we saw businesses spend eighteen months trying AI without getting software they could use. You can bring us one job that needs fixing, and we’ll build software for it.</p>
      <p>We use AI when it helps with the job.</p>
      <a href="/get-in-touch/">Get in Touch →</a>
    </div>
  </section>

  <section>
    <p class="label">11 · FAQ</p>
    <h2>Questions you may have.</h2>
    {[...faq, ...extraFaq].map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <section>
    <p class="label">12 · Final CTA</p>
    <h2>Your first call is free, and you keep the plan we put together.</h2>
    <p>Spend thirty minutes with a founder describing the process you want to fix. We’ll tell you whether we can help.</p>
    <div class="ctas">
      <Btn href="#">{CTA_PRIMARY} →</Btn>
    </div>
    <p>{RISK_REVERSAL}</p>
  </section>
</Base>

<style>
  .label { color: #888; font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
  .ph { color: #888; font-size: 14px; }
  .who { color: #666; font-size: 14px; }
  .logos { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 8px; }
  .logo { background: #ddd; color: #666; font-size: 11px; text-align: center; height: 48px; display: flex; align-items: center; justify-content: center; padding: 4px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 0 0 12px; }
  th, td { border: 1px solid #eee; padding: 8px; text-align: left; vertical-align: top; }
  thead th { background: #f5f5f5; }
  tbody th { font-weight: normal; color: #666; }
</style>
