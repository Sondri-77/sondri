---
/** Big Florexa heading with 3 variants, cycled in place by the ‹ › control (see home-edgy). */
interface Props { tag?: 'h1' | 'h2'; v: [string, string, string] }
const { tag: Tag = 'h2', v } = Astro.props;
---

<div class="hv">
  <Tag>{v.map((t) => <span class="v">{t}</span>)}</Tag>
  <span class="ctl"><button class="prev" type="button" aria-label="Previous heading">‹</button><span class="n">1/3</span><button class="next" type="button" aria-label="Next heading">›</button></span>
</div>

<style>
  .hv { margin: 0 0 12px; }
  .hv h1, .hv h2 { font-family: 'Florexa', sans-serif; font-weight: normal; margin: 0 0 4px; }
  .hv h1 { font-size: 44px; line-height: 1.05; }
  .hv h2 { font-size: 32px; line-height: 1.1; }
  .ctl { display: inline-flex; align-items: center; gap: 6px; color: #888; font-size: 12px; }
  .ctl button { background: none; border: 1px solid #ccc; color: #000; font: inherit; font-size: 14px; line-height: 1; width: 22px; height: 22px; cursor: pointer; padding: 0; }
  .ctl button:hover { border-color: #000; }
</style>
