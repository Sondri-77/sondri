---
import Page from '../components/Page.astro';
import Sec from '../components/Sec.astro';
import Img from '../components/Img.astro';
import Btn from '../components/Btn.astro';
---

<Page
  name="Payment confirmed"
  route="/success/"
  note="not in nav; Stripe return page, excluded from sitemap"
  title="Payment confirmed — Sondri"
  description="Thank you for your payment to Sondri."
/>

<Sec page="Success" name="Confirmation card">
  <div class="card">
    <p><Img w={18} h={18} what="✓" /> Payment confirmed</p>
    <h1>Thank you for your payment.</h1>
    <p>Your payment has been successfully processed by Stripe. A confirmation email with your tax invoice and receipt has been dispatched to your email address.</p>
    <Btn kind="gold, full width — shown only when a receipt link loads">View Official Receipt &amp; Invoice →</Btn>
    <p>← Return to the Sondri homepage</p>
  </div>
</Sec>
