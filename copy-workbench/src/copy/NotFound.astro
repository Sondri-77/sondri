---
import Page from '../components/Page.astro';
import Sec from '../components/Sec.astro';
import Img from '../components/Img.astro';
import Btn from '../components/Btn.astro';
---

<Page
  name="404"
  route="/404/"
  note="not in nav"
  title="404 — Sondri"
  description="Signal lost. The page you requested does not exist."
/>

<Sec page="404" name="Lost">
  <Img w="100%" h={90} what="glyph-field canvas (calm variant)" />
  <h1>404.</h1>
  <p class="lede">The page you requested does not exist, or has been moved.</p>
  <Btn kind="gold">← Return Home</Btn>
</Sec>
