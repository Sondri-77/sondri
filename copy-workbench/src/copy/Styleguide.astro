---
import Page from '../components/Page.astro';
import Sec from '../components/Sec.astro';
import Img from '../components/Img.astro';
import Btn from '../components/Btn.astro';
import { displayFonts, fontGroups, shortlist } from '../../../sondri-site/src/display-fonts';

// Transcribed from sondri-site/src/pages/styleguide.astro frontmatter.
const lockupFonts = ['Florexa', 'Matrixel'];
const lockupVariants = ['White + gold', 'White', 'Green + gold', 'Black'];
const swatches = [
  ['Ink', '--ink', '#081f1f', 'Hero + CTA field'],
  ['Deep', '--deep', '#031919', 'Deepest green'],
  ['Pine', '--pine', '#0c2b29', 'Raised surface'],
  ['Moss', '--moss', '#133a36', 'Raised surface, high'],
  ['Slate', '--slate', '#174040', 'Dividers, wells'],
  ['Gold', '--gold', '#fdb343', 'The signal'],
  ['Gold 2', '--gold-2', '#f5a71e', 'Buttons, the dot'],
  ['Bone', '--bone', '#e6f2f0', 'Light ground'],
  ['Text hi', '--text-hi', '#edf5f4', 'Headings'],
  ['Pale', '--pale', '#aac2c2', 'Body copy'],
  ['Steel', '--steel', '#6a8988', 'Muted, AA on ink'],
];
const scale = [
  ['.display', 'clamp(42 → 76px) / 1.04'],
  ['.h2', 'clamp(30 → 46px) / 1.12'],
  ['h3', '21px / 700 / 1.3'],
  ['.lede', '19px / 1.6'],
  ['body', '16px / 1.65'],
  ['.body-s', '15.5px'],
  ['.kicker', '12.5px / 600 / 0.14em caps'],
];
const tokens = [
  ['--wrap', '1160px'],
  ['--pad-x', '40 / 24 / 18px'],
  ['--r-card', '14px'],
  ['--r-pill', '999px'],
  ['--ease', 'cubic-bezier(.16, 1, .3, 1)'],
  ['--dur-micro', '0.2s'],
  ['--dur-reveal', '0.55s'],
  ['--font-display', 'var(--serif)'],
];
---

<Page
  name="Styleguide"
  route="/styleguide/"
  note="internal design-system page, unlinked from nav and footer (reachable via the font switcher)"
  title="Styleguide — Sondri"
  description="The Sondri design system: type, colour, components, motion, and live display-font trials."
/>

<Sec page="Styleguide" name="Font switcher bar" note="sticky control bar">
  <p class="label">Display font</p>
  <ul class="inline">
    <li>Florexa (current)</li>
    <li>Fraunces</li>
    <li class="note">Shortlist:</li>
    {shortlist.map((f) => <li>{f.name}</li>)}
    {fontGroups.map((g) => (
      <>
        <li class="note">{g.label}:</li>
        {displayFonts.filter((f) => f.group === g.id).map((f) => <li>{f.name}</li>)}
      </>
    ))}
  </ul>
  <p class="label">Tracking 0</p>
  <p class="label">Case</p>
  <ul class="inline"><li>As written</li><li>UPPERCASE</li><li>lowercase</li></ul>
  <Btn>Reset</Btn>
</Sec>

<Sec page="Styleguide" name="Header">
  <p class="label">Design system .</p>
  <h1>Styleguide.</h1>
  <p class="lede">Every token, type style, and component the site is built from. Use the bar above to try a display face live — it drives the wordmark and every heading on this page.</p>
</Sec>

<Sec page="Styleguide" name="Wordmark">
  <h2>Wordmark</h2>
  <p>Shipping nav uses /brand/lockup-wordmark.png. These are type trials for a future set wordmark — swap a face above to judge it at lockup scale.</p>
  <div class="cards">
    <div class="card"><p class="stat">Sondri.</p><p>On ink</p></div>
    <div class="card"><p class="stat">Sondri.</p><p>On bone</p></div>
    <div class="card"><p>Sondri.</p><p>Nav scale — 42px</p></div>
  </div>
</Sec>

<Sec page="Styleguide" name="Shortlist — drawn lockups">
  <h2>Shortlist — drawn lockups</h2>
  <p>Exported artwork for the two faces in front. SVG is what ships; PNG at 1× and 3× sits alongside for decks and email. Bitram is still on the shortlist but has no lockup drawn yet.</p>
  {lockupFonts.map((font) => (
    <div>
      <h3>{font} <Btn>Load in switcher</Btn></h3>
      <div class="cards">
        {lockupVariants.map((v) => (
          <div class="card">
            <Img w="100%" h={110} what={`Sondri wordmark in ${font}, ${v.toLowerCase()}`} />
            <p>{v} <span class="note">SVG · 1× · 3×</span></p>
          </div>
        ))}
      </div>
    </div>
  ))}
</Sec>

<Sec page="Styleguide" name="Every face at once">
  <h2>Every face at once</h2>
  <p>Showing the {shortlist.length}-face shortlist by default. Switch to All to see the full {displayFonts.length} again, or Starred for your own picks. Click any name to load that face into the switcher above.</p>
  <p class="label">Size 34px · Case: As written / UPPERCASE / lowercase · Show: Shortlist / Starred / All · 0 starred</p>
  <Btn>Clear stars</Btn>
  <div class="cards">
    {displayFonts.map((f) => (
      <div class="card">
        <p>Sondri.</p>
        <p>{f.name} <span class="note">{f.group === 'pixel' ? 'Pixel' : 'Display'}</span></p>
        <p class="note">aria-label: Star {f.name}</p>
      </div>
    ))}
  </div>
  <p class="small">Nothing starred yet. <span class="note">(hidden until Starred filter is empty)</span></p>
</Sec>

<Sec page="Styleguide" name="Type scale">
  <h2>Type scale</h2>
  <p>Headings run on --font-display; body copy stays on Hanken Grotesk and never swaps. Pixel faces are display-only — they are not legible at body sizes.</p>
  {scale.map(([cls, spec]) => (
    <p><span class="note">{cls} · {spec}</span><br />Software that fits how you already work.</p>
  ))}
</Sec>

<Sec page="Styleguide" name="Specimen">
  <h2>Specimen</h2>
  <p>The chosen face, exercised. Watch for missing glyphs, tight numerals, and punctuation that breaks at large sizes.</p>
  <p>ABCDEFGHIJKLM<br />NOPQRSTUVWXYZ<br />abcdefghijklmnopqrstuvwxyz<br />0123456789 &amp; @ # % $ € £<br />. , ; : ! ? ' " ( ) [ ] / — –</p>
</Sec>

<Sec page="Styleguide" name="Colour">
  <h2>Colour</h2>
  <p>Deep green is the field, bone the text, gold the single signal. Gold is never decoration — it marks one thing per view.</p>
  <div class="cards">
    {swatches.map(([name, token, hex, note]) => (
      <div class="card">
        <Img w={48} h={48} what="" />
        <p><strong>{name}</strong><br /><span class="note">{token} · {hex}</span><br />{note}</p>
      </div>
    ))}
  </div>
</Sec>

<Sec page="Styleguide" name="Buttons">
  <h2>Buttons</h2>
  <Btn kind="gold">Book discovery →</Btn>
  <Btn kind="ink">Secondary →</Btn>
  <Btn kind="ghost">Ghost →</Btn>
  <p>.btn-gold carries a sheen on hover and is the only primary action in a view.</p>
</Sec>

<Sec page="Styleguide" name="Surfaces &amp; chips">
  <h2>Surfaces &amp; chips</h2>
  <div class="cards">
    <div class="card"><h3>Card</h3><p>.card — glass fill over the green field, hairline border, 14px radius.</p></div>
    <div class="card"><h3>Chips</h3><ul class="inline"><li>Operations</li><li>Finance</li><li>Field service</li></ul></div>
  </div>
</Sec>

<Sec page="Styleguide" name="Tokens">
  <h2>Tokens</h2>
  <ul>{tokens.map(([k, v]) => <li><span class="note">{k}</span> {v}</li>)}</ul>
</Sec>

<Sec page="Styleguide" name="Adopting a face">
  <h2>Adopting a face</h2>
  <p>Nothing here changes the live site. To ship the face you picked, set one token in src/styles/theme.css:</p>
  <p class="field">--font-display: var(--serif);</p>
</Sec>
