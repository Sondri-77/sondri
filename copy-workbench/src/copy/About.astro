---
import Page from '../components/Page.astro';
import Sec from '../components/Sec.astro';
import Img from '../components/Img.astro';
import Btn from '../components/Btn.astro';
---

<Page
  name="About"
  route="/about/"
  title="About — Sondri"
  description="Built by operators who've shipped AI into the real world. A small senior core team with a global specialist network, building the AI working model for the enterprises that move real money."
/>

<Sec page="About" name="Hero">
  <Img w="100%" h={90} what="glyph-field canvas (calm variant)" />
  <h1>Built by operators who've shipped AI into the real world.</h1>
  <p class="lede">A small senior core team with a global specialist network. We put working AI inside the enterprises that move real money — and we're hiring the first ten people who will shape how.</p>
  <Btn kind="gold">Book a Discovery Sprint →</Btn>
</Sec>

<Sec page="About" name="Our mission">
  <h2>Our mission.</h2>
  <p>Great software shouldn't require an enterprise budget. Our mission is to give small and midsize businesses the technology muscle the giants take for granted — built into the systems they already run, proven on the numbers they already track.</p>
  <p>We're hiring the first ten people who will shape how. Careers →</p>
</Sec>
