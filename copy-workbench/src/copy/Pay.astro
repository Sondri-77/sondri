---
import Page from '../components/Page.astro';
import Sec from '../components/Sec.astro';
import Img from '../components/Img.astro';
import Btn from '../components/Btn.astro';
---

<Page
  name="Pay an Invoice"
  route="/pay/"
  note="not in nav; linked from footer and Get in Touch"
  title="Payments & deposits — Sondri"
  description="Submit an agreed invoice deposit or custom payment for Sondri AI automation services."
/>

<Sec page="Pay" name="Hero">
  <Img w="100%" h={90} what="glyph-field canvas (calm variant)" />
  <h1>Secure client payment portal.</h1>
  <p class="lede">Submit an agreed project deposit, retainer payment, or invoice. All transactions run through encrypted Stripe Checkout with instant receipt generation.</p>
</Sec>

<Sec page="Pay" name="Custom deposit card">
  <div class="card">
    <h2>Pay an invoice or deposit</h2>
    <p>Enter your billing email, the custom amount agreed with the Sondri engineering team, and your project reference.</p>
    <p class="label">Billing email address *</p>
    <p class="field">billing@company.com <span class="note">(placeholder)</span></p>
    <p class="label">Payment amount ($ USD) *</p>
    <p class="field">2500.00 <span class="note">(placeholder)</span></p>
    <p class="label">Invoice reference / project description *</p>
    <p class="field">Deposit for AI Workflow Sprint <span class="note">(placeholder)</span></p>
    <Btn kind="gold, full width">Proceed to Secure Checkout →</Btn>
    <p class="small">While submitting the button reads: Generating checkout...</p>
  </div>
  <p class="small">256-bit encrypted · Automatic PDF tax receipts · Powered by Stripe</p>
</Sec>

<Sec page="Pay" name="Error alerts" note="browser alert(), only on failure">
  <p>Checkout Error: … / Unable to generate checkout session</p>
  <p>Connection Error: … / Unable to reach payment gateway</p>
</Sec>
