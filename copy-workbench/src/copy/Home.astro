---
import Page from '../components/Page.astro';
import Sec from '../components/Sec.astro';
import Img from '../components/Img.astro';
import Btn from '../components/Btn.astro';
import { CTA_PRIMARY, RISK_REVERSAL, problemStats, framework, capabilities, feelSteps } from '../../../sondri-site/src/data';
---

<Page
  name="Home"
  route="/"
  title="Sondri — Simple solutions to not-so-simple problems"
  description="The technology you need built — live within your business, fast. Software and automation for small and midsize companies, delivered simply."
/>

<Sec page="Home" name="Hero">
  <Img w="100%" h={120} what="animated glyph-field canvas behind the hero (full variant)" />
  <h1>Simple solutions to not-so-simple problems.</h1>
  <p class="lede">The technology you need built — live within your business, fast.</p>
  <Btn kind="gold">{CTA_PRIMARY} →</Btn>
  <Btn kind="ghost">See How It Works</Btn>
  <p class="small">{RISK_REVERSAL}</p>
</Sec>

<Sec page="Home" name="Capability strip" note="aria-label “What we do”">
  <ul class="inline">{capabilities.map((c) => <li>{c}</li>)}</ul>
</Sec>

<Sec page="Home" name="The problem">
  <h2>Everyone has an AI initiative. Almost nobody has one in production.</h2>
  <p class="lede">Pilots launch, decks get approved, and the value never reaches production.</p>
  <div class="cards">
    {problemStats.map((s) => (
      <div class="card">
        <p class="stat">{s.n}</p>
        <p>{s.label}</p>
      </div>
    ))}
  </div>
</Sec>

<Sec page="Home" name="The framework 0 → 1 → n">
  <h2>0 → 1 → n.</h2>
  <p class="lede">Prove it, ship it, multiply it — and you commit one rung at a time, at the pace your business sets.</p>
  <div class="cards">
    {framework.map((p) => (
      <div class="card">
        <p class="stat">{p.num}</p>
        <h3>{p.name}</h3>
        <p>{p.does}</p>
        <p class="label">You walk away with</p>
        <p>{p.gets}</p>
      </div>
    ))}
  </div>
  <p>Long-term customers can add a standing advisory seat — a permanent partner for every technology decision ahead.</p>
</Sec>

<Sec page="Home" name="What it feels like">
  <h2>You never have to become an AI company.</h2>
  <p class="lede">Most teams don't need to understand AI. They need it to work. Here's the whole experience:</p>
  <div class="cards">
    {feelSteps.map((s) => (
      <div class="card">
        <p class="stat">{s.i}</p>
        <h3>{s.t}</h3>
        <p>{s.b}</p>
      </div>
    ))}
  </div>
</Sec>

<Sec page="Home" name="Founder note">
  <div class="card">
    <p>"We started Sondri because we kept watching the same movie: a capable team, a real problem, and eighteen months of AI pilots that never shipped. The technology was never the issue — the overwhelm was. So we built the company we wished existed: it shows up, solves the problem simply, and proves it on a number you already track."</p>
    <p>Get in Touch →</p>
  </div>
</Sec>

<Sec page="Home" name="CTA band">
  <h2>The first conversation is free. The roadmap is yours either way.</h2>
  <Btn kind="gold">{CTA_PRIMARY} →</Btn>
</Sec>
