---
import { socialProof } from '../home-data';
---

<!-- Their testimonials field, but all three at once: white cards on the tint,
     each with a dithered mark (dither-block.ts, disc) where a photo would go. -->
<section class="sp px" id="results">
  <div class="index label">
    <span>Social proof</span>
    <span aria-hidden="true">[SND.4]</span>
  </div>

  <div class="my-grid body">
    <h2 class="t-md head" data-reveal>{socialProof.h2}</h2>
  </div>

  <div class="my-grid cards">
    {socialProof.items.map((t, i) => (
      <blockquote class="card" data-reveal style={`transition-delay:${i * 70}ms`}>
        <canvas class="mark" data-dither-block data-shape="disc" data-seed={20 + i} aria-hidden="true"></canvas>
        <p class="fs-24 q">{t.q}</p>
        <footer><p class="label who">{t.who}</p></footer>
      </blockquote>
    ))}
  </div>

  <p class="label ph">{socialProof.ph}</p>
</section>

<style>
  .sp { background: var(--off); padding-top: var(--s-50); padding-bottom: var(--s-80); }
  @media (min-width: 1024px) { .sp { padding-bottom: var(--s-100); } }
  .index { display: flex; justify-content: space-between; }

  .body { margin-top: var(--s-66); }
  .head { grid-column: 1 / -1; }
  @media (min-width: 1024px) { .head { grid-column: 1 / 10; } }

  .cards { margin-top: var(--s-60); row-gap: var(--gutter); }
  .card { grid-column: 1 / -1; background: var(--white); padding: var(--s-20) var(--s-20) var(--s-30); display: flex; flex-direction: column; gap: var(--s-30); }
  @media (min-width: 1024px) {
    .card:nth-child(1) { grid-column: 1 / 5; }
    .card:nth-child(2) { grid-column: 5 / 9; }
    .card:nth-child(3) { grid-column: 9 / -1; }
  }
  .mark { width: 64px; height: 64px; image-rendering: pixelated; display: block; background: var(--teal); }
  .q { flex: 1; }
  .who { color: var(--muted); line-height: 1.5; }

  .ph { margin-top: var(--s-40); color: var(--muted); line-height: 1.5; }
</style>
