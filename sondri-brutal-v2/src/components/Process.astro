---
import { timeline } from '../data';
---

<!-- Their `home_process`: mono index row, a pair of vertical rules running the
     full height behind columns 5–8, a sticky title on the left, and a stack of
     white cards on the right, each ruled top and bottom. -->
<section class="proc px" id="process">
  <div class="vrules my-grid" aria-hidden="true"><div class="pair"></div></div>

  <div class="index label">
    <span>Process</span>
    <span aria-hidden="true">[SND.2]</span>
  </div>

  <div class="my-grid body">
    <div class="left my-grid">
      <div class="title-col">
        <div class="sticky">
          <h2 class="my-title">Here<br />at every<br />step</h2>
        </div>
      </div>
      <div class="note">
        <div class="sticky">
          <p class="my-text">
            Getting automation into production can look like an insurmountable task for operators,
            finance teams, and the people who own the systems.
          </p>
        </div>
      </div>
    </div>

    <div class="cards">
      {timeline.map((t, i) => (
        <article class="card" data-reveal style={`transition-delay:${i * 60}ms`}>
          <div class="card-head">
            <h3 class="t-sm">{t.title}</h3>
            <span class="t-sm num">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <hr />
          <p class="my-text">{t.body}</p>
          <hr class="last" />
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .proc { position: relative; overflow: hidden; z-index: 1; padding-top: 18px; padding-bottom: var(--s-60); }
  @media (min-width: 1024px) { .proc { padding-bottom: var(--s-160); } }

  .vrules { z-index: -1; }
  .pair { display: none; }
  @media (min-width: 1024px) {
    .pair { display: block; grid-column: 5 / 9; grid-row: 1 / -1; border-left: 1px solid var(--line); border-right: 1px solid var(--line); }
  }

  .index { display: flex; justify-content: space-between; }

  .body { margin-top: var(--s-50); }
  @media (min-width: 1024px) { .body { margin-top: 90px; } }

  .left { grid-column: 1 / -1; align-content: start; }
  @media (min-width: 1024px) { .left { grid-column: 1 / 7; grid-template-columns: repeat(6, minmax(0, 1fr)); } }

  .title-col { grid-column: 1 / -1; }
  .note { grid-column: 2 / -1; margin-top: var(--s-80); }
  @media (min-width: 1024px) { .note { grid-column: 2 / 5; padding-right: 55px; margin-top: var(--s-46); } }

  .sticky { position: sticky; top: 110px; }

  .cards { grid-column: 1 / -1; margin-top: var(--s-66); display: flex; flex-direction: column; gap: 1.25em; }
  @media (min-width: 1024px) { .cards { grid-column: 7 / -1; margin-top: 0; gap: 2em; } }

  .card { background: var(--white); color: var(--teal); padding: 10px 16px 20px; }
  @media (min-width: 1024px) { .card { width: 66.6%; padding: 10px 22px 22px; } }

  .card-head { display: flex; align-items: center; justify-content: space-between; }
  .num { padding-right: 8px; }
  hr { border: 0; border-top: 1px solid var(--line); margin-top: 10px; }
  .card p { margin-top: var(--s-26); padding-right: 20%; }
  hr.last { margin-top: var(--s-46); }
</style>
